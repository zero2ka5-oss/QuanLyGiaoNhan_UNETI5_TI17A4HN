@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Khối thương hiệu bên trái trang Đăng nhập / Đăng ký: hình minh họa xe giao hàng, thẻ nổi,
                       lợi ích (đăng nhập) hoặc 3 bước bắt đầu (đăng ký). ViewData["CheDo"] = "DangKy" để hiện các bước. *@
@{ bool dangKy = ViewData["CheDo"] as string == "DangKy"; }
<aside class="xt-trai">
    <span class="xt-vong xt-vong-1"></span><span class="xt-vong xt-vong-2"></span>
    <a class="logo text-white position-relative" asp-controller="TrangChu" asp-action="Index"><span class="bieu-tuong"><i class="bi bi-truck"></i></span>GiaoNhanh</a>

    <div class="xt-minh-hoa">
        <svg viewBox="0 0 420 250" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
                <linearGradient id="xtThung" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#FFE4D3" /></linearGradient>
                <linearGradient id="xtDau" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FF8A4C" /><stop offset="1" stop-color="#E4531B" /></linearGradient>
            </defs>
            <ellipse cx="210" cy="222" rx="190" ry="10" fill="#000" opacity=".18" />
            <g stroke="#fff" stroke-linecap="round" opacity=".35" stroke-width="6"><line x1="18" y1="112" x2="70" y2="112" /><line x1="4" y1="140" x2="62" y2="140" /><line x1="26" y1="168" x2="70" y2="168" /></g>
            <g class="xt-xe">
                <rect x="80" y="70" width="190" height="130" rx="16" fill="url(#xtThung)" />
                <rect x="98" y="88" width="92" height="28" rx="8" fill="#F26522" />
                <text x="144" y="107" text-anchor="middle" font-family="Be Vietnam Pro, Arial" font-size="14" font-weight="800" fill="#fff">GiaoNhanh</text>
                <g transform="translate(200 128)"><rect width="54" height="44" rx="6" fill="#E9A968" /><rect x="23" width="8" height="44" fill="#C9864A" /></g>
                <path d="M270 100 h52 q10 0 16 8 l32 44 q6 8 6 18 v14 q0 16 -16 16 h-90 z" fill="url(#xtDau)" />
                <path d="M282 112 h38 q6 0 9 5 l22 32 h-69 z" fill="#CFE3FA" />
                <circle cx="130" cy="204" r="24" fill="#0F2439" /><circle cx="130" cy="204" r="10" fill="#CBD5E1" />
                <circle cx="320" cy="204" r="24" fill="#0F2439" /><circle cx="320" cy="204" r="10" fill="#CBD5E1" />
            </g>
            <g transform="translate(360 18)" class="xt-ghim"><path d="M22 0 C34 0 44 10 44 22 C44 38 22 60 22 60 C22 60 0 38 0 22 C0 10 10 0 22 0 Z" fill="#fff" /><circle cx="22" cy="22" r="9" fill="#F26522" /></g>
        </svg>
        <div class="xt-the-noi xt-noi-1"><span class="xt-icon xanh"><i class="bi bi-check2-circle"></i></span><div><b>Giao thành công</b><small>Người nhận đã ký nhận</small></div></div>
        <div class="xt-the-noi xt-noi-2"><span class="xt-icon cam"><i class="bi bi-lightning-charge-fill"></i></span><div><b>Lấy hàng trong ngày</b><small>Tận nơi, đúng hẹn</small></div></div>
    </div>

    <div class="position-relative">
        @if (dangKy)
        {
            <h2 class="xt-tieu-de">Bắt đầu gửi hàng<br />chỉ với 3 bước</h2>
            <ol class="xt-buoc">
                <li><span>1</span><div><b>Tạo tài khoản miễn phí</b><small>Chưa đến một phút</small></div></li>
                <li><span>2</span><div><b>Tạo đơn, xem phí ngay</b><small>Phí tính tự động theo khu vực và khối lượng</small></div></li>
                <li><span>3</span><div><b>Theo dõi hành trình</b><small>Cập nhật từng bước đến khi giao xong</small></div></li>
            </ol>
        }
        else
        {
            <h2 class="xt-tieu-de">Quản lý vận chuyển<br />và giao nhận hàng hóa</h2>
            <div class="xt-loi-ich">
                <div><i class="bi bi-box-seam"></i><span>Khách hàng tạo đơn, xem phí và theo dõi đơn</span></div>
                <div><i class="bi bi-truck"></i><span>Nhân viên nhận việc, cập nhật giao hàng</span></div>
                <div><i class="bi bi-diagram-3"></i><span>Điều phối phân công, theo dõi, thống kê</span></div>
            </div>
        }
    </div>
    <div class="xt-chan position-relative">Nhóm 5 · DHTI17A4 · Đề tài 15</div>
</aside>
