@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Thông báo kết quả thao tác (TempData Success / Error). *@
@if (TempData["Success"] is string thanhCong)
{
    <div class="alert alert-success alert-dismissible fade show d-flex gap-2 align-items-start" role="alert">
        <i class="bi bi-check-circle-fill mt-1"></i><div>@thanhCong</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["Error"] is string loi)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex gap-2 align-items-start" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i><div>@loi</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
