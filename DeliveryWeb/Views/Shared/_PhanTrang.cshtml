@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 2 - Thanh phân trang dùng chung. Giữ nguyên mọi điều kiện tìm kiếm / lọc / sắp xếp
   trên query string, chỉ thay tham số "trang". *@
@model IPhanTrang
@{
    string Url(int trang)
    {
        var q = Context.Request.Query
            .Where(x => !string.Equals(x.Key, "trang", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(x.Value))
            .Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value.ToString())}")
            .Append($"trang={trang}");
        return Context.Request.Path + "?" + string.Join("&", q);
    }
    int dau = Math.Max(1, Model.Trang - 2), cuoi = Math.Min(Model.TongSoTrang, Model.Trang + 2);
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
    <span class="mo nho">
        @if (Model.TongSoDong == 0) { <text>Không có dữ liệu</text> }
        else { <text>Hiển thị @((Model.Trang - 1) * Model.KichThuocTrang + 1)–@Math.Min(Model.Trang * Model.KichThuocTrang, Model.TongSoDong) / @Model.TongSoDong dòng · Trang @Model.Trang/@Model.TongSoTrang</text> }
    </span>
    @if (Model.TongSoTrang > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Trang <= 1 ? "disabled" : "")"><a class="page-link" href="@Url(1)" title="Trang đầu">&laquo;</a></li>
                <li class="page-item @(Model.Trang <= 1 ? "disabled" : "")"><a class="page-link" href="@Url(Model.Trang - 1)">&lsaquo;</a></li>
                @for (int i = dau; i <= cuoi; i++)
                {
                    <li class="page-item @(i == Model.Trang ? "active" : "")"><a class="page-link" href="@Url(i)">@i</a></li>
                }
                <li class="page-item @(Model.Trang >= Model.TongSoTrang ? "disabled" : "")"><a class="page-link" href="@Url(Model.Trang + 1)">&rsaquo;</a></li>
                <li class="page-item @(Model.Trang >= Model.TongSoTrang ? "disabled" : "")"><a class="page-link" href="@Url(Model.TongSoTrang)" title="Trang cuối">&raquo;</a></li>
            </ul>
        </nav>
    }
</div>
