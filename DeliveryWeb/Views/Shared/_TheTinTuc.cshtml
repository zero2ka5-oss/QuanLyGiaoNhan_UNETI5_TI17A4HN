@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Thẻ tin tức dùng chung (trang chủ, trang tin tức, bài liên quan): ảnh bìa hoặc nền họa tiết theo
                       chuyên mục, nhãn chuyên mục nổi trên ảnh, tiêu đề 2 dòng, tóm tắt 3 dòng.
                       ViewData["NoiBat"] = true → thẻ lớn nằm ngang (bài nổi bật). *@
@model TinTuc
@{
    bool noiBat = ViewData["NoiBat"] is true;
    bool coAnh = !string.IsNullOrEmpty(Model.AnhBia);
}
<a asp-controller="TrangChu" asp-action="ChiTietTinTuc" asp-route-id="@Model.MaTinTuc" class="the-tin @(noiBat ? "the-tin-noi-bat" : "")">
    <div class="the-tin-anh @Model.ChuyenMuc.LopChuyenMuc() @(coAnh ? "co-anh" : "")">
        @if (coAnh) { <img src="@Model.AnhBia" alt="@Model.TieuDe" loading="lazy" /> }
        <i class="bi @Model.BieuTuong"></i>
        <span class="cm-nhan cm-noi @Model.ChuyenMuc.LopChuyenMuc()">@Model.ChuyenMuc.TenChuyenMuc()</span>
        @if (noiBat) { <span class="nhan-noi-bat"><i class="bi bi-star-fill"></i> Nổi bật</span> }
    </div>
    <div class="the-tin-than">
        <div class="the-tin-ngay"><i class="bi bi-calendar3"></i> @DinhDang.Ngay(Model.NgayDang)</div>
        <h3 class="the-tin-tieu-de">@Model.TieuDe</h3>
        <p class="the-tin-tom-tat">@Model.TomTat</p>
        <span class="the-tin-doc">Đọc tiếp <i class="bi bi-arrow-right"></i></span>
    </div>
</a>
