@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Layout công khai (khách vãng lai) – thanh menu trên, chân trang. *@
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_TaiNguyenDau" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="dau-trang sticky-top">
        <nav class="navbar navbar-expand-lg container">
            <a class="logo navbar-brand" asp-controller="TrangChu" asp-action="Index"><span class="bieu-tuong"><i class="bi bi-truck"></i></span>GiaoNhanh</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuChinh" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuChinh">
                <ul class="navbar-nav mx-auto gap-lg-3">
                    <li class="nav-item"><a class="nav-link @(ctrl == "TrangChu" && action == "Index" ? "active" : "")" asp-controller="TrangChu" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link @(action == "TraCuu" ? "active" : "")" asp-controller="TrangChu" asp-action="TraCuu">Tra cứu đơn</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#bang-gia">Bảng giá</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#quy-trinh">Quy trình</a></li>
                    <li class="nav-item"><a class="nav-link @(action is "TinTuc" or "ChiTietTinTuc" ? "active" : "")" asp-controller="TrangChu" asp-action="TinTuc">Tin tức</a></li>
                    <li class="nav-item"><a class="nav-link @(action == "LienHe" ? "active" : "")" asp-controller="TrangChu" asp-action="LienHe">Liên hệ</a></li>
                </ul>
                @if (Context.Session.DaDangNhap())
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="nho mo d-none d-xl-inline"><i class="bi bi-person-circle"></i> @Context.Session.HoTen()</span>
                        <a class="btn btn-cam" asp-controller="DangNhap" asp-action="TrangLamViec"><i class="bi bi-grid"></i> Vào trang làm việc</a>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a class="btn btn-vien-cam" asp-controller="DangNhap" asp-action="DangKy">Đăng ký</a>
                        <a class="btn btn-cam px-4" asp-controller="DangNhap" asp-action="Index">Đăng nhập</a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main>
        @if (TempData.Peek("Success") is not null || TempData.Peek("Error") is not null)
        {
            <div class="container mt-3"><partial name="_ThongBao" /></div>
        }
        @RenderBody()
    </main>

    <footer class="chan-trang pt-5 pb-3">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="logo mb-2 text-white"><span class="bieu-tuong"><i class="bi bi-truck"></i></span><span class="text-white">GiaoNhanh</span></div>
                    <p class="nho mb-1">Hệ thống quản lý vận chuyển và giao nhận hàng hóa – Bài tập lớn môn Thực hành lập trình .NET, đề tài 15.</p>
                    <p class="nho mb-0">Nhóm 5 · Lớp DHTI17A4 · Trường Đại học Kinh tế – Kỹ thuật Công nghiệp (UNETI)</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Dịch vụ</h6>
                    <ul class="list-unstyled nho">
                        <li><a asp-controller="TrangChu" asp-action="TraCuu">Tra cứu đơn</a></li>
                        <li><a href="/#bang-gia">Bảng giá</a></li>
                        <li><a asp-controller="TrangChu" asp-action="TinTuc">Tin tức</a></li>
                        <li><a href="/#cau-hoi">Câu hỏi thường gặp</a></li>
                        <li><a asp-controller="DangNhap" asp-action="DangKy">Mở tài khoản gửi hàng</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Hỗ trợ</h6>
                    <ul class="list-unstyled nho">
                        <li><a href="tel:19001515"><i class="bi bi-telephone"></i> 1900 1515</a></li>
                        <li><a href="mailto:hotro@giaonhan.vn"><i class="bi bi-envelope"></i> hotro@giaonhan.vn</a></li>
                        <li><a asp-controller="TrangChu" asp-action="LienHe"><i class="bi bi-chat-dots"></i> Trang liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6>Giờ làm việc</h6>
                    <p class="nho mb-0">Thứ 2 – Chủ nhật: 7:00 – 21:00<br>Lấy hàng tận nơi trong ngày</p>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="nho text-center">&copy; @DateTime.Now.Year GiaoNhanh · ASP.NET Core 10 MVC · Entity Framework Core 10 · SQL Server</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
