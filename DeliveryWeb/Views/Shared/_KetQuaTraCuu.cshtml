@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Kết quả tra cứu một đơn: thẻ trạng thái + thanh hành trình 5 bước, lịch sử giao nhận (mô tả công khai),
                       thông tin đơn (che tên / số điện thoại người nhận), số tiền thanh toán khi nhận, hỗ trợ.
                       Dùng chung cho trang Tra cứu công khai và trang Tra cứu của khách hàng. *@
@model DonGiaoHang
@{
    var d = Model;
    var lichSu = d.LichSus.OrderByDescending(l => l.ThoiGian).ThenByDescending(l => l.MaLichSu).ToList();
    bool dung = d.TrangThai is TrangThaiDon.GiaoKhongThanhCong or TrangThaiDon.DaHuy;
    bool xong = d.TrangThai is TrangThaiDon.GiaoThanhCong or TrangThaiDon.HoanTat;
    var capNhat = lichSu.FirstOrDefault()?.ThoiGian ?? d.NgayTao;
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="tc-trang-thai @d.TrangThai.LopTheTrangThai() mb-4">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="tc-icon-lon"><i class="bi @d.TrangThai.BieuTuong()"></i></span>
                <div class="flex-grow-1 min-w-0">
                    <div class="nho mo">Mã đơn <b class="text-body">@d.MaHienThi</b></div>
                    <div class="tc-ten-trang-thai">@d.TrangThai.TenHienThi()</div>
                    <div class="nho mo">@DinhDang.MoTaCongKhai(d.TrangThai)</div>
                </div>
                <div class="tc-ngay">
                    <small>@(xong ? "Đã giao" : dung ? "Cập nhật" : "Dự kiến giao")</small>
                    <b>@(xong || dung ? capNhat.ToString("dd/MM") : d.NgayGiaoDuKien.ToString("dd/MM"))</b>
                    <small>@(xong || dung ? capNhat.ToString("HH:mm") : d.NgayGiaoDuKien.ToString("yyyy"))</small>
                </div>
            </div>

            <partial name="_HanhTrinhDon" model="d" />
            <div class="tc-cap-nhat"><i class="bi bi-arrow-repeat"></i> Cập nhật lần cuối @DinhDang.ThoiGianTuongDoi(capNhat).ToLower()</div>
        </div>

        <div class="the-mem p-4">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-clock-history text-cam"></i> Lịch sử giao nhận</h2>
            <partial name="_LichSuGiaoNhan" model="lichSu" view-data="@(new ViewDataDictionary(ViewData) { ["CongKhai"] = true })" />
        </div>
    </div>

    <div class="col-lg-4">
        <div class="the-mem p-4 mb-4">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-box2 text-cam"></i> Thông tin đơn</h2>
            <div class="tc-nguoi-nhan">
                <span class="avt">@HienThi.ChuCaiDau(d.TenNguoiNhan)</span>
                <div class="min-w-0"><div class="fw-semibold text-truncate">@DinhDang.CheTen(d.TenNguoiNhan)</div><div class="nho mo">@DinhDang.CheSoDienThoai(d.SoDienThoaiNguoiNhan)</div></div>
            </div>
            <div class="dong-tt"><span><i class="bi bi-geo-alt"></i> Khu vực</span><span>@d.KhuVuc?.TenKhuVuc</span></div>
            <div class="dong-tt"><span><i class="bi bi-tag"></i> Loại hàng</span><span>@d.LoaiHang?.TenLoaiHang</span></div>
            <div class="dong-tt"><span><i class="bi bi-box"></i> Khối lượng</span><span>@DinhDang.KhoiLuong(d.KhoiLuong)</span></div>
            <div class="dong-tt"><span><i class="bi bi-calendar3"></i> Ngày tạo</span><span>@DinhDang.Ngay(d.NgayTao)</span></div>
            <div class="dong-tt"><span><i class="bi bi-calendar-check"></i> Giao dự kiến</span><span>@DinhDang.Ngay(d.NgayGiaoDuKien)</span></div>
        </div>
        <div class="tc-thanh-toan mb-4">
            <div class="nho" style="opacity:.85">Người nhận thanh toán khi nhận hàng</div>
            <div class="tc-so-tien">@DinhDang.Tien(d.TongThuNguoiNhan)</div>
            <div class="nho" style="opacity:.85">@(d.TongThuNguoiNhan > 0 ? "Thanh toán tiền mặt cho nhân viên giao hàng" : "Không cần thanh toán thêm")</div>
            <i class="bi bi-wallet2 tc-thanh-toan-icon"></i>
        </div>
        <div class="the-mem p-4 d-flex align-items-center gap-3">
            <span class="xt-icon cam" style="width:44px;height:44px;font-size:1.2rem"><i class="bi bi-headset"></i></span>
            <div class="flex-grow-1"><div class="fw-semibold">Cần hỗ trợ?</div><div class="nho mo">Tổng đài 7:00 – 21:00</div></div>
            <a href="tel:19001515" class="btn btn-cam btn-sm rounded-pill px-3 text-nowrap">1900 1515</a>
        </div>
    </div>
</div>
