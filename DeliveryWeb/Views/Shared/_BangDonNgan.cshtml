@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Bảng rút gọn danh sách đơn (dùng ở trang chi tiết loại hàng, khu vực, khách hàng). *@
@model List<DonGiaoHang>
<div class="the-mem">
    <div class="p-3 pb-0 fw-bold">Đơn gần đây</div>
    <div class="table-responsive">
        <table class="table bang">
            <thead><tr><th>Đơn / Khách gửi</th><th>Người nhận</th><th class="text-end">Phí</th><th>Trạng thái</th><th>Ngày tạo</th></tr></thead>
            <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td class="text-nowrap"><a asp-controller="QuanTriDonGiaoHang" asp-action="ChiTiet" asp-route-id="@d.MaDon" class="fw-bold">@d.MaHienThi</a><div class="nho mo">@d.KhachHang?.HoTen</div></td>
                    <td class="text-nowrap">@d.TenNguoiNhan<div class="nho mo">@d.KhuVuc?.TenKhuVuc</div></td>
                    <td class="text-end text-nowrap fw-semibold">@DinhDang.Tien(d.PhiVanChuyen)<div class="nho mo fw-normal">@DinhDang.KhoiLuong(d.KhoiLuong)</div></td>
                    <td><span class="tt @d.TrangThai.LopBadge()">@d.TrangThai.TenHienThi()</span></td>
                    <td class="nho mo">@DinhDang.Ngay(d.NgayTao)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0) { <div class="o-trong"><i class="bi bi-inbox"></i>Chưa có đơn</div> }
</div>
