@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 1 - Danh sách khu vực giao. *@
@model DanhSachTrang<KhuVuc>
@{
    ViewData["Title"] = "Khu vực giao";
    var soDon = (Dictionary<int, int>)ViewBag.SoDon;
    var soNv = (Dictionary<int, int>)ViewBag.SoNhanVien;
}
<form method="get" class="thanh-loc mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5"><label class="form-label nho">Tìm kiếm</label><input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tên khu vực" /></div>
        <div class="col-md-3"><label class="form-label nho">Trạng thái</label>
            <select name="trangThai" class="form-select"><option value="">Tất cả</option>
                <option value="HoatDong" selected="@(ViewBag.TrangThai == TrangThaiHoatDong.HoatDong)">Đang hoạt động</option>
                <option value="NgungHoatDong" selected="@(ViewBag.TrangThai == TrangThaiHoatDong.NgungHoatDong)">Ngừng hoạt động</option>
            </select></div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-cam flex-fill"><i class="bi bi-funnel"></i> Lọc</button>
            @if (Context.Session.LaQuanTri()) { <a asp-action="TaoMoi" class="btn btn-outline-dark flex-fill"><i class="bi bi-plus-lg"></i> Thêm khu vực</a> }
        </div>
    </div>
</form>
<div class="the-mem">
    <div class="table-responsive">
        <table class="table bang">
            <thead><tr><th>Mã</th><th>Tên khu vực</th><th class="text-end">Phí cơ bản</th><th>Mô tả</th><th class="text-end">Nhân viên</th><th class="text-end">Số đơn</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var k in Model.DanhSach)
            {
                <tr>
                    <td class="mo">#@k.MaKhuVuc</td>
                    <td><a asp-action="ChiTiet" asp-route-id="@k.MaKhuVuc" class="ten">@k.TenKhuVuc</a></td>
                    <td class="text-end fw-semibold">@DinhDang.Tien(k.PhiCoBan)</td>
                    <td class="nho mo">@k.MoTa</td>
                    <td class="text-end">@soNv.GetValueOrDefault(k.MaKhuVuc)</td>
                    <td class="text-end">@soDon.GetValueOrDefault(k.MaKhuVuc)</td>
                    <td><span class="tt @k.TrangThai.LopBadge()">@k.TrangThai.TenHienThi()</span></td>
                    <td class="text-end text-nowrap">
                        @if (Context.Session.LaQuanTri())
                        {
                            <a asp-action="ChinhSua" asp-route-id="@k.MaKhuVuc" class="btn btn-sm btn-light" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DoiTrangThai" asp-route-id="@k.MaKhuVuc" method="post" class="d-inline">
                                <button class="btn btn-sm btn-light" title="@(k.TrangThai == TrangThaiHoatDong.HoatDong ? "Ngừng nhận đơn" : "Kích hoạt")"><i class="bi @(k.TrangThai == TrangThaiHoatDong.HoatDong ? "bi-pause-circle" : "bi-play-circle")"></i></button>
                            </form>
                            <form asp-action="Xoa" asp-route-id="@k.MaKhuVuc" method="post" class="d-inline" data-xac-nhan="Xóa khu vực @k.TenKhuVuc?">
                                <button class="btn btn-sm btn-light text-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                        else
                        {
                            <a asp-action="ChiTiet" asp-route-id="@k.MaKhuVuc" class="btn btn-sm btn-light" title="Chi tiết"><i class="bi bi-eye"></i></a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TongSoDong == 0) { <div class="o-trong"><i class="bi bi-inbox"></i>Không có khu vực phù hợp</div> }
</div>
<partial name="_PhanTrang" model="Model" />
