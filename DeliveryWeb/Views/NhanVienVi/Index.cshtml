@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 4 - Ví shipper: số dư tiền ship (rút về ngân hàng), tiền thu hộ đang giữ (nộp về công ty),
                       lịch sử giao dịch kèm trạng thái xác nhận của công ty. *@
@model ViShipperVM
@{
    ViewData["Title"] = "Ví của tôi";
    bool phaiNopTruoc = Model.TienDangGiu > 0;
    decimal rutToiDa = Math.Floor(Model.SoDu / 1000) * 1000;
    string noiDungNop = $"NOP TIEN THU HO NV{Model.NhanVien.MaNhanVien:D3}";
}

@* ---------- Số dư + tác vụ nhanh ---------- *@
<div class="vi-so-du mb-3">
    <div class="nho" style="opacity:.8">Số dư ví</div>
    <div class="so">@DinhDang.Tien(Model.SoDu)</div>
    <div class="vi-phu">
        <span>Thu nhập <b>@DinhDang.Tien(Model.ThuNhap)</b></span>
        <span>Đã rút <b>@DinhDang.Tien(Model.DaRut)</b></span>
        @if (Model.DangChoRut > 0) { <span>Chờ rút <b>@DinhDang.Tien(Model.DangChoRut)</b></span> }
    </div>
    <div class="vi-tac-vu">
        <button type="button" data-bs-toggle="modal" data-bs-target="#hopRut"><span><i class="bi bi-bank"></i></span>Rút tiền</button>
        <button type="button" data-bs-toggle="modal" data-bs-target="#hopNop" @(Model.TienDangGiu > 0 ? "" : "disabled")><span><i class="bi bi-send"></i></span>Nộp thu hộ</button>
        <a href="#lichSu"><span><i class="bi bi-clock-history"></i></span>Lịch sử</a>
    </div>
</div>

@* ---------- Tiền thu hộ đang giữ ---------- *@
<div class="vi-cod mb-3">
    <div class="d-flex align-items-center gap-3">
        <span class="vi-icon"><i class="bi bi-safe2"></i></span>
        <div class="flex-grow-1">
            <div class="nho mo">Tiền thu hộ đang giữ</div>
            <div class="fs-4 fw-bold lh-sm" style="color:#C2410C">@DinhDang.Tien(Model.TienDangGiu)</div>
        </div>
        @if (Model.TienDangGiu > 0)
        {
            <button type="button" class="btn btn-cam btn-sm px-3" data-bs-toggle="modal" data-bs-target="#hopNop">Nộp ngay</button>
        }
    </div>
    @if (Model.TienChoXacNhanNop > 0)
    {
        <div class="vi-chip mt-2"><i class="bi bi-hourglass-split"></i> Đã nộp @DinhDang.Tien(Model.TienChoXacNhanNop) · chờ xác nhận</div>
    }
    @if (Model.DonDangGiu.Count > 0)
    {
        <details class="mt-2">
            <summary class="nho fw-semibold text-cam">@Model.DonDangGiu.Count đơn chưa nộp</summary>
            <div class="mt-1">
                @foreach (var d in Model.DonDangGiu)
                {
                    <div class="dong-tt nho"><span>@d.MaHienThi · @d.TenNguoiNhan</span><span>@DinhDang.Tien(d.TongThuNguoiNhan)</span></div>
                }
            </div>
        </details>
    }
</div>

@* ---------- Lịch sử giao dịch ---------- *@
<div class="vi-lich-su" id="lichSu">
    <div class="fw-bold px-3 pt-3 pb-2">Lịch sử giao dịch</div>
    @foreach (var g in Model.LichSu)
    {
        bool nop = g.Loai == LoaiGiaoDich.NopTienThuHo;
        string mau = g.TrangThai switch { TrangThaiGiaoDich.DaXacNhan => "text-success", TrangThaiGiaoDich.TuChoi => "text-danger", _ => "text-warning" };
        <div class="vi-dong">
            <span class="vi-icon @(nop ? "nop" : "rut")"><i class="bi @(nop ? "bi-arrow-up-right" : "bi-arrow-down-left")"></i></span>
            <div class="flex-grow-1 min-w-0">
                <div class="d-flex justify-content-between gap-2">
                    <span class="fw-semibold">@(nop ? "Nộp tiền thu hộ" : "Rút về ngân hàng")</span>
                    <span class="fw-bold text-nowrap @(g.TrangThai == TrangThaiGiaoDich.TuChoi ? "mo text-decoration-line-through" : "")">@(nop ? "−" : "")@DinhDang.Tien(g.SoTien)</span>
                </div>
                <div class="d-flex justify-content-between gap-2 nho">
                    <span class="mo text-truncate">@DinhDang.NgayGio(g.NgayTao) · @(nop ? g.PhuongThuc : g.ThongTinThanhToan?.Split(" – ")[0])</span>
                    <span class="@mau fw-semibold text-nowrap">@g.TrangThai.TenHienThi()</span>
                </div>
                @if (g.TrangThai == TrangThaiGiaoDich.TuChoi && g.GhiChu?.Contains("Từ chối:") == true)
                {
                    <div class="nho text-danger">@g.GhiChu[(g.GhiChu.IndexOf("Từ chối:") + 8)..].Trim()</div>
                }
            </div>
        </div>
    }
    @if (Model.LichSu.Count == 0) { <div class="text-center mo nho py-4">Chưa có giao dịch</div> }
</div>

@* ---------- Hộp rút tiền ---------- *@
<div class="modal fade hop-day" id="hopRut" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="hop-day-dau"><span class="fw-bold">Rút tiền</span><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            @if (phaiNopTruoc)
            {
                <div class="text-center py-3">
                    <div class="vi-icon mx-auto mb-2" style="width:56px;height:56px;font-size:1.5rem"><i class="bi bi-safe2"></i></div>
                    <div class="fw-semibold">Bạn đang giữ @DinhDang.Tien(Model.TienDangGiu) tiền thu hộ</div>
                    <div class="mo nho mb-3">Nộp về công ty để rút tiền</div>
                    <button type="button" class="btn btn-cam w-100 py-2" data-bs-toggle="modal" data-bs-target="#hopNop">Nộp tiền ngay</button>
                </div>
            }
            else
            {
                <form asp-action="RutTien" method="post">
                    <div class="text-center">
                        <div class="d-flex justify-content-center align-items-baseline gap-1">
                            <input id="soTienRutHienThi" type="text" class="o-so-tien" placeholder="0" inputmode="numeric" autocomplete="off" />
                            <span class="fs-4 fw-bold mo">đ</span>
                        </div>
                        <input type="hidden" name="SoTien" id="soTienRut" />
                        <div class="nho mo">Số dư @DinhDang.Tien(Model.SoDu)</div>
                    </div>
                    <div class="chip-tien my-3">
                        @foreach (var m in new decimal[] { 50_000, 100_000, 200_000 }.Where(m => m <= rutToiDa))
                        {
                            <button type="button" data-tien="@m">@((m / 1000).ToString("0"))k</button>
                        }
                        <button type="button" data-tien="@rutToiDa">Tất cả</button>
                    </div>
                    <select name="NganHang" class="form-select mb-2" required>
                        <option value="">Chọn ngân hàng</option>
                        @foreach (var nh in ViXuLy.DsNganHang) { <option>@nh</option> }
                    </select>
                    <input name="SoTaiKhoan" class="form-control mb-2" placeholder="Số tài khoản" inputmode="numeric" required />
                    <input name="ChuTaiKhoan" class="form-control mb-3 text-uppercase" placeholder="Chủ tài khoản" value="@Model.NhanVien.HoTen" required />
                    <button class="btn btn-cam w-100 py-2 fw-semibold" id="nutRut" @(rutToiDa < ViXuLy.RutToiThieu ? "disabled" : "")>Rút tiền</button>
                </form>
            }
        </div>
    </div>
</div>

@* ---------- Hộp nộp tiền thu hộ ---------- *@
@if (Model.TienDangGiu > 0)
{
    <div class="modal fade hop-day" id="hopNop" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="hop-day-dau"><span class="fw-bold">Nộp tiền thu hộ</span><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form asp-action="NopTien" method="post">
                    <div class="text-center mb-3">
                        <div class="fw-bold" style="font-size:2rem;color:#C2410C">@DinhDang.Tien(Model.TienDangGiu)</div>
                        <div class="nho mo">@Model.SoDonDangGiu đơn</div>
                    </div>
                    <div class="o-phuong-thuc mb-3">
                        @foreach (var (pt, icon, ten) in new[] { ("Chuyển khoản ngân hàng", "bi-bank", "Ngân hàng"), ("Ví MoMo", "bi-wallet2", "MoMo"), ("Nộp tiền mặt tại bưu cục", "bi-shop", "Bưu cục") })
                        {
                            <label>
                                <input type="radio" name="PhuongThuc" value="@pt" @(pt == "Chuyển khoản ngân hàng" ? "checked" : "") />
                                <span><i class="bi @icon"></i>@ten</span>
                            </label>
                        }
                    </div>
                    <div class="tk-cong-ty mb-3" id="tkCongTy">
                        <div class="dong-tt"><span>Ngân hàng</span><span>Vietcombank</span></div>
                        <div class="dong-tt"><span>Số tài khoản</span><span><b>0011002233445</b> <button type="button" class="nut-chep" data-chep="0011002233445"><i class="bi bi-copy"></i></button></span></div>
                        <div class="dong-tt"><span>Chủ tài khoản</span><span>CONG TY GIAO NHANH</span></div>
                        <div class="dong-tt"><span>Nội dung</span><span><b>@noiDungNop</b> <button type="button" class="nut-chep" data-chep="@noiDungNop"><i class="bi bi-copy"></i></button></span></div>
                    </div>
                    <input name="MaThamChieu" class="form-control mb-3" placeholder="Mã giao dịch / biên nhận" />
                    <button class="btn btn-cam w-100 py-2 fw-semibold">Xác nhận đã nộp</button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Chọn nhanh số tiền rút + hiển thị số tiền trên nút
        const oRut = document.getElementById('soTienRut'), oHienThi = document.getElementById('soTienRutHienThi'), nutRut = document.getElementById('nutRut');
        const datSoTien = v => {
            const so = Number(String(v).replace(/\D/g, '')) || 0;
            oRut.value = so || '';
            oHienThi.value = so ? so.toLocaleString('vi-VN') : '';
            nutRut.textContent = so ? 'Rút ' + so.toLocaleString('vi-VN') + ' đ' : 'Rút tiền';
        };
        oRut?.form.addEventListener('submit', e => { if (!oRut.value) { e.preventDefault(); oHienThi.focus(); } });
        oHienThi?.addEventListener('input', () => { datSoTien(oHienThi.value); document.querySelectorAll('.chip-tien button').forEach(x => x.classList.remove('active')); });
        document.querySelectorAll('.chip-tien button').forEach(b => b.addEventListener('click', () => {
            document.querySelectorAll('.chip-tien button').forEach(x => x.classList.remove('active'));
            b.classList.add('active'); datSoTien(b.dataset.tien);
        }));
        // Tài khoản công ty chỉ cần khi chuyển khoản / MoMo
        document.querySelectorAll('input[name="PhuongThuc"]').forEach(r => r.addEventListener('change', () => {
            document.getElementById('tkCongTy').style.display = r.value.includes('bưu cục') && r.checked ? 'none' : '';
        }));
    </script>
}
