@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 2 - Khách hàng xem / cập nhật thông tin cá nhân của chính mình: thẻ hồ sơ (ảnh bìa, ảnh đại diện,
                       số liệu), form thông tin liên hệ + địa chỉ lấy hàng (báo khi có thay đổi chưa lưu), tài khoản & bảo mật. *@
@model KhachHangFormVM
@{
    ViewData["Title"] = "Thông tin cá nhân";
    DateTime ngayDangKy = ViewBag.NgayDangKy;
}

@* ---------- Thẻ hồ sơ ---------- *@
<div class="hs-the mb-4">
    <div class="hs-bia"></div>
    <div class="hs-than">
        <div class="hs-avt"><partial name="_DoiAnhDaiDien" model="new AnhDaiDienVM(Context.Session.AnhDaiDien(), Model.HoTen)" /></div>
        <div class="hs-ten flex-grow-1 min-w-0">
            <h2>@Model.HoTen</h2>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="hs-nhan"><i class="bi bi-at"></i>@Model.TenDangNhap</span>
                <span class="hs-nhan"><i class="bi bi-calendar-heart"></i> Thành viên từ @DinhDang.Ngay(ngayDangKy)</span>
            </div>
        </div>
        <div class="hs-so-lieu">
            <a asp-controller="KhachHangDonHang" asp-action="Index"><b>@ViewBag.SoDon</b><span>Đơn hàng</span></a>
            <a asp-controller="KhachHangDonHang" asp-action="Index" asp-route-TrangThai="HoanTat"><b>@ViewBag.SoDaGiao</b><span>Đã giao</span></a>
            <div><b>@DinhDang.Tien((decimal)ViewBag.TongPhi)</b><span>Tổng phí</span></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="Index" method="post" id="formHoSo" class="the-mem hs-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <h3 class="td-tieu-de"><span><i class="bi bi-person-lines-fill"></i></span> Thông tin liên hệ</h3>
            <div class="row g-3 mb-4">
                <div class="col-md-6"><label asp-for="HoTen" class="form-label"></label>
                    <div class="o-nhap"><i class="bi bi-person"></i><input asp-for="HoTen" class="form-control" autocomplete="name" /></div>
                    <span asp-validation-for="HoTen" class="text-danger nho"></span></div>
                <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label"></label>
                    <div class="o-nhap"><i class="bi bi-telephone"></i><input asp-for="SoDienThoai" class="form-control" inputmode="tel" maxlength="10" autocomplete="tel" /></div>
                    <span asp-validation-for="SoDienThoai" class="text-danger nho"></span></div>
                <div class="col-12"><label asp-for="Email" class="form-label"></label>
                    <div class="o-nhap"><i class="bi bi-envelope"></i><input asp-for="Email" class="form-control" inputmode="email" autocomplete="email" placeholder="ban@email.com" /></div>
                    <span asp-validation-for="Email" class="text-danger nho"></span></div>
            </div>

            <h3 class="td-tieu-de"><span><i class="bi bi-geo-alt"></i></span> Địa chỉ lấy hàng</h3>
            <div class="o-nhap mb-2"><i class="bi bi-house-door"></i><input asp-for="DiaChi" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" autocomplete="street-address" /></div>
            <span asp-validation-for="DiaChi" class="text-danger nho d-block mb-2"></span>
            <div class="td-gui">
                <span class="ct-diem-icon gui"><i class="bi bi-box-arrow-up"></i></span>
                <div class="flex-grow-1 min-w-0">
                    <div class="ct-nhan">Nhân viên sẽ đến lấy hàng tại</div>
                    <div class="fw-semibold" id="xemDiaChi">@Model.DiaChi</div>
                </div>
            </div>

            <div class="hs-luu">
                <span class="hs-thay-doi" id="hsThayDoi"><i class="bi bi-pencil-square"></i> Có thay đổi chưa lưu</span>
                <button type="reset" class="btn btn-light" id="nutHoanTac" disabled>Hoàn tác</button>
                <button class="btn btn-cam px-4" id="nutLuu"><i class="bi bi-check2"></i> Lưu thay đổi</button>
            </div>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="the-mem p-4 mb-4">
            <h3 class="h6 fw-bold mb-3"><i class="bi bi-shield-lock text-cam"></i> Tài khoản & bảo mật</h3>
            <div class="hs-dong">
                <span class="lh-icon xanh"><i class="bi bi-person-badge"></i></span>
                <div class="flex-grow-1 min-w-0"><small>Tên đăng nhập</small><b>@Model.TenDangNhap</b></div>
            </div>
            <a asp-controller="DangNhap" asp-action="DoiMatKhau" class="hs-dong hs-lien-ket">
                <span class="lh-icon cam"><i class="bi bi-key"></i></span>
                <div class="flex-grow-1 min-w-0"><small>Mật khẩu</small><b>Đổi mật khẩu</b></div>
                <i class="bi bi-chevron-right mo"></i>
            </a>
            <form asp-controller="DangNhap" asp-action="DangXuat" method="post" data-xac-nhan="Đăng xuất khỏi tài khoản?">
                <button class="hs-dong hs-lien-ket hs-dang-xuat w-100">
                    <span class="lh-icon do"><i class="bi bi-box-arrow-right"></i></span>
                    <div class="flex-grow-1 text-start"><small>Phiên đăng nhập</small><b>Đăng xuất</b></div>
                </button>
            </form>
        </div>
        <div class="the-mem p-4">
            <h3 class="h6 fw-bold mb-3"><i class="bi bi-lightning-charge text-cam"></i> Lối tắt</h3>
            <div class="lh-loi-tat">
                <a asp-controller="KhachHangDonHang" asp-action="TaoMoi"><span class="lh-icon cam"><i class="bi bi-plus-lg"></i></span><div><b>Tạo đơn mới</b><small>Lấy hàng tại địa chỉ trên</small></div><i class="bi bi-chevron-right"></i></a>
                <a asp-controller="KhachHangTienIch" asp-action="BangGia"><span class="lh-icon vang"><i class="bi bi-calculator"></i></span><div><b>Ước lượng phí</b><small>Biết trước chi phí</small></div><i class="bi bi-chevron-right"></i></a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Báo "có thay đổi chưa lưu" + xem trước địa chỉ lấy hàng
        const fHs = document.getElementById('formHoSo');
        const oNhap = [...fHs.querySelectorAll('input.form-control')];
        const banDau = oNhap.map(o => o.value);
        const capNhat = () => {
            const doi = oNhap.some((o, i) => o.value !== banDau[i]);
            document.getElementById('hsThayDoi').classList.toggle('hien', doi);
            document.getElementById('nutHoanTac').disabled = !doi;
            document.getElementById('xemDiaChi').textContent = document.getElementById('DiaChi').value || '—';
        };
        fHs.addEventListener('input', capNhat);
        fHs.addEventListener('reset', () => setTimeout(capNhat, 0));
        window.addEventListener('beforeunload', e => { if (document.getElementById('hsThayDoi').classList.contains('hien') && !fHs.dataset.dangGui) e.preventDefault(); });
        fHs.addEventListener('submit', () => { fHs.dataset.dangGui = '1'; });
    </script>
}
