@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Form thêm / sửa banner trang chủ – chọn ảnh (xem trước ngay), tiêu đề, mô tả, nút bấm, thứ tự. *@
@model BannerTrangChu
@{
    bool laTao = Model.MaBanner == 0;
    ViewData["Title"] = laTao ? "Thêm banner" : "Sửa banner";
}
<form asp-action="@(laTao ? "TaoMoi" : "ChinhSua")" method="post" enctype="multipart/form-data" id="formBanner">
    <input type="hidden" asp-for="MaBanner" />
    <div class="row g-3">
        <div class="col-xl-7">
            <div class="the-mem p-4">
                <label class="form-label">Ảnh banner</label>
                <label class="o-tai-anh o-tai-anh-rong @(string.IsNullOrEmpty(Model.Anh) ? "" : "co-anh")" id="oAnh">
                    <img src="@(string.IsNullOrEmpty(Model.Anh) ? null : Model.Anh)" alt="" />
                    <span class="goi-y"><i class="bi bi-image"></i>Chọn ảnh banner</span>
                    <input type="file" name="anhBanner" accept="@AnhXuLy.ChapNhan" class="d-none" />
                </label>
                <span asp-validation-for="Anh" class="text-danger nho d-block mb-3"></span>
                <div class="mb-3"><label asp-for="TieuDe" class="form-label"></label><input asp-for="TieuDe" class="form-control" maxlength="150" /><span asp-validation-for="TieuDe" class="text-danger nho"></span></div>
                <div class="mb-3"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" rows="2" class="form-control" maxlength="300"></textarea><span asp-validation-for="MoTa" class="text-danger nho"></span></div>
                <div class="row g-3">
                    <div class="col-md-5"><label asp-for="ChuNut" class="form-label"></label><input asp-for="ChuNut" class="form-control" placeholder="Tạo đơn ngay" maxlength="50" /><span asp-validation-for="ChuNut" class="text-danger nho"></span></div>
                    <div class="col-md-7"><label asp-for="LienKet" class="form-label"></label><input asp-for="LienKet" class="form-control" placeholder="/TrangChu/TraCuu" /><span asp-validation-for="LienKet" class="text-danger nho"></span></div>
                </div>
            </div>
        </div>
        <div class="col-xl-5">
            <div class="the-mem p-4 mb-3">
                <div class="mb-3"><label asp-for="ThuTu" class="form-label"></label><input asp-for="ThuTu" type="number" min="0" max="999" class="form-control" /><span asp-validation-for="ThuTu" class="text-danger nho"></span></div>
                <div class="form-check form-switch mb-4"><input asp-for="HienThi" class="form-check-input" role="switch" /><label asp-for="HienThi" class="form-check-label"></label></div>
                <div class="d-flex gap-2">
                    <button class="btn btn-cam flex-fill"><i class="bi bi-check2"></i> @(laTao ? "Thêm banner" : "Lưu thay đổi")</button>
                    <a asp-action="Index" class="btn btn-light">Hủy</a>
                </div>
            </div>
            <div class="nho fw-semibold mo mb-2">Xem trước</div>
            <div class="banner-xem-truoc" id="xemTruoc">
                <img src="@(string.IsNullOrEmpty(Model.Anh) ? null : Model.Anh)" alt="" />
                <div class="noi-dung">
                    <div class="tieu-de"></div>
                    <div class="mo-ta"></div>
                    <span class="btn btn-cam btn-sm rounded-pill px-3 nut"></span>
                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const f = document.getElementById('formBanner'), xt = document.getElementById('xemTruoc'), oAnh = document.getElementById('oAnh');
        let anhMoi = null;
        const capNhat = () => {
            xt.querySelector('.tieu-de').textContent = f.TieuDe.value || 'Tiêu đề banner';
            xt.querySelector('.mo-ta').textContent = f.MoTa.value;
            const nut = xt.querySelector('.nut'); nut.textContent = f.ChuNut.value; nut.hidden = !f.ChuNut.value;
            xt.querySelector('img').src = oAnh.querySelector('img').src;
            xt.classList.toggle('co-anh', oAnh.classList.contains('co-anh'));
        };
        oAnh.querySelector('input').addEventListener('change', e => {
            const tep = e.target.files[0]; if (!tep) return;
            if (anhMoi) URL.revokeObjectURL(anhMoi);
            anhMoi = URL.createObjectURL(tep);
            oAnh.querySelector('img').src = anhMoi; oAnh.classList.add('co-anh'); capNhat();
        });
        f.addEventListener('input', capNhat); capNhat();
    </script>
}
