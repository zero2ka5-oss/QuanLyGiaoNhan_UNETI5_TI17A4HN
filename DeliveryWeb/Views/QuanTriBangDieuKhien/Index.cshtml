@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 5 - Dashboard quản trị / điều phối (mục 9.4): KPI, biểu đồ, việc cần xử lý, hoạt động gần đây. *@
@model DashboardVM
@{ ViewData["Title"] = "Bảng điều khiển"; }
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Tổng số đơn</div><div class="gia-tri">@Model.TongDon</div><div class="nho mo">@Model.TongKhachHang khách hàng</div></div><div class="icon icon-cam"><i class="bi bi-box-seam"></i></div></div></div>
    <div class="col-6 col-xl-3"><a asp-controller="QuanTriPhanCong" asp-action="Index" class="kpi d-flex justify-content-between text-reset"><div><div class="nhan">Chờ phân công</div><div class="gia-tri text-cam">@Model.ChoPhanCong</div><div class="nho mo">+ @Model.GiaoKhongThanhCong cần giao lại</div></div><div class="icon icon-vang"><i class="bi bi-hourglass-split"></i></div></a></div>
    <div class="col-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Đang giao</div><div class="gia-tri text-primary">@Model.DangGiao</div><div class="nho mo">@Model.GiaoThanhCong chờ hoàn tất</div></div><div class="icon icon-xanh"><i class="bi bi-truck"></i></div></div></div>
    @if (Context.Session.LaQuanTri())
    {
        <div class="col-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Tổng phí đơn hợp lệ</div><div class="gia-tri fs-4">@DinhDang.Tien(Model.TongPhiHopLe)</div><div class="nho mo">@Model.HoanTat đơn hoàn tất</div></div><div class="icon icon-luc"><i class="bi bi-cash-stack"></i></div></div></div>
    }
    else
    {
        <div class="col-6 col-xl-3"><a asp-controller="QuanTriDonGiaoHang" asp-action="Index" asp-route-TrangThai="GiaoKhongThanhCong" class="kpi d-flex justify-content-between text-reset"><div><div class="nhan">Giao không thành công</div><div class="gia-tri text-danger">@Model.GiaoKhongThanhCong</div><div class="nho mo">cần sắp xếp giao lại</div></div><div class="icon icon-do"><i class="bi bi-arrow-repeat"></i></div></a></div>
    }
</div>
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="kpi"><div class="nhan"><i class="bi bi-person-check text-success"></i> Nhân viên sẵn sàng</div><div class="gia-tri fs-4">@Model.NhanVienSanSang</div></div></div>
    <div class="col-6 col-md-3"><div class="kpi"><div class="nhan"><i class="bi bi-person-walking text-primary"></i> Nhân viên đang giao</div><div class="gia-tri fs-4">@Model.NhanVienDangGiao</div></div></div>
    <div class="col-6 col-md-3"><div class="kpi"><div class="nhan"><i class="bi bi-truck-front text-success"></i> Xe sẵn sàng / đang dùng</div><div class="gia-tri fs-4">@Model.PhuongTienSanSang <span class="mo fs-6">/ @Model.PhuongTienDangSuDung</span></div></div></div>
    <div class="col-6 col-md-3"><a asp-controller="QuanTriDonGiaoHang" asp-action="Index" asp-route-TrangThai="GiaoThanhCong" class="kpi d-block text-reset"><div class="nhan"><i class="bi bi-cash-coin text-cam"></i> Tiền thu hộ chờ đối soát</div><div class="gia-tri fs-5 text-cam">@DinhDang.Tien(Model.TienChoDoiSoat)</div><div class="nho mo">@Model.SoDonChoDoiSoat đơn shipper đang giữ tiền</div></a></div>
</div>
<div class="row g-3 mb-3">
    <div class="col-xl-8"><div class="the-mem p-3 h-100"><div class="fw-bold mb-2">Số đơn tạo mới 14 ngày gần nhất</div><div class="chart-box"><canvas id="bdNgay"></canvas></div></div></div>
    <div class="col-xl-4"><div class="the-mem p-3 h-100"><div class="fw-bold mb-2">Đơn theo trạng thái</div><div class="chart-box"><canvas id="bdTrangThai"></canvas></div></div></div>
</div>
<div class="row g-3">
    <div class="col-xl-7">
        <div class="the-mem h-100">
            <div class="p-3 d-flex justify-content-between"><span class="fw-bold"><i class="bi bi-lightning-charge text-cam"></i> Việc cần xử lý</span><a asp-controller="QuanTriPhanCong" asp-action="Index" class="btn btn-cam btn-sm rounded-pill px-3">Bảng điều phối</a></div>
            <div class="list-group list-group-flush">
                @foreach (var d in Model.DonCanXuLy)
                {
                    bool treHan = d.NgayGiaoDuKien.Date < DateTime.Today;
                    <div class="list-group-item viec-dong">
                        <span class="viec-icon @d.TrangThai.LopBadge()"><i class="bi @d.TrangThai.BieuTuong()"></i></span>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <a asp-controller="QuanTriDonGiaoHang" asp-action="ChiTiet" asp-route-id="@d.MaDon" class="fw-bold">@d.MaHienThi</a>
                                <span class="fw-semibold text-truncate">@d.KhachHang?.HoTen</span>
                            </div>
                            <div class="viec-meta">
                                <span><i class="bi bi-geo-alt"></i>@d.KhuVuc?.TenKhuVuc</span>
                                <span class="@(treHan ? "tre" : "")"><i class="bi @(treHan ? "bi-exclamation-circle" : "bi-calendar-event")"></i>@(treHan ? "Quá hạn · " : "Giao ")@d.NgayGiaoDuKien.ToString("dd/MM")</span>
                                @if (d.TienThuHo > 0) { <span><i class="bi bi-cash-coin"></i>Thu hộ @DinhDang.Tien(d.TienThuHo)</span> }
                            </div>
                        </div>
                        @if (d.TrangThai == TrangThaiDon.GiaoThanhCong && !Context.Session.LaQuanTri())
                        {
                            <span class="tt tt-cho text-nowrap"><i class="bi bi-hourglass-split"></i> Chờ đối soát</span>
                        }
                        else if (d.TrangThai == TrangThaiDon.GiaoThanhCong)
                        {
                            <form asp-controller="QuanTriDonGiaoHang" asp-action="HoanTat" asp-route-id="@d.MaDon" asp-route-quayLai="@Url.Action("Index")" method="post" data-xac-nhan="Đối soát & hoàn tất đơn @d.MaHienThi?">
                                <button class="btn btn-sm btn-success text-nowrap"><i class="bi bi-patch-check"></i> Hoàn tất</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="QuanTriPhanCong" asp-action="TaoMoi" asp-route-maDon="@d.MaDon" class="btn btn-sm btn-cam text-nowrap"><i class="bi bi-person-plus"></i> @(d.TrangThai == TrangThaiDon.GiaoKhongThanhCong ? "Giao lại" : "Phân công")</a>
                        }
                    </div>
                }
                @if (Model.DonCanXuLy.Count == 0) { <div class="o-trong"><i class="bi bi-check2-all"></i>Không có việc tồn đọng</div> }
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="the-mem p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2"><span class="fw-bold"><i class="bi bi-activity text-cam"></i> Hoạt động gần đây</span><a asp-controller="QuanTriLichSuGiaoNhan" asp-action="Index" class="btn btn-cam btn-sm rounded-pill px-3">Tất cả</a></div>
            <div class="hoat-dong">
                @foreach (var l in Model.HoatDongGanDay)
                {
                    var (ten, vaiTro, _) = DinhDang.TachNguoiThucHien(l.NguoiThucHien);
                    <a asp-controller="QuanTriDonGiaoHang" asp-action="ChiTiet" asp-route-id="@l.MaDon" class="hd-dong">
                        <span class="hd-icon @l.TrangThaiMoi.LopBadge()"><i class="bi @l.TrangThaiMoi.BieuTuong()"></i></span>
                        <span class="flex-grow-1 min-w-0">
                            <span class="d-flex justify-content-between gap-2">
                                <span class="text-truncate"><b>@l.DonGiaoHang?.MaHienThi</b> · @(l.TrangThaiCu == l.TrangThaiMoi ? "Cập nhật thông tin" : l.TrangThaiMoi.TenHienThi())</span>
                                <span class="hd-gio" title="@DinhDang.NgayGio(l.ThoiGian)">@DinhDang.ThoiGianTuongDoi(l.ThoiGian)</span>
                            </span>
                            <span class="hd-nguoi text-truncate">@ten@(vaiTro is null ? "" : " · " + vaiTro)</span>
                        </span>
                    </a>
                }
                @if (Model.HoatDongGanDay.Count == 0) { <div class="o-trong">Chưa có hoạt động</div> }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = 'Be Vietnam Pro, Arial, sans-serif';
        Chart.defaults.maintainAspectRatio = false;
        new Chart(document.getElementById('bdNgay'), {
            type: 'bar',
            data: { labels: @Html.Raw(Json.Serialize(Model.NhanNgay)),
                    datasets: [{ label: 'Số đơn', data: @Html.Raw(Json.Serialize(Model.SoDonTheoNgay)), backgroundColor: '#F26522', borderRadius: 6 }] },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
        new Chart(document.getElementById('bdTrangThai'), {
            type: 'doughnut',
            data: { labels: @Html.Raw(Json.Serialize(Model.TheoTrangThai.OrderBy(x => x.Key).Select(x => x.Key.TenHienThi()))),
                    datasets: [{ data: @Html.Raw(Json.Serialize(Model.TheoTrangThai.OrderBy(x => x.Key).Select(x => x.Value))),
                                 backgroundColor: ['#F59E0B', '#60A5FA', '#3B82F6', '#6366F1', '#22C55E', '#EF4444', '#059669', '#9CA3AF'] }] },
            options: { plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } } }
        });
    </script>
}
