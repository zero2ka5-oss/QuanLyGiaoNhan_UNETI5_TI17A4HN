@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 3 - Form thêm / sửa nhân viên giao hàng (kèm tạo tài khoản). Trạng thái chỉ cho chọn
                       Sẵn sàng / Tạm nghỉ / Ngừng hoạt động. *@
@model NhanVienFormVM
@{
    bool laTao = Model.MaNhanVien == 0;
    ViewData["Title"] = laTao ? "Thêm nhân viên giao hàng" : "Sửa nhân viên giao hàng";
    var ttHienTai = ViewBag.TrangThaiHienTai as TrangThaiNhanVien?;
}
<div class="the-mem p-4" style="max-width: 820px">
    <form asp-action="@(laTao ? "TaoMoi" : "ChinhSua")" method="post">
        <input type="hidden" asp-for="MaNhanVien" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <h6 class="text-cam fw-bold">Thông tin nhân viên</h6>
        <div class="row g-3 mb-4">
            <div class="col-md-6"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label"></label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="MaKhuVucPhuTrach" class="form-label"></label><select asp-for="MaKhuVucPhuTrach" asp-items="ViewBag.DsKhuVuc" class="form-select"><option value="">-- Không phân khu vực --</option></select></div>
            <div class="col-md-6"><label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="SanSang">Sẵn sàng</option>
                    <option value="TamNghi">Tạm nghỉ</option>
                    <option value="NgungHoatDong">Ngừng hoạt động</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger nho"></span>
            </div>
        </div>
        <h6 class="text-cam fw-bold">Tài khoản đăng nhập (vai trò Nhân viên giao hàng)</h6>
        @if (Model.CoTaiKhoan)
        {
            <div class="alert alert-light border nho">Tài khoản đăng nhập: <code>@Model.TenDangNhap</code></div>
        }
        else if (laTao)
        {
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="TenDangNhap" class="form-label"></label><input asp-for="TenDangNhap" class="form-control" placeholder="VD: nv09" /><span asp-validation-for="TenDangNhap" class="text-danger nho"></span></div>
                <div class="col-md-6"><label asp-for="MatKhau" class="form-label"></label><input asp-for="MatKhau" class="form-control" /><span asp-validation-for="MatKhau" class="text-danger nho"></span></div>
            </div>
        }
        <div class="d-flex gap-2 mt-4"><button class="btn btn-cam px-4">Lưu</button><a asp-action="@(laTao ? "Index" : "ChiTiet")" asp-route-id="@(laTao ? null : Model.MaNhanVien)" class="btn btn-light">Hủy</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
