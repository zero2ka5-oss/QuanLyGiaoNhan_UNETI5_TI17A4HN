@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Trang lỗi chung (404 không tìm thấy / 500 lỗi hệ thống) – dùng cho UseStatusCodePagesWithReExecute
                       và UseExceptionHandler; nút quay về theo trạng thái đăng nhập. *@
@{
    int ma = ViewBag.Ma ?? 500;
    bool khongThay = ma == 404;
    ViewData["Title"] = khongThay ? "Không tìm thấy" : "Có lỗi xảy ra";
}
<section class="container loi-trang">
    <div class="loi-so">@ma</div>
    <div class="tc-trong-icon @(khongThay ? "" : "loi")"><i class="bi @(khongThay ? "bi-signpost-split" : "bi-tools")"></i></div>
    <h1 class="h3 fw-bold mb-2">@(khongThay ? "Không tìm thấy trang hoặc dữ liệu" : "Đã có lỗi xảy ra")</h1>
    @if (khongThay)
    {
        <p class="mo mb-4">Đường dẫn không tồn tại hoặc dữ liệu không thuộc quyền xem của bạn.</p>
    }
    else
    {
        <p class="mo mb-4">Vui lòng thử lại sau. Mã yêu cầu: <code>@ViewBag.MaYeuCau</code></p>
    }
    <div class="d-flex justify-content-center flex-wrap gap-2">
        @if (Context.Session.DaDangNhap())
        {
            <a class="btn btn-cam rounded-pill px-4" asp-controller="DangNhap" asp-action="TrangLamViec"><i class="bi bi-grid"></i> Về trang làm việc</a>
        }
        else
        {
            <a class="btn btn-cam rounded-pill px-4" asp-controller="TrangChu" asp-action="Index"><i class="bi bi-house"></i> Về trang chủ</a>
        }
        <a class="btn btn-light rounded-pill px-4" asp-controller="TrangChu" asp-action="TraCuu"><i class="bi bi-search"></i> Tra cứu đơn</a>
    </div>
</section>
