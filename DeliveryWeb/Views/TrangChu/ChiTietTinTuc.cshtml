@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Trang chi tiết một bài tin tức: dải đầu (chuyên mục, tiêu đề, ngày, người đăng, thời gian đọc),
                       ảnh bìa, nội dung, khối tra cứu đơn, bài liên quan. *@
@model TinTuc
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.TieuDe;
    var tinKhac = (List<TinTuc>)ViewBag.TinKhac;
}
<section class="tc-dau tt-dau tt-dau-bai">
    <div class="container position-relative tt-hep">
        @if (ViewBag.XemTruoc == true)
        {
            <div class="alert alert-warning nho text-start"><i class="bi bi-eye-slash"></i> Bản xem trước – bài viết này chưa hiển thị trên trang công khai.
                <a asp-controller="QuanTriTinTuc" asp-action="ChinhSua" asp-route-id="@Model.MaTinTuc" class="fw-semibold">Sửa bài</a></div>
        }
        <div class="tt-duong-dan">
            <a asp-action="TinTuc" class="nut-quay-lai tt-quay-lai" title="Quay lại tin tức" aria-label="Quay lại tin tức"><i class="bi bi-arrow-left"></i></a>
            <a asp-action="Index">Trang chủ</a><i class="bi bi-chevron-right"></i><a asp-action="TinTuc">Tin tức</a><i class="bi bi-chevron-right"></i>
            <a asp-action="TinTuc" asp-route-chuyenMuc="@Model.ChuyenMuc">@Model.ChuyenMuc.TenChuyenMuc()</a>
        </div>
        <h1 class="tt-tieu-de-bai">@Model.TieuDe</h1>
        <div class="tt-thong-tin">
            <span><i class="bi bi-person-circle"></i> @(Model.NguoiDang ?? "GiaoNhanh")</span>
            <span><i class="bi bi-calendar3"></i> @DinhDang.Ngay(Model.NgayDang)</span>
            <span><i class="bi bi-clock"></i> @ViewBag.PhutDoc phút đọc</span>
        </div>
    </div>
</section>

<div class="container tt-hep tt-than-bai">
    <article class="tt-bai">
        @if (!string.IsNullOrEmpty(Model.AnhBia))
        {
            <img src="@Model.AnhBia" alt="@Model.TieuDe" class="tt-anh-bia" />
        }
        else
        {
            <div class="the-tin-anh tt-anh-bia @Model.ChuyenMuc.LopChuyenMuc()"><i class="bi @Model.BieuTuong"></i></div>
        }
        <div class="bai-viet">
            <p class="tt-sapo">@Model.TomTat</p>
            @foreach (var (laDanhSach, dong) in TinTucXuLy.TachDoan(Model.NoiDung))
            {
                if (laDanhSach) { <ul>@foreach (var g in dong) { <li>@g</li> }</ul> }
                else { <p>@dong[0]</p> }
            }
        </div>
        <div class="tt-cta">
            <span class="xt-icon cam" style="width:48px;height:48px;font-size:1.3rem"><i class="bi bi-geo-alt-fill"></i></span>
            <div class="flex-grow-1"><div class="fw-bold">Theo dõi đơn hàng của bạn</div><div class="nho mo">Chỉ cần mã đơn và số điện thoại người nhận</div></div>
            <a asp-action="TraCuu" class="btn btn-cam rounded-pill px-4 text-nowrap">Tra cứu đơn</a>
        </div>
    </article>
</div>

@if (tinKhac.Count > 0)
{
    <section class="tt-lien-quan">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-3">
                <h2 class="tt-muc mb-0">Bài viết liên quan</h2>
                <a asp-action="TinTuc" class="btn btn-cam btn-sm rounded-pill px-3">Xem tất cả</a>
            </div>
            <div class="row g-4">
                @foreach (var t in tinKhac) { <div class="col-md-4"><partial name="_TheTinTuc" model="t" /></div> }
            </div>
        </div>
    </section>
}
