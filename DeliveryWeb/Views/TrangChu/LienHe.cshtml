@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Trang liên hệ công khai: dải đầu trang, các kênh liên hệ (tổng đài, email, văn phòng),
                       giờ làm việc, lối tắt hỗ trợ nhanh (tra cứu đơn, câu hỏi thường gặp, tạo đơn). *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Liên hệ";
    bool dangMo = DateTime.Now.Hour is >= 7 and < 21;
}
<section class="tc-dau tt-dau">
    <div class="container position-relative">
        <span class="xt-chao tc-nhan"><i class="bi bi-headset"></i> Hỗ trợ khách hàng</span>
        <h1 class="tc-tieu-de">Liên hệ GiaoNhanh</h1>
        <p class="tc-mo-ta">Chúng tôi luôn sẵn sàng hỗ trợ bạn mỗi ngày</p>
        <div class="lh-trang-thai @(dangMo ? "mo" : "dong")"><span></span>@(dangMo ? "Tổng đài đang hoạt động" : "Ngoài giờ làm việc – tổng đài mở lại lúc 7:00")</div>
    </div>
</section>

<div class="container tt-than lh-than">
    <div class="row g-4 lh-kenh">
        <div class="col-md-4">
            <a href="tel:19001515" class="lh-the">
                <span class="lh-icon cam"><i class="bi bi-telephone-fill"></i></span>
                <div class="lh-nhan">Tổng đài</div>
                <div class="lh-gia-tri">1900 1515</div>
                <div class="nho mo">7:00 – 21:00 tất cả các ngày</div>
                <span class="lh-hanh-dong">Gọi ngay <i class="bi bi-arrow-right"></i></span>
            </a>
        </div>
        <div class="col-md-4">
            <a href="mailto:hotro@giaonhan.vn" class="lh-the">
                <span class="lh-icon xanh"><i class="bi bi-envelope-fill"></i></span>
                <div class="lh-nhan">Email hỗ trợ</div>
                <div class="lh-gia-tri">hotro@giaonhan.vn</div>
                <div class="nho mo">Phản hồi trong vòng 24 giờ</div>
                <span class="lh-hanh-dong">Gửi email <i class="bi bi-arrow-right"></i></span>
            </a>
        </div>
        <div class="col-md-4">
            <div class="lh-the">
                <span class="lh-icon luc"><i class="bi bi-geo-alt-fill"></i></span>
                <div class="lh-nhan">Văn phòng</div>
                <div class="lh-gia-tri">218 Lĩnh Nam, Hoàng Mai</div>
                <div class="nho mo">Hà Nội · Nhận hàng gửi trực tiếp</div>
                <span class="lh-hanh-dong mo">Thứ 2 – Chủ nhật</span>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-7">
            <div class="the-mem p-4 h-100">
                <h2 class="tt-muc"><i class="bi bi-lightning-charge-fill text-cam"></i> Hỗ trợ nhanh</h2>
                <div class="lh-loi-tat">
                    <a asp-action="TraCuu"><span class="lh-icon cam"><i class="bi bi-search"></i></span><div><b>Tra cứu đơn hàng</b><small>Xem đơn đang ở đâu bằng mã đơn và số điện thoại</small></div><i class="bi bi-chevron-right"></i></a>
                    <a href="/#cau-hoi"><span class="lh-icon xanh"><i class="bi bi-question-circle"></i></span><div><b>Câu hỏi thường gặp</b><small>Phí vận chuyển, thu hộ, giao lại, sửa / hủy đơn</small></div><i class="bi bi-chevron-right"></i></a>
                    <a href="/#bang-gia"><span class="lh-icon vang"><i class="bi bi-calculator"></i></span><div><b>Bảng giá & ước tính phí</b><small>Phí theo khu vực, khối lượng và loại hàng</small></div><i class="bi bi-chevron-right"></i></a>
                    <a asp-controller="DangNhap" asp-action="DangKy"><span class="lh-icon luc"><i class="bi bi-person-plus"></i></span><div><b>Mở tài khoản gửi hàng</b><small>Miễn phí, tạo đơn ngay sau khi đăng ký</small></div><i class="bi bi-chevron-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="lh-gio h-100">
                <h2 class="tt-muc text-white"><i class="bi bi-clock-history"></i> Giờ làm việc</h2>
                @foreach (var (ngay, gio) in new[] { ("Thứ 2 – Thứ 6", "7:00 – 21:00"), ("Thứ 7", "7:00 – 21:00"), ("Chủ nhật", "7:00 – 21:00") })
                {
                    <div class="lh-dong-gio"><span>@ngay</span><b>@gio</b></div>
                }
                <div class="lh-ghi"><i class="bi bi-truck"></i> Lấy hàng tận nơi trong ngày</div>
            </div>
        </div>
    </div>
</div>
