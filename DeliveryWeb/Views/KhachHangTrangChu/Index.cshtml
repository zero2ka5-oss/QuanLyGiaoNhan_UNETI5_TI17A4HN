@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 2 - Trang tổng quan của khách hàng: lời chào + lối tắt, số liệu đơn, đơn đang vận chuyển
                       (thanh tiến độ), đơn gần đây, thống kê theo trạng thái, phí vận chuyển 6 tháng gần nhất. *@
@model TongQuanKhachHangVM
@{
    ViewData["Title"] = "Tổng quan";
    var kh = Model.KhachHang;
    string buoi = DateTime.Now.Hour switch { < 11 => "Chào buổi sáng", < 14 => "Chào buổi trưa", < 18 => "Chào buổi chiều", _ => "Chào buổi tối" };
    (TrangThaiDon[] Nhom, string Ten, string Mau)[] nhomTrangThai =
    [
        ([TrangThaiDon.ChoPhanCong, TrangThaiDon.DaPhanCong], "Chờ lấy hàng", "#F59E0B"),
        ([TrangThaiDon.DaNhanHang, TrangThaiDon.DangGiao], "Đang vận chuyển", "#6366F1"),
        ([TrangThaiDon.GiaoThanhCong, TrangThaiDon.HoanTat], "Đã giao", "#16A34A"),
        ([TrangThaiDon.GiaoKhongThanhCong], "Chờ giao lại", "#DC2626"),
        ([TrangThaiDon.DaHuy], "Đã hủy", "#9CA3AF")
    ];
    decimal phiCaoNhat = Math.Max(1, Model.TheoThang.Max(t => t.Phi));
}

@* ---------- Lời chào + lối tắt ---------- *@
<div class="kh-chao mb-4">
    <div class="kh-chao-noi-dung">
        <div class="kh-chao-ngay"><i class="bi bi-calendar3"></i> @DateTime.Today.ToString("dddd, dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</div>
        <h2 class="kh-chao-ten">@buoi, @kh.HoTen!</h2>
        <div class="kh-chao-dia-chi"><i class="bi bi-geo-alt-fill"></i> Lấy hàng tại: @kh.DiaChi</div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a asp-controller="KhachHangDonHang" asp-action="TaoMoi" class="btn btn-light btn-lg kh-nut-trang"><i class="bi bi-plus-circle"></i> Tạo đơn mới</a>
            <a asp-controller="KhachHangTienIch" asp-action="TraCuu" class="btn btn-lg kh-nut-vien"><i class="bi bi-search"></i> Tra cứu đơn</a>
        </div>
    </div>
    <div class="kh-chao-hinh d-none d-md-block" aria-hidden="true">
        <span class="kh-hop kh-hop-1"><i class="bi bi-box-seam"></i></span>
        <span class="kh-hop kh-hop-2"><i class="bi bi-truck"></i></span>
        <span class="kh-hop kh-hop-3"><i class="bi bi-geo-alt-fill"></i></span>
    </div>
</div>

<div class="kh-loi-tat mb-4">
    <a asp-controller="KhachHangDonHang" asp-action="TaoMoi"><span class="lh-icon cam"><i class="bi bi-plus-lg"></i></span><b>Tạo đơn</b><small>Gửi hàng ngay</small></a>
    <a asp-controller="KhachHangDonHang" asp-action="Index"><span class="lh-icon xanh"><i class="bi bi-box-seam"></i></span><b>Đơn của tôi</b><small>@Model.TongDon đơn</small></a>
    <a asp-controller="KhachHangTienIch" asp-action="BangGia"><span class="lh-icon vang"><i class="bi bi-calculator"></i></span><b>Ước lượng phí</b><small>Biết trước chi phí</small></a>
    <a asp-controller="KhachHangTienIch" asp-action="TraCuu"><span class="lh-icon luc"><i class="bi bi-geo-alt"></i></span><b>Tra cứu đơn</b><small>Theo dõi hành trình</small></a>
</div>

@* ---------- Số liệu ---------- *@
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Tổng số đơn</div><div class="gia-tri">@Model.TongDon</div></div><div class="icon icon-cam"><i class="bi bi-box-seam"></i></div></div></div>
    <div class="col-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Đang xử lý</div><div class="gia-tri">@Model.DangXuLy</div></div><div class="icon icon-xanh"><i class="bi bi-truck"></i></div></div></div>
    <div class="col-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Đã giao thành công</div><div class="gia-tri">@Model.DaGiao</div></div><div class="icon icon-luc"><i class="bi bi-check2-circle"></i></div></div></div>
    <div class="col-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Tổng phí vận chuyển</div><div class="gia-tri fs-5">@DinhDang.Tien(Model.TongPhi)</div></div><div class="icon icon-vang"><i class="bi bi-wallet2"></i></div></div></div>
</div>

@if (Model.ThatBai > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4"><i class="bi bi-exclamation-triangle-fill"></i>
        Có @Model.ThatBai đơn giao không thành công đang chờ điều phối giao lại.
        <a asp-controller="KhachHangDonHang" asp-action="Index" asp-route-TrangThai="GiaoKhongThanhCong" class="ms-auto fw-semibold">Xem</a></div>
}

<div class="row g-4">
    <div class="col-xl-8">
        @* ---------- Đơn đang vận chuyển ---------- *@
        <div class="the-mem p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h6 fw-bold mb-0"><i class="bi bi-truck text-cam"></i> Đơn đang vận chuyển</h3>
                <span class="tt tt-dang">@Model.DonDangVanChuyen.Count đơn</span>
            </div>
            @if (Model.DonDangVanChuyen.Count == 0)
            {
                <div class="kh-trong"><i class="bi bi-cup-hot"></i><div><b>Không có đơn nào đang vận chuyển</b><small>Tạo đơn mới để bắt đầu gửi hàng</small></div>
                    <a asp-controller="KhachHangDonHang" asp-action="TaoMoi" class="btn btn-cam btn-sm rounded-pill px-3 ms-auto">Tạo đơn</a></div>
            }
            @foreach (var d in Model.DonDangVanChuyen)
            {
                <a asp-controller="KhachHangDonHang" asp-action="ChiTiet" asp-route-id="@d.MaDon" class="kh-don-di">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="min-w-0">
                            <div class="fw-bold">@d.MaHienThi <span class="mo fw-normal">· @d.TenNguoiNhan</span></div>
                            <div class="nho mo text-truncate"><i class="bi bi-geo-alt"></i> @d.KhuVuc?.TenKhuVuc · Giao dự kiến @DinhDang.Ngay(d.NgayGiaoDuKien)</div>
                        </div>
                        <span class="tt @d.TrangThai.LopBadge() flex-none"><i class="bi @d.TrangThai.BieuTuong()"></i> @d.TrangThai.TenHienThi()</span>
                    </div>
                    <partial name="_TienDoNgan" model="d.TrangThai" />
                    <div class="kh-tien-do-nhan"><span>Tạo đơn</span><span>Lấy hàng</span><span>Đang giao</span><span>Đã giao</span></div>
                </a>
            }
        </div>

        @* ---------- Đơn gần đây ---------- *@
        <div class="the-mem">
            <div class="p-4 pb-2 d-flex justify-content-between align-items-center">
                <h3 class="h6 fw-bold mb-0"><i class="bi bi-clock-history text-cam"></i> Đơn gần đây</h3>
                <a asp-controller="KhachHangDonHang" asp-action="Index" class="btn btn-cam btn-sm rounded-pill px-3">Xem tất cả</a>
            </div>
            <div class="px-2 pb-2">
                @foreach (var d in Model.DonGanDay)
                {
                    <a asp-controller="KhachHangDonHang" asp-action="ChiTiet" asp-route-id="@d.MaDon" class="kh-dong-don">
                        <span class="kh-dong-icon @d.TrangThai.LopBadge()"><i class="bi @d.TrangThai.BieuTuong()"></i></span>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold text-truncate">@d.MaHienThi · @d.TenNguoiNhan</div>
                            <div class="nho mo text-truncate">@d.KhuVuc?.TenKhuVuc · @DinhDang.KhoiLuong(d.KhoiLuong) · @DinhDang.ThoiGianTuongDoi(d.NgayTao)</div>
                        </div>
                        <div class="text-end flex-none">
                            <span class="tt @d.TrangThai.LopBadge()">@d.TrangThai.TenHienThi()</span>
                            <div class="fw-bold mt-1">@DinhDang.Tien(d.PhiVanChuyen)</div>
                        </div>
                    </a>
                }
                @if (Model.DonGanDay.Count == 0) { <div class="o-trong"><i class="bi bi-box"></i>Bạn chưa có đơn nào. <a asp-controller="KhachHangDonHang" asp-action="TaoMoi">Tạo đơn đầu tiên</a></div> }
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        @* ---------- Đơn theo trạng thái ---------- *@
        <div class="the-mem p-4 mb-4">
            <h3 class="h6 fw-bold mb-3"><i class="bi bi-pie-chart text-cam"></i> Đơn theo trạng thái</h3>
            <div class="kh-thanh-tong">
                @foreach (var (nhom, ten, mau) in nhomTrangThai)
                {
                    int so = nhom.Sum(t => Model.SoTheoTrangThai.GetValueOrDefault(t));
                    if (so > 0 && Model.TongDon > 0) { <span style="width:@((so * 100.0 / Model.TongDon).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@mau" title="@ten: @so"></span> }
                }
            </div>
            @foreach (var (nhom, ten, mau) in nhomTrangThai)
            {
                int so = nhom.Sum(t => Model.SoTheoTrangThai.GetValueOrDefault(t));
                <div class="kh-chu-giai"><span class="cham-mau" style="background:@mau"></span><span class="flex-grow-1">@ten</span><b>@so</b></div>
            }
        </div>

        @* ---------- Phí 6 tháng ---------- *@
        <div class="the-mem p-4">
            <h3 class="h6 fw-bold mb-3"><i class="bi bi-bar-chart text-cam"></i> Phí vận chuyển 6 tháng</h3>
            <div class="bieu-do-cot">
                @for (int i = 0; i < Model.TheoThang.Count; i++)
                {
                    var t = Model.TheoThang[i];
                    int cao = (int)Math.Round(t.Phi / phiCaoNhat * 100);
                    <div class="cot" title="@t.Thang: @DinhDang.Tien(t.Phi) – @t.SoDon đơn">
                        <div class="gia">@(t.Phi > 0 ? (t.Phi / 1000).ToString("0") + "k" : "")</div>
                        <div class="vung"><div class="than-cot @(i == Model.TheoThang.Count - 1 ? "hien-tai" : "")" style="height:@(Math.Max(cao, 3))%"></div></div>
                        <div class="nhan">@t.Thang</div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
