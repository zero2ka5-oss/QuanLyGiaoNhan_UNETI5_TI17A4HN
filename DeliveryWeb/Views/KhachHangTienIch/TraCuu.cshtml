@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Cổng khách hàng - Tra cứu đơn theo mã + số điện thoại người nhận ngay trong trang khách hàng;
                       lối tắt các đơn đang vận chuyển của chính khách hàng. *@
@model DonGiaoHang?
@{
    ViewData["Title"] = "Tra cứu đơn hàng";
    var donCuaToi = (List<DonGiaoHang>)ViewBag.DonCuaToi;
    bool daTraCuu = !string.IsNullOrWhiteSpace(ViewBag.Ma as string) || !string.IsNullOrWhiteSpace(ViewBag.Sdt as string);
}
<div class="kh-dau-trang mb-4">
    <div class="flex-grow-1">
        <h2 class="h4 fw-bold mb-1">Theo dõi hành trình đơn hàng</h2>
        <p class="mb-3">Tra cứu cả đơn người khác gửi cho bạn bằng mã đơn và số điện thoại người nhận</p>
        <form method="get" class="tc-hop kh-tim">
            <div class="o-nhap flex-grow-1"><i class="bi bi-upc-scan"></i><input name="ma" value="@ViewBag.Ma" class="form-control" placeholder="Mã đơn, vd: DH000012" autocomplete="off" required /></div>
            <div class="o-nhap flex-grow-1"><i class="bi bi-telephone"></i><input name="sdt" value="@ViewBag.Sdt" class="form-control" placeholder="Số điện thoại người nhận" inputmode="tel" required /></div>
            <button class="btn btn-cam xt-nut px-4"><i class="bi bi-search"></i> Tra cứu</button>
        </form>
    </div>
</div>

@if (Model is not null)
{
    <partial name="_KetQuaTraCuu" model="Model" />
}
else
{
    @if (daTraCuu)
    {
        <div class="tc-trong pt-2">
            <div class="tc-trong-icon loi"><i class="bi bi-search"></i></div>
            <h2 class="h5 fw-bold mb-1">Không tìm thấy đơn hàng</h2>
            <p class="mo mb-0">@(ViewBag.Loi ?? "Kiểm tra lại mã đơn và số điện thoại người nhận")</p>
        </div>
    }
    <div class="the-mem p-4 mt-2">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h6 fw-bold mb-0"><i class="bi bi-truck text-cam"></i> Đơn của bạn đang vận chuyển</h2>
            <a asp-controller="KhachHangDonHang" asp-action="Index" class="btn btn-cam btn-sm rounded-pill px-3">Tất cả đơn</a>
        </div>
        @if (donCuaToi.Count == 0)
        {
            <div class="text-center mo py-3">Hiện không có đơn nào đang vận chuyển</div>
        }
        else
        {
            <div class="kh-chip-don">
                @foreach (var d in donCuaToi)
                {
                    <a asp-action="TraCuu" asp-route-ma="@d.MaHienThi" asp-route-sdt="@d.SoDienThoaiNguoiNhan">
                        <span class="kh-chip-icon @d.TrangThai.LopBadge()"><i class="bi @d.TrangThai.BieuTuong()"></i></span>
                        <span class="min-w-0"><b>@d.MaHienThi</b><small class="text-truncate d-block">@d.TrangThai.TenHienThi() · @d.TenNguoiNhan</small></span>
                    </a>
                }
            </div>
        }
    </div>
}
