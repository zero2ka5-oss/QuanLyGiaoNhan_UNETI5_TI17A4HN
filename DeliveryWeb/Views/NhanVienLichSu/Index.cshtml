@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 4 - Lịch sử công việc của nhân viên giao hàng (các phân công đã kết thúc), tổng tiền cước đã giao. *@
@model DanhSachTrang<PhanCongGiaoHang>
@{ ViewData["Title"] = "Lịch sử công việc"; KetQuaGiao? loc = ViewBag.KetQua; }
<div class="the-tien-nho mb-2">
    <span class="rounded-3 d-grid" style="width:40px;height:40px;place-items:center;background:rgba(255,255,255,.12)"><i class="bi bi-cash-stack fs-5"></i></span>
    <div class="flex-grow-1 lh-sm">
        <div class="nho" style="opacity:.8">Tổng tiền ship đã giao</div>
        <div class="so-tien">@DinhDang.Tien((decimal)ViewBag.TongTien)</div>
    </div>
    <div class="text-end lh-sm nho"><div style="opacity:.8">Khối lượng</div><div class="fw-bold">@DinhDang.KhoiLuong((decimal)ViewBag.TongKhoiLuong)</div></div>
</div>
<div class="row g-2 mb-3">
    <div class="col-6"><div class="kpi text-center p-2"><div class="nhan">Thành công</div><div class="gia-tri text-success">@ViewBag.TongThanhCong</div></div></div>
    <div class="col-6"><div class="kpi text-center p-2"><div class="nhan">Không thành công</div><div class="gia-tri text-danger">@ViewBag.TongThatBai</div></div></div>
</div>
<div class="tab-trang-thai mb-3">
    <a class="@(loc is null ? "active" : "")" asp-action="Index">Tất cả</a>
    <a class="@(loc == KetQuaGiao.GiaoThanhCong ? "active" : "")" asp-action="Index" asp-route-ketQua="GiaoThanhCong">Thành công</a>
    <a class="@(loc == KetQuaGiao.GiaoKhongThanhCong ? "active" : "")" asp-action="Index" asp-route-ketQua="GiaoKhongThanhCong">Không thành công</a>
</div>
@foreach (var p in Model.DanhSach)
{
    <a asp-controller="NhanVienCongViec" asp-action="ChiTiet" asp-route-id="@p.MaPhanCong" class="the-don d-block text-reset">
        <div class="d-flex justify-content-between">
            <span class="ma">@p.DonGiaoHang?.MaHienThi</span>
            @if (p.KetQua.HasValue)
            {
                <span class="tt @(p.KetQua == KetQuaGiao.GiaoThanhCong ? "tt-thanhcong" : p.KetQua == KetQuaGiao.GiaoKhongThanhCong ? "tt-thatbai" : "tt-huy")">@p.KetQua.Value.TenHienThi()</span>
            }
            else { <span class="tt @p.TrangThai.LopBadge()">@p.TrangThai.TenHienThi()</span> }
        </div>
        <div class="nho">@p.DonGiaoHang?.TenNguoiNhan · @p.DonGiaoHang?.KhuVuc?.TenKhuVuc</div>
        <div class="d-flex justify-content-between align-items-end">
            <div class="nho mo">Kết thúc @DinhDang.NgayGio(p.NgayKetThuc) · @p.PhuongTien?.BienSo</div>
            <div class="fw-bold text-nowrap ms-2 @(p.KetQua == KetQuaGiao.GiaoThanhCong ? "text-success" : "mo text-decoration-line-through")">@DinhDang.Tien(p.DonGiaoHang?.PhiVanChuyen ?? 0)</div>
        </div>
        @if (p.LyDoThatBai.HasValue) { <div class="nho text-danger">@p.LyDoThatBai.Value.TenHienThi() @(string.IsNullOrEmpty(p.GhiChu) ? "" : "– " + p.GhiChu)</div> }
    </a>
}
@if (Model.TongSoDong == 0) { <div class="the-don text-center mo py-4">Chưa có công việc đã hoàn thành.</div> }
<partial name="_PhanTrang" model="Model" />
