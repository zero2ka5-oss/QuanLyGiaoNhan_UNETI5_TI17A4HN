@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 2 + 4 + 5 - [Quản trị / Điều phối] Chi tiết đơn: thẻ trạng thái + thanh hành trình 5 bước, thông tin, thành phần phí, phân công hiện tại
                       và toàn bộ lịch sử phân công, lịch sử giao nhận; nút nghiệp vụ hiển thị theo trạng thái + quyền. *@
@model ChiTietDonVM
@{
    var d = Model.Don;
    ViewData["Title"] = "Đơn " + d.MaHienThi;
    var pc = Model.PhanCongHienTai;
}

<div class="tc-trang-thai @d.TrangThai.LopTheTrangThai() mb-4">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <span class="tc-icon-lon"><i class="bi @d.TrangThai.BieuTuong()"></i></span>
        <div class="flex-grow-1 min-w-0">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="ct-ma">@d.MaHienThi</span>
                <button type="button" class="ct-chep" data-chep="@d.MaHienThi" title="Sao chép mã đơn"><i class="bi bi-copy"></i></button>
            </div>
            <div class="tc-ten-trang-thai">@d.TrangThai.TenHienThi()</div>
            <div class="nho mo">Tạo lúc @DinhDang.NgayGio(d.NgayTao)@if (d.NgayHoanTat.HasValue) { <span> · Hoàn tất @DinhDang.NgayGio(d.NgayHoanTat)</span> }</div>
        </div>
        <div class="tc-ngay">
            <small>Giao dự kiến</small>
            <b>@d.NgayGiaoDuKien.ToString("dd/MM")</b>
            <small>@d.NgayGiaoDuKien.ToString("yyyy")</small>
        </div>
    </div>

    <partial name="_HanhTrinhDon" model="d" />

    <div class="ct-chan">
        <span><i class="bi bi-person"></i> @d.KhachHang?.HoTen · @DinhDang.Tien(d.PhiVanChuyen)</span>
        <div class="d-flex gap-2 flex-wrap ms-auto">
            @if (Model.CoThePhanCong)
            {
                <a asp-controller="QuanTriPhanCong" asp-action="TaoMoi" asp-route-maDon="@d.MaDon" class="btn btn-cam btn-sm rounded-pill px-3">
                    <i class="bi bi-person-plus"></i> @(d.TrangThai == TrangThaiDon.GiaoKhongThanhCong ? "Phân công giao lại" : "Phân công")</a>
            }
            @if (Model.CoTheDoiPhanCong)
            {
                <a asp-controller="QuanTriPhanCong" asp-action="DoiPhanCong" asp-route-maDon="@d.MaDon" class="btn btn-outline-primary btn-sm rounded-pill px-3"><i class="bi bi-arrow-left-right"></i> Đổi phân công</a>
            }
            @if (Model.CoTheHoanTat)
            {
                <form asp-action="HoanTat" asp-route-id="@d.MaDon" method="post" data-xac-nhan="Xác nhận shipper đã nộp @DinhDang.Tien(d.TongThuNguoiNhan) và hoàn tất đơn @d.MaHienThi?">
                    <button class="btn btn-success btn-sm rounded-pill px-3"><i class="bi bi-patch-check"></i> Đối soát & hoàn tất</button>
                </form>
            }
            @if (Model.CoTheSua)
            {
                <a asp-action="ChinhSua" asp-route-id="@d.MaDon" class="btn btn-light btn-sm rounded-pill px-3"><i class="bi bi-pencil"></i> Sửa đơn</a>
            }
            @if (Model.CoTheHuy)
            {
                <button class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#hopHuy"><i class="bi bi-x-circle"></i> Hủy đơn</button>
            }
        </div>
    </div>
</div>

@if (d.TrangThai == TrangThaiDon.GiaoKhongThanhCong && DonHangXuLy.SoLanThatBai(d) >= DonHangXuLy.SoLanGiaoToiDa)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-octagon"></i> Đơn đã giao không thành công <b>@DonHangXuLy.SoLanGiaoToiDa lần</b> – không giao lại nữa. Hãy liên hệ khách hàng và <b>hủy / chuyển hoàn</b> đơn.</div>
}
else if (d.TrangThai == TrangThaiDon.GiaoKhongThanhCong)
{
    <div class="alert alert-warning"><i class="bi bi-arrow-repeat"></i> Đã giao không thành công @DonHangXuLy.SoLanThatBai(d) / @DonHangXuLy.SoLanGiaoToiDa lần – có thể phân công giao lại.</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="the-mem p-4 mb-3">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="text-cam fw-bold mb-2"><i class="bi bi-person-up"></i> Người gửi (khách hàng)</div>
                    <div class="fw-semibold">@d.KhachHang?.HoTen</div>
                    <div class="nho">@DinhDang.SoDienThoai(d.KhachHang?.SoDienThoai)</div>
                    <div class="nho mo">@d.KhachHang?.DiaChi</div>
                </div>
                <div class="col-md-6">
                    <div class="text-cam fw-bold mb-2"><i class="bi bi-person-down"></i> Người nhận</div>
                    <div class="fw-semibold">@d.TenNguoiNhan</div>
                    <div class="nho"><a href="tel:@d.SoDienThoaiNguoiNhan">@DinhDang.SoDienThoai(d.SoDienThoaiNguoiNhan)</a></div>
                    <div class="nho mo">@d.DiaChiNhan</div>
                </div>
            </div>
            <hr>
            <div class="row g-3 nho">
                <div class="col-sm-4"><div class="mo">Loại hàng</div><b>@d.LoaiHang?.TenLoaiHang</b></div>
                <div class="col-sm-4"><div class="mo">Khu vực giao</div><b>@d.KhuVuc?.TenKhuVuc</b></div>
                <div class="col-sm-4"><div class="mo">Khối lượng</div><b>@DinhDang.KhoiLuong(d.KhoiLuong)</b></div>
                @if (!string.IsNullOrEmpty(d.GhiChu)) { <div class="col-12"><div class="mo">Ghi chú</div>@d.GhiChu</div> }
            </div>
        </div>

        <div class="the-mem p-4 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-diagram-3 text-cam"></i> Phân công giao hàng</h6>
                <span class="nho mo">@Model.DsPhanCong.Count lần phân công</span>
            </div>
            @if (pc is not null)
            {
                <div class="border rounded-3 p-3 mb-3 bg-cam-nhat">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <div class="nho mo">Đang thực hiện</div>
                            <div class="fw-bold"><i class="bi bi-person-badge"></i> @pc.NhanVien?.HoTen
                                <a href="tel:@pc.NhanVien?.SoDienThoai" class="nho ms-1">@DinhDang.SoDienThoai(pc.NhanVien?.SoDienThoai)</a></div>
                            <div class="nho"><i class="bi bi-truck-front"></i> @pc.PhuongTien?.LoaiPhuongTien · @pc.PhuongTien?.BienSo</div>
                        </div>
                        <span class="tt @pc.TrangThai.LopBadge() align-self-start">@pc.TrangThai.TenHienThi()</span>
                    </div>
                </div>
            }
            @if (Model.DsPhanCong.Count == 0)
            {
                <div class="mo nho">Đơn chưa được phân công.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm bang">
                        <thead><tr><th>#</th><th>Nhân viên / Xe</th><th>Thời gian</th><th>Kết quả</th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.DsPhanCong)
                        {
                            <tr>
                                <td class="mo">@p.MaPhanCong</td>
                                <td class="fw-medium">@p.NhanVien?.HoTen<div class="nho mo fw-normal">@p.PhuongTien?.BienSo</div></td>
                                <td class="nho text-nowrap lh-sm">
                                    <div><span class="mo">Phân công</span> @DinhDang.NgayGio(p.NgayPhanCong)</div>
                                    @if (p.NgayNhanHang.HasValue) { <div><span class="mo">Nhận hàng</span> @DinhDang.NgayGio(p.NgayNhanHang)</div> }
                                    @if (p.NgayKetThuc.HasValue) { <div><span class="mo">Kết thúc</span> @DinhDang.NgayGio(p.NgayKetThuc)</div> }
                                </td>
                                <td>
                                    @if (p.KetQua.HasValue)
                                    {
                                        <span class="tt @(p.KetQua == KetQuaGiao.GiaoThanhCong ? "tt-thanhcong" : p.KetQua == KetQuaGiao.GiaoKhongThanhCong ? "tt-thatbai" : "tt-huy")">@p.KetQua.Value.TenHienThi()</span>
                                        @if (p.LyDoThatBai.HasValue) { <div class="nho text-danger">@p.LyDoThatBai.Value.TenHienThi()</div> }
                                    }
                                    else { <span class="tt @p.TrangThai.LopBadge()">@p.TrangThai.TenHienThi()</span> }
                                    @if (!string.IsNullOrEmpty(p.GhiChu)) { <div class="nho mo">@p.GhiChu</div> }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="the-mem p-4 mb-3">
            <h6 class="fw-bold mb-3"><i class="bi bi-receipt text-cam"></i> Phí vận chuyển</h6>
            <partial name="_ThanhPhanPhi" model="d" />
        </div>
        @if (!string.IsNullOrEmpty(d.AnhGiaoHang))
        {
            <div class="the-mem p-4 mb-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-camera text-cam"></i> Ảnh giao hàng</h6>
                <a href="@d.AnhGiaoHang" target="_blank"><img src="@d.AnhGiaoHang" alt="Ảnh giao hàng @d.MaHienThi" class="anh-giao-hang" loading="lazy" /></a>
            </div>
        }
        <div class="the-mem p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-clock-history text-cam"></i> Lịch sử giao nhận</h6>
            <partial name="_LichSuGiaoNhan" model="Model.DsLichSu" />
        </div>
    </div>
</div>

@if (Model.CoTheHuy)
{
    <div class="modal fade" id="hopHuy" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="Huy" asp-route-id="@d.MaDon" method="post" class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Hủy đơn @d.MaHienThi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <label class="form-label" for="lyDo">Lý do hủy</label>
                    <textarea name="lyDo" id="lyDo" rows="3" class="form-control" placeholder="VD: Khách đổi ý, sai thông tin người nhận..."></textarea>
                    @if (pc is not null) { <div class="alert alert-warning nho mt-3 mb-0">Phân công hiện tại của @pc.NhanVien?.HoTen sẽ được kết thúc.</div> }
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button><button class="btn btn-danger">Xác nhận hủy</button></div>
            </form>
        </div>
    </div>
}
