@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Danh sách tin tức trang chủ – lọc theo chuyên mục / trạng thái, ẩn hiện, sửa, xóa. *@
@model DanhSachTrang<TinTuc>
@{
    ViewData["Title"] = "Tin tức";
    ChuyenMucTinTuc? locCm = ViewBag.ChuyenMuc;
    string? locTt = ViewBag.TrangThai;
    var homNay = DateTime.Today;
}
<div class="row g-3 mb-3">
    @foreach (var (ma, ten, so, icon, mau) in new[] { ("hien", "Đang hiển thị", (int)ViewBag.SoDangHien, "bi-eye", "icon-luc"), ("hen", "Hẹn ngày đăng", (int)ViewBag.SoHenDang, "bi-calendar-event", "icon-xanh"), ("an", "Đã ẩn", (int)ViewBag.SoDaAn, "bi-eye-slash", "icon-xam-nhat") })
    {
        <div class="col-4">
            <a asp-action="Index" asp-route-trangThai="@(locTt == ma ? null : ma)" class="kpi d-flex justify-content-between text-reset @(locTt == ma ? "kpi-chon" : "")">
                <div><div class="nhan">@ten</div><div class="gia-tri">@so</div></div><div class="icon @mau d-none d-sm-grid"><i class="bi @icon"></i></div>
            </a>
        </div>
    }
</div>
<form method="get" class="thanh-loc mb-3" id="boLoc">
    <input type="hidden" name="trangThai" value="@locTt" />
    <div class="row g-2 align-items-end">
        <div class="col-lg-5 col-md-6"><label class="form-label nho" for="tuKhoa">Tìm kiếm</label>
            <div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search mo"></i></span>
                <input name="tuKhoa" id="tuKhoa" value="@ViewBag.TuKhoa" class="form-control border-start-0" placeholder="Tiêu đề hoặc tóm tắt" /></div></div>
        <div class="col-lg-3 col-md-6"><label class="form-label nho" for="chuyenMuc">Chuyên mục</label>
            <select name="chuyenMuc" id="chuyenMuc" class="form-select" onchange="this.form.requestSubmit()"><option value="">Tất cả</option>
                @foreach (var cm in Enum.GetValues<ChuyenMucTinTuc>()) { <option value="@cm" selected="@(locCm == cm)">@cm.TenChuyenMuc()</option> }
            </select></div>
        <div class="col-lg-4 d-flex gap-2">
            <button class="btn btn-light" title="Lọc"><i class="bi bi-funnel"></i></button>
            <a asp-action="TaoMoi" class="btn btn-cam flex-fill"><i class="bi bi-plus-lg"></i> Đăng bài mới</a>
        </div>
    </div>
</form>
<div class="the-mem">
    <div class="table-responsive">
        <table class="table bang">
            <thead><tr><th>Bài viết</th><th>Chuyên mục</th><th>Ngày đăng</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var t in Model.DanhSach)
            {
                var (tenTt, lopTt) = !t.HienThi ? ("Đã ẩn", "tt-huy") : t.NgayDang > homNay ? ("Hẹn ngày đăng", "tt-xuly") : ("Đang hiển thị", "tt-thanhcong");
                <tr>
                    <td style="min-width:300px">
                        <div class="d-flex gap-3 align-items-center">
                            <span class="tin-icon @t.ChuyenMuc.LopChuyenMuc()"><i class="bi @t.BieuTuong"></i></span>
                            <div class="min-w-0">
                                <a asp-action="ChinhSua" asp-route-id="@t.MaTinTuc" class="ten d-block">@t.TieuDe</a>
                                <div class="nho mo tin-tom-tat">@t.TomTat</div>
                            </div>
                        </div>
                    </td>
                    <td><span class="cm-nhan @t.ChuyenMuc.LopChuyenMuc()">@t.ChuyenMuc.TenChuyenMuc()</span></td>
                    <td class="text-nowrap"><div>@DinhDang.Ngay(t.NgayDang)</div><div class="nho mo">@(t.NguoiDang ?? "—")</div></td>
                    <td><span class="tt @lopTt">@tenTt</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-controller="TrangChu" asp-action="ChiTietTinTuc" asp-route-id="@t.MaTinTuc" target="_blank" class="btn btn-sm btn-light" title="Xem trên trang"><i class="bi bi-box-arrow-up-right"></i></a>
                        <a asp-action="ChinhSua" asp-route-id="@t.MaTinTuc" class="btn btn-sm btn-light" title="Sửa"><i class="bi bi-pencil"></i></a>
                        <form asp-action="DoiHienThi" asp-route-id="@t.MaTinTuc" method="post" class="d-inline">
                            <button class="btn btn-sm btn-light" title="@(t.HienThi ? "Ẩn bài" : "Hiện bài")"><i class="bi @(t.HienThi ? "bi-eye-slash" : "bi-eye")"></i></button>
                        </form>
                        <form asp-action="Xoa" asp-route-id="@t.MaTinTuc" method="post" class="d-inline" data-xac-nhan="Xóa bài &quot;@t.TieuDe&quot;? Không thể khôi phục.">
                            <button class="btn btn-sm btn-light text-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TongSoDong == 0) { <div class="o-trong"><i class="bi bi-newspaper"></i>Không có bài viết phù hợp</div> }
</div>
<partial name="_PhanTrang" model="Model" />
