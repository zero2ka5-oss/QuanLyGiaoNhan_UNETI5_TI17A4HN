@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Form đăng / sửa tin tức – chọn chuyên mục, biểu tượng, ngày đăng, ẩn hiện; xem trước thẻ tin ngay khi nhập. *@
@model TinTuc
@{
    bool laTao = Model.MaTinTuc == 0;
    ViewData["Title"] = laTao ? "Đăng bài mới" : "Sửa bài viết";
}
<form asp-action="@(laTao ? "TaoMoi" : "ChinhSua")" method="post" id="formTin" enctype="multipart/form-data">
    <input type="hidden" asp-for="MaTinTuc" />
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="the-mem p-4">
                <div class="mb-3"><label asp-for="TieuDe" class="form-label"></label>
                    <input asp-for="TieuDe" class="form-control form-control-lg fw-semibold" maxlength="200" />
                    <span asp-validation-for="TieuDe" class="text-danger nho"></span></div>
                <div class="mb-3"><label asp-for="TomTat" class="form-label"></label>
                    <textarea asp-for="TomTat" rows="2" class="form-control" maxlength="500"></textarea>
                    <div class="d-flex justify-content-between"><span asp-validation-for="TomTat" class="text-danger nho"></span><span class="nho mo" id="demTomTat"></span></div></div>
                <div><label asp-for="NoiDung" class="form-label"></label>
                    <div class="thanh-soan">
                        <button type="button" class="btn btn-sm btn-light" id="nutGach"><i class="bi bi-list-ul"></i> Gạch đầu dòng</button>
                    </div>
                    <textarea asp-for="NoiDung" rows="14" class="form-control o-noi-dung" placeholder="Mỗi dòng là một đoạn văn"></textarea>
                    <span asp-validation-for="NoiDung" class="text-danger nho"></span></div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="the-mem p-4 mb-3">
                <label class="form-label">Ảnh bìa</label>
                <label class="o-tai-anh mb-1 @(string.IsNullOrEmpty(Model.AnhBia) ? "" : "co-anh")" id="oAnhBia">
                    <img src="@Model.AnhBia" alt="" />
                    <span class="goi-y"><i class="bi bi-image"></i>Chọn ảnh bìa</span>
                    <input type="file" name="anhBia" accept="@AnhXuLy.ChapNhan" class="d-none" />
                </label>
                <span asp-validation-for="AnhBia" class="text-danger nho d-block"></span>
                @if (!string.IsNullOrEmpty(Model.AnhBia))
                {
                    <div class="form-check nho"><input class="form-check-input" type="checkbox" name="xoaAnhBia" value="true" id="xoaAnhBia" /><label class="form-check-label" for="xoaAnhBia">Bỏ ảnh bìa</label></div>
                }
            </div>
            <div class="the-mem p-4 mb-3">
                <div class="mb-3"><label asp-for="ChuyenMuc" class="form-label"></label>
                    <select asp-for="ChuyenMuc" class="form-select">
                        @foreach (var cm in Enum.GetValues<ChuyenMucTinTuc>()) { <option value="@cm" data-lop="@cm.LopChuyenMuc()">@cm.TenChuyenMuc()</option> }
                    </select></div>
                <div class="mb-3"><label class="form-label">Biểu tượng</label>
                    <div class="chon-bieu-tuong">
                        @foreach (var bt in TinTucXuLy.DsBieuTuong)
                        {
                            <label title="@bt"><input type="radio" name="BieuTuong" value="@bt" checked="@(Model.BieuTuong == bt)" /><span><i class="bi @bt"></i></span></label>
                        }
                    </div></div>
                <div class="mb-3"><label asp-for="NgayDang" class="form-label"></label>
                    <input asp-for="NgayDang" type="date" class="form-control" />
                    <span asp-validation-for="NgayDang" class="text-danger nho"></span></div>
                <div class="form-check form-switch mb-4">
                    <input asp-for="HienThi" class="form-check-input" role="switch" />
                    <label asp-for="HienThi" class="form-check-label"></label>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-cam flex-fill"><i class="bi bi-check2"></i> @(laTao ? "Đăng bài" : "Lưu thay đổi")</button>
                    <a asp-action="Index" class="btn btn-light">Hủy</a>
                </div>
                @if (!laTao)
                {
                    <div class="nho mo mt-3">Người đăng: @(Model.NguoiDang ?? "—")@(Model.NgayCapNhat is null ? "" : " · Sửa lần cuối " + DinhDang.NgayGio(Model.NgayCapNhat))</div>
                }
            </div>
            <div class="nho fw-semibold mo mb-2">Xem trước trên trang chủ</div>
            <div class="the-tin" id="xemTruoc">
                <div class="the-tin-anh"><img alt="" /><i class="bi"></i></div>
                <div class="p-3 d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2"><span class="cm-nhan"></span><span class="nho mo"><i class="bi bi-calendar3"></i> <span class="xt-ngay"></span></span></div>
                    <h3 class="the-tin-tieu-de"></h3>
                    <p class="nho mo mb-0 xt-tom-tat"></p>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Xem trước thẻ tin theo dữ liệu đang nhập
        const f = document.getElementById('formTin'), xt = document.getElementById('xemTruoc');
        const capNhatXemTruoc = () => {
            const cm = f.ChuyenMuc.options[f.ChuyenMuc.selectedIndex];
            const bt = f.querySelector('input[name="BieuTuong"]:checked')?.value || 'bi-newspaper';
            const anh = xt.querySelector('.the-tin-anh'), nhan = xt.querySelector('.cm-nhan');
            anh.className = 'the-tin-anh ' + cm.dataset.lop; anh.querySelector('i').className = 'bi ' + bt;
            const coAnh = document.getElementById('oAnhBia').classList.contains('co-anh');
            anh.classList.toggle('co-anh', coAnh); anh.querySelector('img').src = coAnh ? document.querySelector('#oAnhBia img').src : '';
            nhan.className = 'cm-nhan ' + cm.dataset.lop; nhan.textContent = cm.text;
            xt.querySelector('.the-tin-tieu-de').textContent = f.TieuDe.value || 'Tiêu đề bài viết';
            xt.querySelector('.xt-tom-tat').textContent = f.TomTat.value || 'Tóm tắt ngắn gọn nội dung bài viết';
            const [n, t, d] = (f.NgayDang.value || '').split('-');
            xt.querySelector('.xt-ngay').textContent = d ? `${d}/${t}/${n}` : '';
            document.getElementById('demTomTat').textContent = f.TomTat.value.length + '/500';
        };
        // Ảnh bìa: xem trước ngay khi chọn tệp
        let anhMoi = null;
        const oAnh = document.getElementById('oAnhBia');
        oAnh.querySelector('input').addEventListener('change', e => {
            const tep = e.target.files[0]; if (!tep) return;
            if (anhMoi) URL.revokeObjectURL(anhMoi);
            anhMoi = URL.createObjectURL(tep);
            oAnh.querySelector('img').src = anhMoi; oAnh.classList.add('co-anh');
            const xoa = document.getElementById('xoaAnhBia'); if (xoa) xoa.checked = false;
            capNhatXemTruoc();
        });
        document.getElementById('xoaAnhBia')?.addEventListener('change', e => { oAnh.classList.toggle('co-anh', !e.target.checked); capNhatXemTruoc(); });
        f.addEventListener('input', capNhatXemTruoc); f.addEventListener('change', capNhatXemTruoc); capNhatXemTruoc();

        // Chèn "- " vào đầu các dòng đang chọn trong nội dung
        document.getElementById('nutGach').addEventListener('click', () => {
            const o = f.NoiDung, dau = o.value.lastIndexOf('\n', o.selectionStart - 1) + 1, cuoi = o.selectionEnd;
            const doan = o.value.slice(dau, cuoi).split('\n').map(d => d.startsWith('- ') ? d : '- ' + d).join('\n');
            o.setRangeText(doan, dau, cuoi, 'end'); o.focus();
        });
    </script>
}
