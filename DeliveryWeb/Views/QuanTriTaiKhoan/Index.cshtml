@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 1 - Danh sách tài khoản, lọc theo vai trò / trạng thái, khóa-mở, đặt lại mật khẩu. *@
@model DanhSachTrang<TaiKhoan>
@{
    ViewData["Title"] = "Tài khoản & phân quyền";
    var soTheoVaiTro = (Dictionary<string, int>)ViewBag.SoTheoVaiTro;
    string? vaiTroLoc = ViewBag.VaiTro;
}
<div class="row g-3 mb-3">
    @foreach (var (vt, icon, mau) in new[] { (VaiTroNguoiDung.QuanTri, "bi-shield-lock", "icon-do"), (VaiTroNguoiDung.DieuPhoi, "bi-headset", "icon-tim"),
                                            (VaiTroNguoiDung.GiaoHang, "bi-person-badge", "icon-xanh"), (VaiTroNguoiDung.KhachHang, "bi-people", "icon-cam") })
    {
        <div class="col-6 col-xl-3">
            <a class="kpi d-flex justify-content-between align-items-center text-reset" asp-route-vaiTro="@vt">
                <div><div class="nhan">@HienThi.TenVaiTro(vt)</div><div class="gia-tri">@soTheoVaiTro.GetValueOrDefault(vt)</div></div>
                <div class="icon @mau"><i class="bi @icon"></i></div>
            </a>
        </div>
    }
</div>

<form method="get" class="thanh-loc mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label nho">Tìm kiếm</label><input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tên đăng nhập, họ tên, email" /></div>
        <div class="col-md-3"><label class="form-label nho">Vai trò</label>
            <select name="vaiTro" class="form-select"><option value="">Tất cả</option>
                @foreach (var vt in VaiTroNguoiDung.TatCa) { <option value="@vt" selected="@(vaiTroLoc == vt)">@HienThi.TenVaiTro(vt)</option> }
            </select></div>
        <div class="col-md-2"><label class="form-label nho">Trạng thái</label>
            <select name="trangThai" class="form-select"><option value="">Tất cả</option>
                <option value="HoatDong" selected="@(ViewBag.TrangThai == TrangThaiTaiKhoan.HoatDong)">Hoạt động</option>
                <option value="BiKhoa" selected="@(ViewBag.TrangThai == TrangThaiTaiKhoan.BiKhoa)">Bị khóa</option>
            </select></div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-cam flex-fill"><i class="bi bi-funnel"></i> Lọc</button>
            <a asp-action="TaoMoi" class="btn btn-outline-dark flex-fill"><i class="bi bi-plus-lg"></i> Thêm</a>
        </div>
    </div>
</form>

<div class="the-mem">
    <div class="table-responsive">
        <table class="table bang">
            <thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Ngày tạo</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var tk in Model.DanhSach)
            {
                <tr>
                    <td class="fw-semibold"><code>@tk.TenDangNhap</code></td>
                    <td><div class="d-flex align-items-center gap-2">@HienThi.AnhDaiDien(tk.AnhDaiDien, tk.HoTen, "avt avt-sm")<span>@tk.HoTen</span></div></td>
                    <td class="nho">@tk.Email</td>
                    <td>@HienThi.TenVaiTro(tk.VaiTro)</td>
                    <td><span class="tt @tk.TrangThai.LopBadge()">@tk.TrangThai.TenHienThi()</span></td>
                    <td class="nho mo">@DinhDang.Ngay(tk.NgayTao)</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="ChinhSua" asp-route-id="@tk.MaTaiKhoan" class="btn btn-sm btn-light" title="Sửa"><i class="bi bi-pencil"></i></a>
                        <form asp-action="KhoaMo" asp-route-id="@tk.MaTaiKhoan" method="post" class="d-inline"
                              data-xac-nhan="@(tk.TrangThai == TrangThaiTaiKhoan.HoatDong ? $"Khóa tài khoản {tk.TenDangNhap}?" : $"Mở khóa {tk.TenDangNhap}?")">
                            <button class="btn btn-sm btn-light" title="@(tk.TrangThai == TrangThaiTaiKhoan.HoatDong ? "Khóa" : "Mở khóa")"><i class="bi @(tk.TrangThai == TrangThaiTaiKhoan.HoatDong ? "bi-lock" : "bi-unlock")"></i></button>
                        </form>
                        <form asp-action="DatLaiMatKhau" asp-route-id="@tk.MaTaiKhoan" method="post" class="d-inline" data-xac-nhan="Đặt lại mật khẩu của @tk.TenDangNhap về 123456?">
                            <button class="btn btn-sm btn-light" title="Đặt lại mật khẩu"><i class="bi bi-key"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TongSoDong == 0) { <div class="o-trong"><i class="bi bi-inbox"></i>Không có tài khoản phù hợp</div> }
</div>
<partial name="_PhanTrang" model="Model" />
