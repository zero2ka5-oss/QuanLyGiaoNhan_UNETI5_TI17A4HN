@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 1 - Trang báo không có quyền – hiện khi YeuCauVaiTroAttribute chặn truy cập sai vai trò. *@
@{ ViewData["Title"] = "Không có quyền truy cập"; }
<section class="loi-trang">
    <div class="tc-trong-icon loi"><i class="bi bi-shield-lock"></i></div>
    <h2 class="h4 fw-bold mb-2">Bạn không có quyền truy cập chức năng này</h2>
    <p class="mo mb-2">Chức năng dành cho vai trò khác. Tài khoản hiện tại: <b class="text-body">@Context.Session.HoTen()</b> (@HienThi.TenVaiTro(Context.Session.VaiTro())).</p>
    @if (ViewBag.ReturnUrl is string duongDan) { <p class="nho mo mb-4">Đường dẫn bị chặn: <code>@duongDan</code></p> }
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <a class="btn btn-cam rounded-pill px-4" asp-action="TrangLamViec"><i class="bi bi-grid"></i> Về trang làm việc</a>
        <form asp-action="DangXuat" method="post"><button class="btn btn-light rounded-pill px-4"><i class="bi bi-arrow-repeat"></i> Đăng nhập tài khoản khác</button></form>
    </div>
</section>
