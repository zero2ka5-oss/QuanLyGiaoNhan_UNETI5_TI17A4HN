@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 1 - Trang đăng nhập (tên đăng nhập + mật khẩu, lưu Session): bố cục chia đôi,
                       khối thương hiệu bên trái, form bên phải có nút ẩn / hiện mật khẩu. *@
@model DangNhapVM
@{ Layout = null; ViewData["Title"] = "Đăng nhập"; }
<!DOCTYPE html>
<html lang="vi">
<head><partial name="_TaiNguyenDau" /></head>
<body class="xt-body">
<div class="xt-khung">
    <partial name="_KhoiThuongHieu" />
    <main class="xt-phai">
        <a asp-controller="TrangChu" asp-action="Index" class="nut-ve-trang-chu">Về trang chủ</a>
        <div class="xt-form">
            <a class="logo d-lg-none mb-4" asp-controller="TrangChu" asp-action="Index"><span class="bieu-tuong"><i class="bi bi-truck"></i></span>GiaoNhanh</a>
            <span class="xt-chao"><i class="bi bi-hand-thumbs-up-fill"></i> Chào mừng quay lại</span>
            <h1 class="xt-h1">Đăng nhập</h1>
            <p class="mo mb-4">Đăng nhập để tiếp tục công việc của bạn</p>
            <partial name="_ThongBao" />
            <form asp-action="Index" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <div class="o-nhap">
                        <i class="bi bi-person"></i>
                        <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="text-danger nho"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <div class="o-nhap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                        <button type="button" class="nut-hien-mk" aria-label="Hiện mật khẩu"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger nho"></span>
                </div>
                <button class="btn btn-cam btn-lg w-100 xt-nut">Đăng nhập <i class="bi bi-arrow-right-short"></i></button>
            </form>
            <div class="xt-ngan"><span>hoặc</span></div>
            <a asp-action="DangKy" class="btn btn-light btn-lg w-100 xt-nut-phu"><i class="bi bi-person-plus"></i> Tạo tài khoản gửi hàng</a>
            <a asp-controller="TrangChu" asp-action="TraCuu" class="xt-tra-cuu"><i class="bi bi-search"></i> Chỉ cần tra cứu đơn hàng? Tra cứu không cần đăng nhập</a>
        </div>
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
