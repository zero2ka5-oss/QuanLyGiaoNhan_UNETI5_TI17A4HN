@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 2 - Chi tiết khách hàng: hồ sơ, thống kê đơn, đơn gần đây. *@
@model TongQuanKhachHangVM
@{ var k = Model.KhachHang; ViewData["Title"] = "Khách hàng: " + k.HoTen; }
<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="the-mem p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                @HienThi.AnhDaiDien(k.TaiKhoan?.AnhDaiDien, k.HoTen, "avt avt-md")
                <div><div class="fw-bold fs-5">@k.HoTen</div><span class="tt @k.TrangThai.LopBadge()">@k.TrangThai.TenHienThi()</span></div>
            </div>
            <div class="nho mb-2"><i class="bi bi-telephone text-cam"></i> @DinhDang.SoDienThoai(k.SoDienThoai)</div>
            <div class="nho mb-2"><i class="bi bi-envelope text-cam"></i> @(k.Email ?? "—")</div>
            <div class="nho mb-2"><i class="bi bi-geo-alt text-cam"></i> @k.DiaChi</div>
            <div class="nho mb-2"><i class="bi bi-calendar-check text-cam"></i> Đăng ký @DinhDang.Ngay(k.NgayDangKy)</div>
            <div class="nho mb-3"><i class="bi bi-person-lock text-cam"></i> Tài khoản: @(k.TaiKhoan is null ? "chưa có" : k.TaiKhoan.TenDangNhap)
                @if (k.TaiKhoan?.TrangThai == TrangThaiTaiKhoan.BiKhoa) { <span class="tt tt-thatbai">bị khóa</span> }</div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="QuanTriDonGiaoHang" asp-action="TaoMoi" asp-route-maKhachHang="@k.MaKhachHang" class="btn btn-sm btn-cam"><i class="bi bi-plus-lg"></i> Tạo đơn hộ</a>
                <a asp-action="ChinhSua" asp-route-id="@k.MaKhachHang" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i> Sửa</a>
                <form asp-action="Xoa" asp-route-id="@k.MaKhachHang" method="post" data-xac-nhan="Xóa khách hàng @k.HoTen? (chỉ xóa được khi chưa có đơn)">
                    <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i> Xóa</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3"><div class="kpi"><div class="nhan">Tổng đơn</div><div class="gia-tri">@Model.TongDon</div></div></div>
            <div class="col-6 col-md-3"><div class="kpi"><div class="nhan">Đang xử lý</div><div class="gia-tri text-primary">@Model.DangXuLy</div></div></div>
            <div class="col-6 col-md-3"><div class="kpi"><div class="nhan">Đã giao</div><div class="gia-tri text-success">@Model.DaGiao</div></div></div>
            <div class="col-6 col-md-3"><div class="kpi"><div class="nhan">Tổng phí</div><div class="gia-tri fs-5">@DinhDang.Tien(Model.TongPhi)</div></div></div>
        </div>
        <partial name="_BangDonNgan" model="Model.DonGanDay" />
        <div class="mt-2 text-end"><a asp-controller="QuanTriDonGiaoHang" asp-action="Index" asp-route-TuKhoa="@k.HoTen" class="btn btn-cam btn-sm rounded-pill px-3">Xem tất cả đơn của khách hàng</a></div>
    </div>
</div>
