@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 2 - Form thêm / sửa khách hàng (kèm tạo tài khoản đăng nhập nếu cần). *@
@model KhachHangFormVM
@{ bool laTao = Model.MaKhachHang == 0; ViewData["Title"] = laTao ? "Thêm khách hàng" : "Sửa khách hàng"; }
<div class="the-mem p-4" style="max-width: 820px">
    <form asp-action="@(laTao ? "TaoMoi" : "ChinhSua")" method="post">
        <input type="hidden" asp-for="MaKhachHang" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <h6 class="text-cam fw-bold">Thông tin khách hàng</h6>
        <div class="row g-3 mb-4">
            <div class="col-md-6"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label"></label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" class="form-select"><option value="HoatDong">Đang hoạt động</option><option value="NgungHoatDong">Ngừng hoạt động</option></select></div>
            <div class="col-12"><label asp-for="DiaChi" class="form-label"></label><input asp-for="DiaChi" class="form-control" /><span asp-validation-for="DiaChi" class="text-danger nho"></span></div>
        </div>
        <h6 class="text-cam fw-bold">Tài khoản đăng nhập</h6>
        @if (Model.CoTaiKhoan)
        {
            <div class="alert alert-light border nho">Tài khoản đăng nhập: <code>@Model.TenDangNhap</code></div>
        }
        else
        {
            <div class="row g-3 mb-2">
                <div class="col-md-6"><label asp-for="TenDangNhap" class="form-label"></label><input asp-for="TenDangNhap" class="form-control" placeholder="Để trống nếu không tạo" /><span asp-validation-for="TenDangNhap" class="text-danger nho"></span></div>
                <div class="col-md-6"><label asp-for="MatKhau" class="form-label"></label><input asp-for="MatKhau" class="form-control" /><span asp-validation-for="MatKhau" class="text-danger nho"></span></div>
            </div>
        }
        <div class="d-flex gap-2 mt-3"><button class="btn btn-cam px-4">Lưu</button><a asp-action="@(laTao ? "Index" : "ChiTiet")" asp-route-id="@(laTao ? null : Model.MaKhachHang)" class="btn btn-light">Hủy</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
