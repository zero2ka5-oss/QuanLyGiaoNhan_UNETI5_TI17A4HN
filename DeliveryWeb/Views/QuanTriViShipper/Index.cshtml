@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 4 + 5 - Quản lý ví shipper: giao dịch chờ xác nhận, số dư / tiền đang giữ của từng shipper,
                       lịch sử giao dịch (lọc theo loại, trạng thái, nhân viên; phân trang). *@
@model QuanTriViVM
@{
    ViewData["Title"] = "Ví & thanh toán shipper";
    var dsNv = (List<NhanVienGiaoHang>)ViewBag.DsNhanVien;
}
<div class="row g-3 mb-3">
    <div class="col-12 col-sm-6 col-xl-3"><a asp-route-trangThai="ChoXacNhan" class="kpi d-flex justify-content-between text-reset"><div><div class="nhan">Giao dịch chờ xác nhận</div><div class="gia-tri text-cam">@Model.SoChoXacNhan</div></div><div class="icon icon-cam"><i class="bi bi-bell"></i></div></a></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Tiền nộp chờ xác nhận</div><div class="gia-tri fs-4">@DinhDang.Tien(Model.TienNopChoXacNhan)</div></div><div class="icon icon-vang"><i class="bi bi-box-arrow-in-down"></i></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Yêu cầu rút chờ chuyển khoản</div><div class="gia-tri fs-4">@DinhDang.Tien(Model.TienRutChoXacNhan)</div></div><div class="icon icon-xanh"><i class="bi bi-bank"></i></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="kpi d-flex justify-content-between"><div><div class="nhan">Shipper đang giữ (chưa nộp)</div><div class="gia-tri fs-4 text-danger">@DinhDang.Tien(Model.DsVi.Sum(v => v.TienDangGiu))</div><div class="nho mo">@Model.DsVi.Sum(v => v.SoDonDangGiu) đơn chưa nộp tiền</div></div><div class="icon icon-do"><i class="bi bi-safe2"></i></div></div></div>
</div>

<div class="the-mem mb-3">
    <div class="p-3 fw-bold"><i class="bi bi-wallet2 text-cam"></i> Ví từng shipper</div>
    <div class="table-responsive">
        <table class="table bang mb-0">
            <thead><tr><th>Nhân viên</th><th class="text-end">Đơn thành công</th><th class="text-end">Thu nhập</th><th class="text-end">Đã rút</th><th class="text-end">Số dư</th><th class="text-end">Đang giữ tiền</th><th class="text-end">Chờ xác nhận nộp</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model.DsVi)
            {
                <tr>
                    <td><div class="d-flex align-items-center gap-2"><span class="avt avt-sm avt-xanh">@HienThi.ChuCaiDau(v.NhanVien.HoTen)</span><div class="lh-sm"><a asp-controller="QuanTriNhanVien" asp-action="ChiTiet" asp-route-id="@v.NhanVien.MaNhanVien" class="ten">@v.NhanVien.HoTen</a><div class="nho mo">NV@(v.NhanVien.MaNhanVien.ToString("D3"))</div></div></div></td>
                    <td class="text-end">@v.SoDonThanhCong</td>
                    <td class="text-end text-nowrap">@DinhDang.Tien(v.ThuNhap)</td>
                    <td class="text-end text-nowrap">@DinhDang.Tien(v.DaRut)@if (v.DangChoRut > 0) { <div class="nho text-primary">+ @DinhDang.Tien(v.DangChoRut) chờ</div> }</td>
                    <td class="text-end fw-bold text-success text-nowrap">@DinhDang.Tien(v.SoDu)</td>
                    <td class="text-end text-nowrap @(v.TienDangGiu > 0 ? "fw-bold text-danger" : "mo")">@DinhDang.Tien(v.TienDangGiu)@if (v.SoDonDangGiu > 0) { <div class="nho mo fw-normal">@v.SoDonDangGiu đơn</div> }</td>
                    <td class="text-end text-nowrap @(v.TienChoXacNhanNop > 0 ? "fw-semibold text-cam" : "mo")">@DinhDang.Tien(v.TienChoXacNhanNop)</td>
                    <td class="text-end"><a asp-route-maNhanVien="@v.NhanVien.MaNhanVien" class="btn btn-sm btn-light" title="Lịch sử giao dịch"><i class="bi bi-receipt"></i></a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<form method="get" class="thanh-loc mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label nho">Loại giao dịch</label>
            <select name="loai" class="form-select"><option value="">Tất cả</option>@foreach (var l in Enum.GetValues<LoaiGiaoDich>()) { <option value="@l" selected="@(Model.Loai == l)">@l.TenHienThi()</option> }</select></div>
        <div class="col-md-3"><label class="form-label nho">Trạng thái</label>
            <select name="trangThai" class="form-select"><option value="">Tất cả</option>@foreach (var t in Enum.GetValues<TrangThaiGiaoDich>()) { <option value="@t" selected="@(Model.TrangThai == t)">@t.TenHienThi()</option> }</select></div>
        <div class="col-md-3"><label class="form-label nho">Nhân viên</label>
            <select name="maNhanVien" class="form-select"><option value="">Tất cả</option>@foreach (var n in dsNv) { <option value="@n.MaNhanVien" selected="@(Model.MaNhanVien == n.MaNhanVien)">@n.HoTen</option> }</select></div>
        <div class="col-md-3 d-flex gap-2"><button class="btn btn-cam flex-fill"><i class="bi bi-funnel"></i> Lọc</button><a asp-action="Index" class="btn btn-light">Bỏ lọc</a></div>
    </div>
</form>

<div class="the-mem">
    <div class="p-3 fw-bold"><i class="bi bi-receipt text-cam"></i> Lịch sử giao dịch</div>
    <div class="table-responsive">
        <table class="table bang mb-0">
            <thead><tr><th>Mã giao dịch</th><th>Nhân viên</th><th>Loại</th><th class="text-end">Số tiền</th><th>Thanh toán</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var g in Model.GiaoDich.DanhSach)
            {
                bool nop = g.Loai == LoaiGiaoDich.NopTienThuHo;
                <tr>
                    <td><a asp-action="ChiTiet" asp-route-id="@g.MaGiaoDich" class="fw-bold">@g.MaHienThi</a></td>
                    <td class="text-nowrap">@g.NhanVien?.HoTen</td>
                    <td class="text-nowrap"><i class="bi @(nop ? "bi-box-arrow-in-down text-warning" : "bi-bank text-primary")"></i> @(nop ? "Nộp tiền" : "Rút tiền")</td>
                    <td class="text-end fw-bold text-nowrap">@DinhDang.Tien(g.SoTien)</td>
                    <td class="nho">@g.PhuongThuc<div class="mo text-truncate" style="max-width:150px" title="@g.ThongTinThanhToan">@g.ThongTinThanhToan</div></td>
                    <td class="nho text-nowrap">@DinhDang.NgayGio(g.NgayTao)@if (g.NgayXuLy.HasValue) { <div class="mo">Xử lý @DinhDang.NgayGio(g.NgayXuLy)</div> }</td>
                    <td><span class="tt @g.TrangThai.LopBadge()">@g.TrangThai.TenHienThi()</span></td>
                    <td class="text-end text-nowrap">
                        @if (g.TrangThai == TrangThaiGiaoDich.ChoXacNhan && Context.Session.LaQuanTri())
                        {
                            <form asp-action="XacNhan" asp-route-id="@g.MaGiaoDich" asp-route-quayLai="@(Context.Request.Path + Context.Request.QueryString)" method="post" class="d-inline"
                                  data-xac-nhan="@(nop ? $"Xác nhận đã NHẬN {DinhDang.Tien(g.SoTien)} từ {g.NhanVien?.HoTen}? Các đơn trong lệnh sẽ được đối soát & hoàn tất." : $"Xác nhận đã CHUYỂN KHOẢN {DinhDang.Tien(g.SoTien)} cho {g.NhanVien?.HoTen}?")">
                                <button class="btn btn-sm btn-success" title="Xác nhận"><i class="bi bi-check2"></i></button>
                            </form>
                        }
                        <a asp-action="ChiTiet" asp-route-id="@g.MaGiaoDich" class="btn btn-sm btn-light" title="Chi tiết"><i class="bi bi-eye"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.GiaoDich.TongSoDong == 0) { <div class="o-trong"><i class="bi bi-receipt"></i>Chưa có giao dịch phù hợp.</div> }
</div>
<partial name="_PhanTrang" model="Model.GiaoDich" />
