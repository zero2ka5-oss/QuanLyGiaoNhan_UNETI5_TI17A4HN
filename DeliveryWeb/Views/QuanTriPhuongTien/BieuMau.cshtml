@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 3 - Form thêm / sửa phương tiện (biển số không trùng, tải trọng > 0). *@
@model PhuongTien
@{
    bool laTao = Model.MaPhuongTien == 0;
    ViewData["Title"] = laTao ? "Thêm phương tiện" : "Sửa phương tiện";
    var ttHienTai = ViewBag.TrangThaiHienTai as TrangThaiPhuongTien?;
}
<div class="the-mem p-4" style="max-width: 720px">
    <form asp-action="@(laTao ? "TaoMoi" : "ChinhSua")" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="MaPhuongTien" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="d-flex align-items-center gap-3 mb-3">
            <label class="o-tai-anh o-tai-anh-nho mb-0 @(string.IsNullOrEmpty(Model.AnhXe) ? "" : "co-anh")" id="oAnhXe">
                <img src="@Model.AnhXe" alt="" />
                <span class="goi-y"><i class="bi bi-camera"></i>Ảnh xe</span>
                <input type="file" name="anhXe" accept="@AnhXuLy.ChapNhan" class="d-none" />
            </label>
            <div>
                <div class="fw-semibold">Ảnh phương tiện</div>
                <span asp-validation-for="AnhXe" class="text-danger nho d-block"></span>
                @if (!string.IsNullOrEmpty(Model.AnhXe))
                {
                    <div class="form-check nho"><input class="form-check-input" type="checkbox" name="xoaAnhXe" value="true" id="xoaAnhXe" /><label class="form-check-label" for="xoaAnhXe">Bỏ ảnh</label></div>
                }
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="BienSo" class="form-label"></label><input asp-for="BienSo" class="form-control" placeholder="29B1-123.45" oninput="this.value = this.value.toUpperCase()" /><span asp-validation-for="BienSo" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="LoaiPhuongTien" class="form-label"></label>
                <select asp-for="LoaiPhuongTien" class="form-select"><option value="">-- Chọn --</option>
                    @foreach (var l in PhuongTien.DanhSachLoai) { <option value="@l">@l</option> }
                </select><span asp-validation-for="LoaiPhuongTien" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="TaiTrongToiDa" class="form-label"></label>
                <div class="input-group"><input asp-for="TaiTrongToiDa" type="number" step="0.01" min="0.01" class="form-control" /><span class="input-group-text">kg</span></div>
                <span asp-validation-for="TaiTrongToiDa" class="text-danger nho"></span></div>
            <div class="col-md-6"><label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="SanSang">Sẵn sàng</option>
                    <option value="BaoTri">Bảo trì</option>
                    <option value="NgungHoatDong">Ngừng hoạt động</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger nho"></span>
            <div class="col-12"><label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" rows="2" class="form-control"></textarea></div>
        </div>
        <div class="d-flex gap-2 mt-4"><button class="btn btn-cam px-4">Lưu</button><a asp-action="Index" class="btn btn-light">Hủy</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
