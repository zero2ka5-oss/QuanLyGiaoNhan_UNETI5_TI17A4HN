<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuanLyGiaoNhan_UNETI5_DHTI17A4</RootNamespace>
    <!-- Không tạo file .exe riêng: chạy qua "dotnet <tên>.dll" để tránh bị Smart App Control của Windows chặn. -->
    <UseAppHost>false</UseAppHost>
    <!-- Đảm bảo trình biên dịch C# đọc mã nguồn với bảng mã UTF-8 (CodePage 65001) trên mọi môi trường Windows -->
    <CodePage>65001</CodePage>
    <!-- Luôn biên dịch Razor views vào assembly để tránh lỗi thiếu view -->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
  </ItemGroup>

  <!-- Tự động ký số binary sau khi build để không bị Windows Smart App Control (0x800711C7) chặn -->
  <Target Name="TuDongKySoSmartAppControl" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\sign-build.ps1&quot; -targetPath &quot;$(TargetPath)&quot;" ContinueOnError="true" />
  </Target>

</Project>
