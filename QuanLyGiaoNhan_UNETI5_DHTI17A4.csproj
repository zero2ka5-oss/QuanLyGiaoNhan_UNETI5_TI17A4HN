<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuanLyGiaoNhan_UNETI5_DHTI17A4</RootNamespace>
    <!-- Không tạo file .exe riêng: chạy qua "dotnet <tên>.dll" để tránh bị Smart App Control của Windows chặn. -->
    <UseAppHost>false</UseAppHost>
    <!-- Đảm bảo trình biên dịch C# đọc mã nguồn với bảng mã UTF-8 (CodePage 65001) trên mọi môi trường Windows -->
    <CodePage>65001</CodePage>
    <!-- Luôn biên dịch Razor views vào assembly để tránh lỗi thiếu view -->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Common\" />
    <Folder Include="Filters\" />
    <Folder Include="Helpers\" />
    <Folder Include="Services\" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="QuanLyGiaoNhan_UNETI5_DHTI17A4.Common" />
    <Using Include="QuanLyGiaoNhan_UNETI5_DHTI17A4.Controllers" />
    <Using Include="QuanLyGiaoNhan_UNETI5_DHTI17A4.Filters" />
    <Using Include="QuanLyGiaoNhan_UNETI5_DHTI17A4.Helpers" />
    <Using Include="QuanLyGiaoNhan_UNETI5_DHTI17A4.Services" />
  </ItemGroup>

</Project>
