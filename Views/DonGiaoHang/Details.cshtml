@model DonGiaoHang
@{ ViewData["Title"] = "Chi tiết đơn giao"; }<h1>Đơn #@Model.MaDon</h1><dl class="row"><dt class="col-sm-3">Người nhận</dt><dd class="col-sm-9">@Model.TenNguoiNhan</dd><dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@Model.SoDienThoaiNguoiNhan</dd><dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9">@Model.DiaChiNhan</dd><dt class="col-sm-3">Khối lượng</dt><dd class="col-sm-9">@Model.KhoiLuong</dd><dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai</dd><dt class="col-sm-3">Phí</dt><dd class="col-sm-9">@Model.PhiVanChuyen.ToString("N0")</dd></dl><a asp-action="Index">Quay lại</a>
