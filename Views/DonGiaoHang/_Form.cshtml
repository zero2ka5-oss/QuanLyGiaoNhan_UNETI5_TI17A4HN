@model DonGiaoHang
<input asp-for="NgayTao" type="hidden" />
<label asp-for="MaKhachHang">
</label>
<select asp-for="MaKhachHang" class="form-select">
@foreach (var x in ViewBag.KhachHangs) {<option value="@x.MaKhachHang">@x.HoTen</option>}
</select>
<label asp-for="MaLoaiHang">
</label>
<select asp-for="MaLoaiHang" class="form-select">
@foreach (var x in ViewBag.LoaiHangs) {<option value="@x.MaLoaiHang">@x.TenLoaiHang</option>}
</select>
<label asp-for="MaKhuVuc">
</label>
<select asp-for="MaKhuVuc" class="form-select">
@foreach (var x in ViewBag.KhuVucs) {<option value="@x.MaKhuVuc">@x.TenKhuVuc</option>}
</select>
<label asp-for="TenNguoiNhan">
</label>
<input asp-for="TenNguoiNhan" class="form-control" />
<label asp-for="SoDienThoaiNguoiNhan">
</label>
<input asp-for="SoDienThoaiNguoiNhan" class="form-control" />
<label asp-for="DiaChiNhan">
</label>
<input asp-for="DiaChiNhan" class="form-control" />
<label asp-for="KhoiLuong">
</label>
<input asp-for="KhoiLuong" class="form-control" />
<label asp-for="NgayGiaoDuKien">
</label>
<input asp-for="NgayGiaoDuKien" type="datetime-local" class="form-control" />
<label asp-for="PhiVanChuyen">
</label>
<input asp-for="PhiVanChuyen" class="form-control" />
<label asp-for="TrangThai">
</label>
<input asp-for="TrangThai" class="form-control" />
<label asp-for="GhiChu">
</label>
<textarea asp-for="GhiChu" class="form-control">
</textarea>
<button class="btn btn-primary mt-2">Lưu</button>
