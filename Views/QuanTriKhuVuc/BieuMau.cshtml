@model KhuVuc
@{ bool laTao = Model.MaKhuVuc == 0; ViewData["Title"] = laTao ? "Thêm khu vực giao" : "Sửa khu vực giao"; }
<div class="the-mem p-4" style="max-width: 680px">
    <form asp-action="@(laTao ? "TaoMoi" : "ChinhSua")" method="post">
        <input type="hidden" asp-for="MaKhuVuc" />
        <div class="mb-3"><label asp-for="TenKhuVuc" class="form-label"></label><input asp-for="TenKhuVuc" class="form-control" /><span asp-validation-for="TenKhuVuc" class="text-danger nho"></span></div>
        <div class="mb-3"><label asp-for="PhiCoBan" class="form-label"></label>
            <div class="input-group"><input asp-for="PhiCoBan" type="number" step="1000" min="0" class="form-control" /><span class="input-group-text">đ</span></div>
            <span asp-validation-for="PhiCoBan" class="text-danger nho"></span></div>
        <div class="mb-3"><label asp-for="MaBuuCuc" class="form-label"></label>
            <select asp-for="MaBuuCuc" class="form-select"><option value="">-- Chọn bưu cục phát hàng cho khu vực --</option>
                @foreach (var bc in (List<BuuCuc>)ViewBag.DsBuuCuc) { <option value="@bc.MaBuuCuc">@bc.TenBuuCuc – @bc.TinhThanh@(bc.TrangThai == TrangThaiHoatDong.HoatDong ? "" : " (ngừng)")</option> }
            </select>
            <div class="nho mo">Đơn giao tới khu vực được chuyển về bưu cục này để shipper khu vực đi giao. Đổi bưu cục không ảnh hưởng đơn đã tạo.</div>
            <span asp-validation-for="MaBuuCuc" class="text-danger nho"></span></div>
        <div class="mb-3"><label asp-for="MoTa" class="form-label">Phạm vi / mô tả</label><textarea asp-for="MoTa" rows="3" class="form-control"></textarea></div>
        <div class="mb-3"><label class="form-label">Trạng thái</label>
            <select asp-for="TrangThai" class="form-select">
                <option value="HoatDong">Đang hoạt động</option>
                <option value="NgungHoatDong">Ngừng hoạt động (không nhận đơn mới)</option>
            </select></div>
        <div class="d-flex gap-2"><button class="btn btn-cam px-4">Lưu</button><a asp-action="Index" class="btn btn-light">Hủy</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
