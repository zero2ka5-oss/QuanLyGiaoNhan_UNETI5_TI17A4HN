@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Tra cứu đơn công khai theo mã đơn + số điện thoại người nhận; thẻ trạng thái + thanh hành trình 5 bước,
                       lịch sử giao nhận, thông tin đơn (che tên / số điện thoại người nhận, không lộ thông tin nội bộ). *@
@model DonGiaoHang?
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tra cứu đơn hàng";
    bool daTraCuu = !string.IsNullOrWhiteSpace(ViewBag.Ma as string) || !string.IsNullOrWhiteSpace(ViewBag.Sdt as string);
}
<section class="tc-dau">
    <div class="container position-relative">
        <span class="xt-chao tc-nhan"><i class="bi bi-geo-alt-fill"></i> Theo dõi đơn hàng</span>
        <h1 class="tc-tieu-de">Tra cứu hành trình đơn hàng</h1>
        <p class="tc-mo-ta">Nhập mã đơn và số điện thoại người nhận để xem đơn đang ở đâu</p>
    </div>
</section>
<div class="container position-relative">
    <form method="get" class="tc-hop">
        <div class="o-nhap flex-grow-1"><i class="bi bi-upc-scan"></i><input name="ma" value="@ViewBag.Ma" class="form-control" placeholder="Mã đơn, vd: DH000012" autocomplete="off" required /></div>
        <div class="o-nhap flex-grow-1"><i class="bi bi-telephone"></i><input name="sdt" value="@ViewBag.Sdt" class="form-control" placeholder="Số điện thoại người nhận" inputmode="tel" required /></div>
        <button class="btn btn-cam xt-nut px-4"><i class="bi bi-search"></i> Tra cứu</button>
    </form>
</div>

<div class="container tc-than">
    @if (Model is null)
    {
        <div class="tc-trong">
            <div class="tc-trong-icon @(daTraCuu ? "loi" : "")"><i class="bi @(daTraCuu ? "bi-search" : "bi-box-seam")"></i></div>
            @if (daTraCuu)
            {
                <h2 class="h5 fw-bold mb-1">Không tìm thấy đơn hàng</h2>
                <p class="mo mb-0">@(ViewBag.Loi ?? "Kiểm tra lại mã đơn và số điện thoại người nhận")</p>
            }
            else
            {
                <h2 class="h5 fw-bold mb-1">Hành trình đơn hàng sẽ hiện ở đây</h2>
                <p class="mo mb-0">Thông tin người nhận được che bớt để bảo mật</p>
            }
        </div>
    }
    else
    {
        <partial name="_KetQuaTraCuu" model="Model" />
    }
</div>
