@* Họ và tên: Vũ Thị Vân Anh
   Mã sinh viên: 23103100194
   Nội dung thực hiện: Module 1 - Giao diện tài khoản, đăng nhập, phân quyền, quản lý loại hàng và khu vực giao. *@
@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="row justify-content-center">
<div class="col-md-5">
<h1>Đăng nhập</h1>
<form asp-action="Login" method="post">
<input asp-for="ReturnUrl" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger">
</div>
<div class="mb-3">
<label asp-for="TenDangNhap" class="form-label">
</label>
<input asp-for="TenDangNhap" class="form-control" />
<span asp-validation-for="TenDangNhap" class="text-danger">
</span>
</div>
<div class="mb-3">
<label asp-for="MatKhau" class="form-label">
</label>
<input asp-for="MatKhau" class="form-control" />
<span asp-validation-for="MatKhau" class="text-danger">
</span>
</div>
<button class="btn btn-primary" type="submit">Đăng nhập</button>
</form>
<p class="mt-3 text-muted">Tài khoản mẫu: admin / Admin@123</p>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
