@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="row justify-content-center"><div class="col-md-5"><h1>Đăng nhập</h1><form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="TenDangNhap" class="form-label"></label><input asp-for="TenDangNhap" class="form-control" /><span asp-validation-for="TenDangNhap" class="text-danger"></span></div><div class="mb-3"><label asp-for="MatKhau" class="form-label"></label><input asp-for="MatKhau" class="form-control" /><span asp-validation-for="MatKhau" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Đăng nhập</button> <a class="btn btn-outline-secondary" asp-action="Register">Đăng ký người gửi</a></form><div class="mt-3 small text-muted"><div>Admin: <code>admin / Admin@123</code></div><div>Khách hàng/người gửi: <code>khachhang01 / Khach@123</code></div><div>Nhân viên giao hàng: <code>shipper01 / Shipper@123</code></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
