@model IEnumerable<TaiKhoan>
@{ ViewData["Title"] = "Tài khoản"; }<h1>Tài khoản</h1><p><a class="btn btn-primary" asp-action="Create">Thêm tài khoản</a></p><table class="table"><thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.TenDangNhap</td><td>@item.HoTen</td><td>@item.Email</td><td>@item.VaiTro</td><td><a asp-action="Details" asp-route-id="@item.MaTaiKhoan">Chi tiết</a> | <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan">Sửa</a> | <a asp-action="Delete" asp-route-id="@item.MaTaiKhoan">Xóa</a></td></tr> }</tbody></table>
