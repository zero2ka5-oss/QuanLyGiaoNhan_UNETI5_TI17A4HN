@* Họ và tên: Vũ Thị Vân Anh
   Mã sinh viên: 23103100194
   Nội dung thực hiện: Form dùng chung tạo/cập nhật tài khoản, vai trò và trạng thái. *@
@model TaiKhoan
<div asp-validation-summary="ModelOnly" class="text-danger mb-3">
</div>
<div class="mb-3">
<label asp-for="TenDangNhap" class="form-label">
</label>
<input asp-for="TenDangNhap" class="form-control" autocomplete="username" />
<span asp-validation-for="TenDangNhap" class="text-danger">
</span>
</div>
<div class="mb-3">
<label asp-for="MatKhau" class="form-label">
</label>
<input asp-for="MatKhau" type="password" class="form-control" autocomplete="new-password" />
<span asp-validation-for="MatKhau" class="text-danger">
</span>
</div>
<div class="mb-3">
<label asp-for="HoTen" class="form-label">
</label>
<input asp-for="HoTen" class="form-control" />
<span asp-validation-for="HoTen" class="text-danger">
</span>
</div>
<div class="mb-3">
<label asp-for="Email" class="form-label">
</label>
<input asp-for="Email" type="email" class="form-control" />
<span asp-validation-for="Email" class="text-danger">
</span>
</div>
<div class="mb-3">
<label asp-for="VaiTro" class="form-label">
</label>
<select asp-for="VaiTro" class="form-select">
<option value="Admin">Admin</option>
<option value="Nhân viên điều phối">Nhân viên điều phối</option>
<option value="Nhân viên giao hàng">Nhân viên giao hàng</option>
<option value="Khách hàng">Khách hàng</option>
</select>
<span asp-validation-for="VaiTro" class="text-danger">
</span>
</div>
<div class="mb-3">
<label asp-for="TrangThai" class="form-label">
</label>
<select asp-for="TrangThai" class="form-select">
<option value="Hoạt động">Hoạt động</option>
<option value="Bị khóa">Bị khóa</option>
</select>
<span asp-validation-for="TrangThai" class="text-danger">
</span>
</div>
<button class="btn btn-primary" type="submit">
<i class="bi bi-check2-circle">
</i> Lưu thông tin</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
