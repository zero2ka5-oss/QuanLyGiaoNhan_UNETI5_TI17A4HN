@model IEnumerable<LichSuGiaoNhan>
@{ ViewData["Title"] = "Lịch sử giao nhận"; }<h1>Lịch sử giao nhận</h1><p><a asp-action="Create" class="btn btn-primary">Thêm lịch sử</a></p><table class="table"><tr><th>Đơn</th><th>Thời gian</th><th>Trạng thái</th><th>Nội dung</th><th>Người thực hiện</th><th></th></tr>@foreach (var x in Model) {<tr><td>#@x.MaDon</td><td>@x.ThoiGian</td><td>@x.TrangThaiCu → @x.TrangThaiMoi</td><td>@x.NoiDung</td><td>@x.NguoiThucHien</td><td><a asp-action="Details" asp-route-id="@x.MaLichSu">Chi tiết</a> | <a asp-action="Edit" asp-route-id="@x.MaLichSu">Sửa</a> | <a asp-action="Delete" asp-route-id="@x.MaLichSu">Xóa</a></td></tr>}</table>
