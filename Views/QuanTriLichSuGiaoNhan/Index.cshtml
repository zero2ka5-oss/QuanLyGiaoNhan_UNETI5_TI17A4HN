@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 5 - Tra cứu lịch sử giao nhận toàn hệ thống: bộ lọc tự áp dụng khi đổi trạng thái,
                       mỗi mốc hiển thị thanh tiến trình Phân công → Nhận hàng → Đang giao → Giao xong → Hoàn tất. *@
@model List<LichSuGiaoNhan>
@{
    ViewData["Title"] = "Lịch sử giao nhận";
    TrangThaiDon? loc = ViewBag.TrangThaiMoi;
    bool dangLoc = !string.IsNullOrEmpty(ViewBag.TuKhoa) || loc.HasValue || ViewBag.TuNgay != null || ViewBag.DenNgay != null;
}
<form method="get" class="thanh-loc mb-3" id="boLoc">
    <div class="row g-2 align-items-end">
        <div class="col-lg-4 col-md-6"><label class="form-label nho" for="tuKhoa">Tìm kiếm</label>
            <div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search mo"></i></span>
                <input name="tuKhoa" id="tuKhoa" value="@ViewBag.TuKhoa" class="form-control border-start-0" placeholder="Mã đơn, người thực hiện, nội dung" /></div></div>
        <div class="col-lg-3 col-md-6"><label class="form-label nho" for="trangThaiMoi">Trạng thái</label>
            <select name="trangThaiMoi" id="trangThaiMoi" class="form-select tu-loc"><option value="">Tất cả</option>
                @foreach (var tt in HienThi.TatCaTrangThaiDon) { <option value="@tt" selected="@(loc == tt)">@tt.TenHienThi()</option> }
            </select></div>
        <div class="col-lg-2 col-6"><label class="form-label nho" for="tuNgay">Từ ngày</label><input type="date" name="tuNgay" id="tuNgay" value="@ViewBag.TuNgay" class="form-control" /></div>
        <div class="col-lg-2 col-6"><label class="form-label nho" for="denNgay">Đến ngày</label><input type="date" name="denNgay" id="denNgay" value="@ViewBag.DenNgay" class="form-control" /></div>
        <div class="col-lg-1 d-flex gap-2">
            <button class="btn btn-cam flex-grow-1" title="Lọc"><i class="bi bi-funnel"></i><span class="d-lg-none ms-1">Lọc</span></button>
            @if (dangLoc) { <a asp-action="Index" class="btn btn-light" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i></a> }
        </div>
    </div>
</form>
<div class="the-mem">
    <div class="table-responsive">
        <table class="table bang bang-lich-su">
            <thead><tr><th>Thời gian</th><th>Đơn</th><th>Tiến trình</th><th>Nội dung</th><th>Người thực hiện</th></tr></thead>
            <tbody>
            @foreach (var l in Model)
            {
                var (ten, vaiTro, thamChieu) = DinhDang.TachNguoiThucHien(l.NguoiThucHien);
                <tr>
                    <td class="text-nowrap"><div class="fw-semibold">@l.ThoiGian.ToString("HH:mm")</div><div class="nho mo">@DinhDang.Ngay(l.ThoiGian)</div></td>
                    <td class="text-nowrap"><a asp-controller="QuanTriDonGiaoHang" asp-action="ChiTiet" asp-route-id="@l.MaDon" class="fw-bold">@l.DonGiaoHang?.MaHienThi</a></td>
                    <td>
                        <div class="tien-do" title="@l.TrangThaiMoi.TenHienThi()">
                            @foreach (var (lop, nhan) in DinhDang.TienTrinh(l.TrangThaiMoi, l.TrangThaiCu))
                            {
                                <div class="buoc @lop"><span class="cham">@if (lop == "loi") { <i class="bi bi-x-lg"></i> } else if (lop != "") { <i class="bi bi-check-lg"></i> }</span><span class="nhan">@nhan</span></div>
                            }
                        </div>
                    </td>
                    <td class="nho" style="min-width:220px">@l.NoiDung</td>
                    <td class="text-nowrap">
                        <div class="fw-semibold nho">@ten</div>
                        <div class="nho mo">@(vaiTro ?? "Hệ thống")@(thamChieu is null ? "" : " · " + thamChieu)</div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0) { <div class="o-trong"><i class="bi bi-clock-history"></i>Không có lịch sử phù hợp</div> }
</div>
<div class="nho mo mt-2">Hiển thị tối đa 100 mốc mới nhất</div>

@section Scripts {
    <script>
        // Đổi trạng thái là lọc ngay, không cần bấm nút
        document.querySelectorAll('#boLoc .tu-loc').forEach(o => o.addEventListener('change', () => o.form.requestSubmit()));
    </script>
}
