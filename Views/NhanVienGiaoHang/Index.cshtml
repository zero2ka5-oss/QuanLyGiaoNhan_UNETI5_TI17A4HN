@model IEnumerable<NhanVienGiaoHang>
@{ ViewData["Title"] = "Nhân viên giao hàng"; }<h1>Nhân viên giao hàng</h1><p><a asp-action="Create" class="btn btn-primary">Thêm</a></p><table class="table"><tr><th>Họ tên</th><th>Điện thoại</th><th>Khu vực</th><th>Trạng thái</th><th></th></tr>@foreach (var x in Model) {<tr><td>@x.HoTen</td><td>@x.SoDienThoai</td><td>@x.KhuVucPhuTrach</td><td>@x.TrangThai</td><td><a asp-action="Details" asp-route-id="@x.MaNhanVien">Chi tiết</a> | <a asp-action="Edit" asp-route-id="@x.MaNhanVien">Sửa</a> | <a asp-action="Delete" asp-route-id="@x.MaNhanVien">Xóa</a></td></tr>}</table>
