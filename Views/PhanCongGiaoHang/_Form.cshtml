@model PhanCongGiaoHang
<div class="assignment-form-grid">
    <div class="assignment-form-field assignment-form-wide"><label asp-for="MaDon" class="form-label">Đơn giao</label><select asp-for="MaDon" class="form-select"><option value="">-- Chọn đơn đang chờ phân công --</option>@foreach (var item in ViewBag.DonGiaoHangs) {<option value="@item.MaDon">#@item.MaDon · @item.TenNguoiNhan · @item.DiaChiNhan</option>}</select><span asp-validation-for="MaDon" class="text-danger"></span></div>
    <div class="assignment-form-field"><label asp-for="MaNhanVien" class="form-label">Nhân viên giao hàng</label><select asp-for="MaNhanVien" class="form-select"><option value="">-- Chọn nhân viên sẵn sàng --</option>@foreach (var item in ViewBag.NhanVienGiaoHangs) {<option value="@item.MaNhanVien">@item.HoTen · @item.KhuVucPhuTrach</option>}</select><span asp-validation-for="MaNhanVien" class="text-danger"></span></div>
    <div class="assignment-form-field"><label asp-for="MaPhuongTien" class="form-label">Phương tiện</label><select asp-for="MaPhuongTien" class="form-select"><option value="">-- Chọn phương tiện sẵn sàng --</option>@foreach (var item in ViewBag.PhuongTiens) {<option value="@item.MaPhuongTien">@item.BienSo · @item.LoaiPhuongTien · @item.TaiTrongToiDa kg</option>}</select><span asp-validation-for="MaPhuongTien" class="text-danger"></span></div>
    <div class="assignment-form-field assignment-form-wide"><label asp-for="GhiChu" class="form-label">Ghi chú điều phối</label><textarea asp-for="GhiChu" class="form-control" rows="4" placeholder="Ví dụ: Giao trong khung giờ buổi chiều"></textarea><span asp-validation-for="GhiChu" class="text-danger"></span></div>
</div>
<div class="assignment-form-actions"><button class="button button-primary" type="submit">Lưu phân công</button><a asp-action="Index" class="button button-secondary">Hủy</a></div>
