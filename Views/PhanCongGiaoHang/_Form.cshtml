@model PhanCongGiaoHang
<label asp-for="MaDon"></label><select asp-for="MaDon" class="form-select">@foreach (var x in ViewBag.DonGiaoHangs) {<option value="@x.MaDon">#@x.MaDon - @x.TenNguoiNhan</option>}</select><label asp-for="MaNhanVien"></label><select asp-for="MaNhanVien" class="form-select">@foreach (var x in ViewBag.NhanVienGiaoHangs) {<option value="@x.MaNhanVien">@x.HoTen</option>}</select><label asp-for="MaPhuongTien"></label><select asp-for="MaPhuongTien" class="form-select">@foreach (var x in ViewBag.PhuongTiens) {<option value="@x.MaPhuongTien">@x.BienSo</option>}</select><label asp-for="TrangThai"></label><input asp-for="TrangThai" class="form-control" /><label asp-for="GhiChu"></label><textarea asp-for="GhiChu" class="form-control"></textarea><button class="btn btn-primary mt-2">Lưu</button>
