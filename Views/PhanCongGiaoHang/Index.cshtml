@model IEnumerable<PhanCongGiaoHang>
@{ ViewData["Title"] = "Phân công giao hàng"; var isCoordinator = Context.Session.GetString("VaiTro") is "Admin" or "Nhân viên điều phối"; }<div class="d-flex justify-content-between align-items-center mb-3"><h1>Phân công giao hàng</h1>@if (isCoordinator) {<a asp-action="Create" class="btn btn-primary">Phân công mới</a>}</div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Đơn</th><th>Nhân viên</th><th>Phương tiện</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var x in Model) {<tr><td>#@x.MaDon</td><td>@x.NhanVienGiaoHang?.HoTen</td><td>@x.PhuongTien?.BienSo</td><td>@x.TrangThai</td><td><a asp-action="Details" asp-route-id="@x.MaPhanCong">@(isCoordinator ? "Chi tiết" : "Cập nhật")</a>@if (isCoordinator) {<text> | <a asp-action="Edit" asp-route-id="@x.MaPhanCong">Sửa</a> | <a asp-action="Delete" asp-route-id="@x.MaPhanCong">Xóa</a></text>}</td></tr>}</tbody></table></div>
