@model IEnumerable<PhanCongGiaoHang>
@{ ViewData["Title"] = "Phân công giao hàng"; }
<h1>Phân công giao hàng</h1>
<p>
<a asp-action="Create" class="btn btn-primary">Phân công mới</a>
</p>
<table class="table">
<tr>
<th>Đơn</th>
<th>Nhân viên</th>
<th>Phương tiện</th>
<th>Trạng thái</th>
<th>
</th>
</tr>
@foreach (var x in Model) {<tr>
<td>#@x.MaDon</td>
<td>@x.NhanVienGiaoHang?.HoTen</td>
<td>@x.PhuongTien?.BienSo</td>
<td>@x.TrangThai</td>
<td>
<a asp-action="Details" asp-route-id="@x.MaPhanCong">Chi tiết</a> | <a asp-action="Edit" asp-route-id="@x.MaPhanCong">Sửa</a> | <a asp-action="Delete" asp-route-id="@x.MaPhanCong">Xóa</a>
</td>
</tr>}
</table>
