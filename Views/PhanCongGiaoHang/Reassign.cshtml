@model PhanCongGiaoHang
@{
    ViewData["Title"] = "Đổi phân công";
}

<div class="page-heading-row"><div><span class="eyebrow">Bảo toàn lịch sử</span><h2>Đổi phân công</h2><p>Phân công cũ sẽ được đóng lại, bản ghi mới sẽ được tạo cho cùng một đơn.</p></div><a asp-action="Details" asp-route-id="@Model.MaPhanCong" class="button button-ghost">Quay lại</a></div>
<section class="panel assignment-form-panel"><div class="panel-header"><div><h3>Thay đổi nguồn lực giao hàng</h3><p>Đơn #@Model.MaDon · @Model.DonGiaoHang?.TenNguoiNhan · trạng thái hiện tại: @Model.TrangThai</p></div></div><div class="assignment-form-body"><form asp-action="Reassign" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="MaPhanCong" type="hidden" /><input asp-for="MaDon" type="hidden" /><div class="assignment-form-grid"><div class="assignment-form-field"><label class="form-label">Nhân viên giao hàng</label><select asp-for="MaNhanVien" class="form-select">@foreach (var item in ViewBag.NhanVienGiaoHangs) {<option value="@item.MaNhanVien">@item.HoTen · @item.KhuVucPhuTrach</option>}</select><span asp-validation-for="MaNhanVien" class="text-danger"></span></div><div class="assignment-form-field"><label class="form-label">Phương tiện</label><select asp-for="MaPhuongTien" class="form-select">@foreach (var item in ViewBag.PhuongTiens) {<option value="@item.MaPhuongTien">@item.BienSo · @item.LoaiPhuongTien · @item.TaiTrongToiDa kg</option>}</select><span asp-validation-for="MaPhuongTien" class="text-danger"></span></div><div class="assignment-form-field assignment-form-wide"><label asp-for="GhiChu" class="form-label">Lý do thay đổi</label><textarea asp-for="GhiChu" class="form-control" rows="4" placeholder="Ví dụ: Nhân viên nghỉ đột xuất hoặc đổi phương tiện"></textarea><span asp-validation-for="GhiChu" class="text-danger"></span></div></div><div class="assignment-form-actions"><button class="button button-primary" type="submit">Tạo phân công mới</button><a asp-action="Details" asp-route-id="@Model.MaPhanCong" class="button button-secondary">Hủy</a></div></form></div></section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
