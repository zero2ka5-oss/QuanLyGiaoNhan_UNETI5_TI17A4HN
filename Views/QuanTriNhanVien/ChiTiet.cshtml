@model NhanVienGiaoHang
@{
    ViewData["Title"] = "Shipper: " + Model.HoTen;
    var lichSuXe = (List<LichSuPhuongTien>)ViewBag.LichSuXe;
    var dsPc = (List<PhanCongGiaoHang>)ViewBag.DsPhanCong;
    var dangLam = dsPc.Where(p => p.DangHieuLuc).ToList();
}
<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="the-mem p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                @HienThi.AnhDaiDien(Model.TaiKhoan?.AnhDaiDien, Model.HoTen, "avt avt-md avt-xanh")
                <div><div class="fw-bold fs-5">@Model.HoTen</div><span class="tt @Model.TrangThai.LopBadge()">@Model.TrangThai.TenHienThi()</span></div>
            </div>
            <div class="nho mb-2"><i class="bi bi-telephone text-cam"></i> <a href="tel:@Model.SoDienThoai">@DinhDang.SoDienThoai(Model.SoDienThoai)</a></div>
            <div class="nho mb-2"><i class="bi bi-envelope text-cam"></i> @Model.Email</div>
            <div class="nho mb-2"><i class="bi bi-person-badge text-cam"></i> @Model.MaHienThi · <span class="tt @(Model.LoaiShipper == LoaiShipper.LienTinh ? "tt-dang" : "tt-xuly")">@Model.LoaiShipper.TenHienThi()</span></div>
            <div class="nho mb-2"><i class="bi bi-building text-cam"></i> Bưu cục: @(Model.BuuCuc?.TenBuuCuc ?? "—")</div>
            @if (Model.LoaiShipper == LoaiShipper.KhuVuc) { <div class="nho mb-2"><i class="bi bi-geo-alt text-cam"></i> Phụ trách: @(Model.KhuVucPhuTrach?.TenKhuVuc ?? "—")</div> }
            <div class="nho mb-2"><i class="bi bi-truck-front text-cam"></i> Phương tiện: @(Model.PhuongTien is null ? "chưa gán" : $"{Model.PhuongTien.MaHienThi} · {Model.PhuongTien.LoaiPhuongTien} · {Model.PhuongTien.BienSo}")</div>
            @if (Model.ThoiGianViTri is not null) { <div class="nho mb-2"><i class="bi bi-broadcast text-cam"></i> GPS cập nhật @DinhDang.ThoiGianTuongDoi(Model.ThoiGianViTri.Value)</div> }
            <div class="nho mb-3"><i class="bi bi-person-lock text-cam"></i> Tài khoản: @(Model.TaiKhoan?.TenDangNhap ?? "chưa có")</div>
            @if (Context.Session.LaQuanTri())
            {
                <div class="d-flex gap-2">
                    <a asp-action="ChinhSua" asp-route-id="@Model.MaNhanVien" class="btn btn-sm btn-cam"><i class="bi bi-pencil"></i> Sửa</a>
                    <form asp-action="Xoa" asp-route-id="@Model.MaNhanVien" method="post" data-xac-nhan="Xóa nhân viên @Model.HoTen?">
                        <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i> Xóa</button>
                    </form>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-8">
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3"><div class="kpi"><div class="nhan">Đang giữ</div><div class="gia-tri text-primary">@dangLam.Count</div></div></div>
            <div class="col-6 col-md-3"><div class="kpi"><div class="nhan">Giao thành công</div><div class="gia-tri text-success">@ViewBag.ThanhCong</div></div></div>
            <div class="col-6 col-md-3"><div class="kpi"><div class="nhan">Không thành công</div><div class="gia-tri text-danger">@ViewBag.ThatBai</div></div></div>
            <div class="col-6 col-md-3"><div class="kpi"><div class="nhan">Khối lượng đã giao</div><div class="gia-tri fs-5">@DinhDang.KhoiLuong((decimal)ViewBag.TongKhoiLuong)</div></div></div>
        </div>
        <div class="the-mem">
            <div class="p-3 fw-bold">Lịch sử chặng vận chuyển (@dsPc.Count)</div>
            <div class="table-responsive" style="max-height: 460px">
                <table class="table bang">
                    <thead><tr><th>Đơn</th><th>Khu vực</th><th>Phương tiện</th><th>Phân công</th><th>Kết thúc</th><th>Trạng thái / kết quả</th></tr></thead>
                    <tbody>
                    @foreach (var p in dsPc)
                    {
                        <tr>
                            <td><a asp-controller="QuanTriDonGiaoHang" asp-action="ChiTiet" asp-route-id="@p.MaDon" class="fw-semibold">@p.DonGiaoHang?.MaHienThi</a></td>
                            <td class="nho">@p.DonGiaoHang?.KhuVuc?.TenKhuVuc</td>
                            <td class="nho">@p.PhuongTien?.BienSo</td>
                            <td class="nho">@DinhDang.NgayGio(p.NgayPhanCong)</td>
                            <td class="nho">@DinhDang.NgayGio(p.NgayKetThuc)</td>
                            <td>@if (p.KetQua.HasValue)
                                {
                                    <span class="tt @(p.KetQua is KetQuaGiao.GiaoThanhCong or KetQuaGiao.DaBanGiaoBuuCuc ? "tt-thanhcong" : p.KetQua == KetQuaGiao.GiaoKhongThanhCong ? "tt-thatbai" : "tt-huy")">@p.KetQua.Value.TenHienThi()</span>
                                    @if (p.LyDoThatBai.HasValue) { <div class="nho text-danger">@p.LyDoThatBai.Value.TenHienThi()</div> }
                                }
                                else { <span class="tt @p.TrangThai.LopBadge()">@p.TrangThai.TenHienThi()</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (dsPc.Count == 0) { <div class="o-trong"><i class="bi bi-inbox"></i>Chưa có phân công</div> }
        </div>
    </div>
</div>

<div class="the-mem mt-3">
    <div class="p-3 fw-bold"><i class="bi bi-arrow-left-right text-cam"></i> Lịch sử gán phương tiện</div>
    <div class="table-responsive">
        <table class="table bang mb-0">
            <thead><tr><th>Thời gian</th><th>Phương tiện cũ</th><th>Phương tiện mới</th><th>Lý do</th><th>Người thực hiện</th></tr></thead>
            <tbody>
            @foreach (var l in lichSuXe)
            {
                <tr>
                    <td class="nho text-nowrap">@DinhDang.NgayGio(l.ThoiGian)</td>
                    <td class="nho">@(l.PhuongTienCu is null ? "—" : $"{l.PhuongTienCu.MaHienThi} · {l.PhuongTienCu.BienSo}")</td>
                    <td class="nho fw-semibold">@(l.PhuongTienMoi is null ? "— (trả xe)" : $"{l.PhuongTienMoi.MaHienThi} · {l.PhuongTienMoi.BienSo}")</td>
                    <td class="nho">@l.LyDo</td>
                    <td class="nho mo">@l.NguoiThucHien</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (lichSuXe.Count == 0) { <div class="o-trong"><i class="bi bi-truck"></i>Chưa có lịch sử gán phương tiện</div> }
</div>
