@model KhachHang
<label asp-for="MaTaiKhoan"></label><select asp-for="MaTaiKhoan" class="form-select"><option value="">-- Chọn tài khoản --</option>@if (ViewBag.TaiKhoans is not null) { foreach (var account in ViewBag.TaiKhoans) {<option value="@account.MaTaiKhoan">@account.TenDangNhap</option>} }</select><label asp-for="HoTen"></label><input asp-for="HoTen" class="form-control" /><label asp-for="SoDienThoai"></label><input asp-for="SoDienThoai" class="form-control" /><label asp-for="Email"></label><input asp-for="Email" class="form-control" /><label asp-for="DiaChi"></label><input asp-for="DiaChi" class="form-control" /><label asp-for="NgayDangKy"></label><input asp-for="NgayDangKy" type="date" class="form-control" /><label asp-for="TrangThai"></label><input asp-for="TrangThai" class="form-control" /><button class="btn btn-primary mt-2">Lưu</button>
