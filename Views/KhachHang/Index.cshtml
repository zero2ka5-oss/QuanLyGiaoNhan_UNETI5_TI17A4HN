@model IEnumerable<KhachHang>
@{ ViewData["Title"] = "Khách hàng"; }<h1>Khách hàng</h1><p><a asp-action="Create" class="btn btn-primary">Thêm</a></p><table class="table"><tr><th>Họ tên</th><th>Điện thoại</th><th>Email</th><th>Địa chỉ</th><th></th></tr>@foreach (var x in Model) {<tr><td>@x.HoTen</td><td>@x.SoDienThoai</td><td>@x.Email</td><td>@x.DiaChi</td><td><a asp-action="Details" asp-route-id="@x.MaKhachHang">Chi tiết</a> | <a asp-action="Edit" asp-route-id="@x.MaKhachHang">Sửa</a> | <a asp-action="Delete" asp-route-id="@x.MaKhachHang">Xóa</a></td></tr>}</table>
