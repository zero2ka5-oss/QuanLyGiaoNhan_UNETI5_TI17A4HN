@model PhanCongFormVM
@{
    var d = Model.Don!;
    bool lienTinh = Model.LoaiChang == LoaiShipper.LienTinh;
    bool laChuyenHoan = d.TrangThai == TrangThaiDon.ChoChuyenHoan;
    bool laGiaoHoan = d.TrangThai == TrangThaiDon.DaVeBuuCucGui;
    int soLanThatBai = d.PhanCongs.Count(p => p.KetQua == KetQuaGiao.GiaoKhongThanhCong);
    ViewData["Title"] = (Model.LaDoiPhanCong ? "Đổi shipper đơn " : laChuyenHoan ? "Phân xe tải chuyển hoàn liên tỉnh đơn " : laGiaoHoan ? "Phân shipper giao hoàn người gửi đơn " : lienTinh ? "Phân shipper liên tỉnh đơn " : "Phân shipper khu vực đơn ") + d.MaHienThi;
    var buuCucCan = laChuyenHoan
        ? (d.BuuCucHienTai ?? d.BuuCucNhan)
        : (laGiaoHoan || lienTinh || d.TrangThai == TrangThaiDon.ChoLayTanNoi ? d.BuuCucGui : d.BuuCucNhan);
    bool laNvBuuCuc = Context.Session.LaNhanVienBuuCuc();
}
<form asp-action="@(Model.LaDoiPhanCong ? "DoiPhanCong" : "TaoMoi")" method="post">
    <input type="hidden" asp-for="MaDon" />
    <input type="hidden" asp-for="LoaiChang" />
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="the-mem p-4 mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2"><span class="fw-bold fs-5">@d.MaHienThi</span><span class="tt @d.TrangThai.LopBadge()">@d.TrangThai.TenHienThi()</span></div>
                <div class="mt-2"><span class="tt @(lienTinh ? "tt-dang" : "tt-xuly")"><i class="bi @(lienTinh ? "bi-truck-front" : "bi-truck")"></i> @(laChuyenHoan ? "Chuyển hoàn liên tỉnh" : laGiaoHoan ? "Giao hoàn cho người gửi" : Model.LoaiChang.TenChang())</span></div>
                <hr>
                @if (laChuyenHoan)
                {
                    <div class="nho mb-2"><span class="mo">Chuyển hoàn:</span> <b>@(d.BuuCucHienTai?.TenBuuCuc ?? d.BuuCucNhan?.TenBuuCuc)</b> → <b>@d.BuuCucGui?.TenBuuCuc</b></div>
                }
                else if (laGiaoHoan)
                {
                    <div class="nho mb-2"><span class="mo">Giao hoàn:</span> <b>@d.BuuCucGui?.TenBuuCuc</b> → Người gửi: <b>@d.KhachHang?.HoTen</b></div>
                }
                else
                {
                    <div class="nho mb-2"><span class="mo">Tuyến:</span> <b>@d.BuuCucGui?.TenBuuCuc</b> → <b>@d.BuuCucNhan?.TenBuuCuc</b></div>
                }
                <div class="nho mb-2"><span class="mo">Hàng đang ở:</span> @(d.BuuCucHienTai?.TenBuuCuc ?? "—")</div>
                <div class="nho mb-2"><span class="mo">Khách gửi:</span> @d.KhachHang?.HoTen</div>
                @if (laGiaoHoan)
                {
                    <div class="nho mb-2"><span class="mo">Giao trả đến:</span> <b>@d.KhachHang?.DiaChi</b></div>
                    <div class="nho mb-2"><span class="mo">Người nhận trả:</span> @d.KhachHang?.HoTen – @DinhDang.SoDienThoai(d.KhachHang?.SoDienThoai)</div>
                }
                else
                {
                    <div class="nho mb-2"><span class="mo">Giao đến:</span> <b>@d.KhuVuc?.TenKhuVuc</b><br>@d.DiaChiNhan</div>
                    <div class="nho mb-2"><span class="mo">Người nhận:</span> @d.TenNguoiNhan – @DinhDang.SoDienThoai(d.SoDienThoaiNguoiNhan)</div>
                }
                <div class="nho mb-2"><span class="mo">Loại hàng:</span> @d.LoaiHang?.TenLoaiHang</div>
                <div class="fs-5"><span class="mo nho">Khối lượng:</span> <b class="text-cam">@DinhDang.KhoiLuong(d.KhoiLuong)</b></div>
                <div class="nho"><span class="mo">Giao dự kiến:</span> @DinhDang.Ngay(d.NgayGiaoDuKien)</div>
            </div>
            @if (Model.PhanCongHienTai is { } pc)
            {
                <div class="the-mem p-3 mb-3 bg-cam-nhat">
                    <div class="nho mo">Shipper hiện tại</div>
                    <div class="fw-semibold">@pc.NhanVien?.HoTen · @pc.PhuongTien?.MaHienThi @pc.PhuongTien?.BienSo</div>
                    <span class="tt @pc.TrangThai.LopBadge()">@pc.TrangThai.TenHienThi()</span>
                </div>
            }
            @if (soLanThatBai > 0 && !lienTinh && !laGiaoHoan)
            {
                <div class="alert alert-warning nho"><i class="bi bi-exclamation-triangle"></i> Đơn đã giao không thành công @soLanThatBai / @DonHangXuLy.SoLanGiaoToiDa lần. Lịch sử các lần trước được giữ nguyên.</div>
            }
            <div class="the-mem p-3">
                <label asp-for="GhiChu" class="form-label">@(Model.LaDoiPhanCong ? "Lý do đổi shipper (bắt buộc)" : "Ghi chú cho shipper")</label>
                <textarea asp-for="GhiChu" rows="3" class="form-control" placeholder="@(Model.LaDoiPhanCong ? "VD: Shipper cũ báo ốm" : "VD: Hàng dễ vỡ, gọi trước 30 phút")"></textarea>
                <div class="nho mo mt-2"><i class="bi bi-qr-code-scan"></i> Shipper tới @buuCucCan?.TenBuuCuc quét mã vận đơn để nhận hàng.</div>
                <button class="btn btn-cam w-100 mt-3 btn-lg"><i class="bi bi-check2-circle"></i> @(Model.LaDoiPhanCong ? "Xác nhận đổi shipper" : "Xác nhận phân công")</button>
                <a asp-controller="@(laNvBuuCuc ? "BuuCuc" : "QuanTriDonGiaoHang")" asp-action="@(laNvBuuCuc ? "Don" : "ChiTiet")" asp-route-id="@d.MaDon" class="btn btn-light w-100 mt-2">Hủy</a>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="the-mem p-4">
                <h6 class="fw-bold mb-1"><i class="bi bi-person-badge text-cam"></i> Chọn @(laChuyenHoan ? "xe tải chuyển hoàn" : laGiaoHoan ? "shipper giao hoàn" : lienTinh ? "shipper liên tỉnh" : "shipper khu vực")</h6>
                <div class="nho mo mb-3">
                    @(laChuyenHoan ? $"Shipper liên tỉnh xe tải xuất phát từ {buuCucCan?.TenBuuCuc} chuyển hoàn về {d.BuuCucGui?.TenBuuCuc}" : laGiaoHoan ? $"Shipper khu vực của {d.BuuCucGui?.TenBuuCuc} giao hoàn tận nơi cho người gửi {d.KhachHang?.HoTen}" : lienTinh ? $"Shipper liên tỉnh xuất phát từ {d.BuuCucGui?.TenBuuCuc}" : $"Shipper khu vực của {d.BuuCucNhan?.TenBuuCuc}, phụ trách {d.KhuVuc?.TenKhuVuc}")
                    · mỗi shipper dùng phương tiện được gán cố định
                </div>
                <div class="row g-2">
                    @foreach (var nv in Model.DsNhanVien)
                    {
                        decimal conLai = nv.TaiTrong - nv.DangChoKg;
                        <div class="col-md-6">
                            <label class="border rounded-3 p-3 d-flex gap-2 h-100 @(nv.DuocChon ? "" : "opacity-50 bg-light")" style="cursor:@(nv.DuocChon ? "pointer" : "not-allowed")">
                                <input type="radio" class="form-check-input mt-1" name="MaNhanVien" value="@nv.MaNhanVien" disabled="@(!nv.DuocChon)" checked="@(Model.MaNhanVien == nv.MaNhanVien)" />
                                <span class="flex-grow-1">
                                    <span class="d-flex justify-content-between gap-2"><b>@nv.HoTen <span class="mo fw-normal nho">@nv.MaHienThi</span></b><span class="tt @nv.TrangThai.LopBadge()">@nv.TrangThai.TenHienThi()</span></span>
                                    @if (!lienTinh)
                                    {
                                        <span class="nho mo d-block">@(nv.KhuVuc ?? "Chưa phân khu vực") @if (nv.CungKhuVuc) { <span class="text-success fw-semibold">· đúng khu vực</span> }</span>
                                    }
                                    <span class="nho d-block"><i class="bi bi-truck-front"></i>
                                        @(nv.BienSo is null ? "Chưa gán phương tiện" : $"{nv.MaXe} · {nv.BienSo} · {nv.LoaiXe}")</span>
                                    @if (nv.BienSo is not null)
                                    {
                                        <span class="nho d-block">Đang giữ @nv.SoDonDangGiu đơn@(lienTinh ? "" : $" / {DonHangXuLy.SoDonToiDa}") · còn trống @DinhDang.KhoiLuong(Math.Max(0, conLai)) / @DinhDang.KhoiLuong(nv.TaiTrong)</span>
                                    }
                                    @if (nv.LyDoKhongChon is not null) { <span class="nho text-danger d-block"><i class="bi bi-x-circle"></i> @nv.LyDoKhongChon</span> }
                                </span>
                            </label>
                        </div>
                    }
                    @if (Model.DsNhanVien.Count == 0)
                    {
                        <div class="o-trong"><i class="bi bi-person-x"></i>@buuCucCan?.TenBuuCuc chưa có @(lienTinh ? "shipper liên tỉnh" : "shipper khu vực") nào</div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>
