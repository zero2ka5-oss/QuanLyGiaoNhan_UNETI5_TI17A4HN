@model ShipperDashboardViewModel
@{ ViewData["Title"] = "Tổng quan giao hàng"; }
<div class="mb-4"><p class="text-muted mb-1">Khu vực nhân viên giao hàng</p><h1>Xin chào, @Model.HoTen</h1><p class="lead">Theo dõi các đơn được phân công và cập nhật trạng thái giao hàng.</p></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted">Tổng phân công</div><div class="display-6">@Model.TongPhanCong</div></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted">Đang giao</div><div class="display-6">@Model.DonDangGiao</div></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted">Hoàn tất</div><div class="display-6">@Model.DonHoanTat</div></div></div></div></div>
<div class="card"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">Phân công gần đây</h2><a asp-controller="PhanCongGiaoHang" asp-action="Index">Xem tất cả</a></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Đơn</th><th>Người nhận</th><th>Địa chỉ</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model.PhanCongGanDay) {<tr><td>#@item.MaDon</td><td>@item.DonGiaoHang?.TenNguoiNhan</td><td>@item.DonGiaoHang?.DiaChiNhan</td><td>@item.TrangThai</td><td><a asp-controller="PhanCongGiaoHang" asp-action="Details" asp-route-id="@item.MaPhanCong">Cập nhật</a></td></tr>}</tbody></table></div></div></div>
