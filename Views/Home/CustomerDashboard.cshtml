@model CustomerDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan người gửi";
}

<section class="page-heading">
    <div class="page-heading-copy">
        <p class="eyebrow">Không gian người gửi</p>
        <h2>Xin chào, @Model.HoTen.</h2>
        <p>Mọi đơn hàng của bạn được gom lại tại đây để dễ theo dõi từ lúc tạo đơn đến khi hoàn tất.</p>
    </div>
    <a class="button button-primary" asp-controller="DonGiaoHang" asp-action="Create">Gửi đơn mới <span aria-hidden="true">↗</span></a>
</section>

<section class="metric-grid" aria-label="Tóm tắt đơn hàng">
    <article class="metric-card metric-primary"><span class="metric-label">Tổng đơn hàng</span><strong class="metric-value">@Model.TongDonHang</strong><span class="metric-foot">Tất cả đơn đã tạo</span></article>
    <article class="metric-card"><span class="metric-label">Chờ phân công</span><strong class="metric-value">@Model.DonChoPhanCong</strong><span class="metric-foot">Đang chờ xử lý</span></article>
    <article class="metric-card"><span class="metric-label">Đang giao</span><strong class="metric-value">@Model.DonDangGiao</strong><span class="metric-foot">Đang trên hành trình</span></article>
    <article class="metric-card"><span class="metric-label">Hoàn tất</span><strong class="metric-value">@Model.DonHoanTat</strong><span class="metric-foot">Đã giao thành công</span></article>
</section>

<section class="panel table-shell">
    <div class="panel-header">
        <div><h3>Đơn hàng gần đây</h3><p>Năm đơn mới nhất trong tài khoản của bạn</p></div>
        <a class="panel-link" asp-controller="DonGiaoHang" asp-action="Index">Xem tất cả <span aria-hidden="true">↗</span></a>
    </div>
    @if (Model.DonGanDay.Count == 0)
    {
        <div class="empty-state">Bạn chưa có đơn giao hàng nào. Hãy bắt đầu bằng một đơn mới.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Mã đơn</th><th>Người nhận</th><th>Ngày tạo</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                    @foreach (var order in Model.DonGanDay)
                    {
                        <tr>
                            <td><span class="table-id">#@order.MaDon</span></td>
                            <td>@order.TenNguoiNhan</td>
                            <td>@order.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="status-badge" data-status="@order.TrangThai">@order.TrangThai</span></td>
                            <td class="text-end"><a class="row-action" asp-controller="DonGiaoHang" asp-action="Details" asp-route-id="@order.MaDon">Chi tiết <span aria-hidden="true">↗</span></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
