@model CustomerDashboardViewModel
@{ ViewData["Title"] = "Tổng quan người gửi"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-muted mb-1">Khu vực khách hàng / người gửi</p><h1>Xin chào, @Model.HoTen</h1></div><a class="btn btn-primary" asp-controller="DonGiaoHang" asp-action="Create">+ Gửi đơn mới</a></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Tổng đơn</div><div class="display-6">@Model.TongDonHang</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Chờ phân công</div><div class="display-6">@Model.DonChoPhanCong</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Đang giao</div><div class="display-6">@Model.DonDangGiao</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Hoàn tất</div><div class="display-6">@Model.DonHoanTat</div></div></div></div></div>
<div class="card"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">Đơn gần đây</h2><a asp-controller="DonGiaoHang" asp-action="Index">Xem tất cả</a></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Mã đơn</th><th>Người nhận</th><th>Ngày tạo</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var order in Model.DonGanDay) {<tr><td>#@order.MaDon</td><td>@order.TenNguoiNhan</td><td>@order.NgayTao.ToString("dd/MM/yyyy HH:mm")</td><td>@order.TrangThai</td><td><a asp-controller="DonGiaoHang" asp-action="Details" asp-route-id="@order.MaDon">Chi tiết</a></td></tr>}</tbody></table></div></div></div>
