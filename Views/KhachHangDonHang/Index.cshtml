@model DanhSachDonVM
@{
    var bl = Model.BoLoc;
    ViewData["Title"] = "Đơn hàng của tôi";
    string TabUrl(TrangThaiDon? tt) => Url.Action("Index", new
    {
        TuKhoa = bl.TuKhoa, TrangThai = tt, MaLoaiHang = bl.MaLoaiHang, MaKhuVuc = bl.MaKhuVuc, LoaiNgay = bl.LoaiNgay,
        TuNgay = bl.TuNgay?.ToString("yyyy-MM-dd"), DenNgay = bl.DenNgay?.ToString("yyyy-MM-dd"), SapXep = bl.SapXep
    })!;
    var sapXepHienThi = new Dictionary<string, string>
    {
        ["ngay_moi"] = "Mới nhất", ["ngay_cu"] = "Cũ nhất", ["phi_giam"] = "Phí cao nhất", ["phi_tang"] = "Phí thấp nhất",
        ["kl_giam"] = "Nặng nhất", ["kl_tang"] = "Nhẹ nhất", ["ten_az"] = "Người nhận A → Z", ["ten_za"] = "Người nhận Z → A"
    };
    var so = Model.SoDonTheoTrangThai;
    int tong = so.Values.Sum();
    int dangXuLy = HienThi.NhomDangXuLy.Where(t => t != TrangThaiDon.GiaoKhongThanhCong).Sum(t => so.GetValueOrDefault(t));
    int daGiao = so.GetValueOrDefault(TrangThaiDon.GiaoThanhCong) + so.GetValueOrDefault(TrangThaiDon.HoanTat);
    int soLocNangCao = new object?[] { bl.MaLoaiHang, bl.MaKhuVuc, bl.TuNgay, bl.DenNgay }.Count(x => x is not null);
}

@* ---------- Đầu trang ---------- *@
<div class="kh-dau-trang dh-dau mb-4">
    <div class="flex-grow-1">
        <h2 class="h4 fw-bold mb-3">Quản lý đơn hàng</h2>
        <div class="dh-so-lieu">
            <div><b>@tong</b><span>Tổng đơn</span></div>
            <div><b>@dangXuLy</b><span>Đang xử lý</span></div>
            <div><b>@daGiao</b><span>Đã giao</span></div>
        </div>
    </div>
    <a asp-action="TaoMoi" class="btn btn-light btn-lg kh-nut-trang text-nowrap"><i class="bi bi-plus-circle"></i> Tạo đơn mới</a>
</div>

@if ((int?)ViewBag.SoDonNoCuoc > 0)
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 rounded-3 border-warning shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
            <span>Bạn đang có <b>@ViewBag.SoDonNoCuoc đơn hàng nợ cước</b> chưa thanh toán. Vui lòng thanh toán cước để tiếp tục tạo đơn mới.</span>
        </div>
        <a asp-action="CongNo" class="btn btn-warning btn-sm rounded-pill fw-bold px-3">
            <i class="bi bi-credit-card me-1"></i> Xem công nợ & Thanh toán
        </a>
    </div>
}

@* ---------- Tìm kiếm + bộ lọc ---------- *@
<form method="get" class="dh-loc mb-3" id="boLocDon">
    <input type="hidden" name="TrangThai" value="@bl.TrangThai" />
    <div class="dh-loc-dong">
        <div class="o-nhap flex-grow-1"><i class="bi bi-search"></i><input name="TuKhoa" value="@bl.TuKhoa" class="form-control" placeholder="Tìm mã đơn, tên hoặc số điện thoại người nhận" /></div>
        <button type="button" class="btn btn-light dh-nut-loc @(soLocNangCao > 0 ? "co-loc" : "")" data-bs-toggle="collapse" data-bs-target="#locNangCao" aria-expanded="@(soLocNangCao > 0 ? "true" : "false")">
            <i class="bi bi-sliders"></i> Bộ lọc @if (soLocNangCao > 0) { <span class="dh-dem">@soLocNangCao</span> }
        </button>
        <select name="SapXep" class="form-select dh-sap-xep" onchange="this.form.requestSubmit()" aria-label="Sắp xếp">
            @foreach (var (ma, ten) in sapXepHienThi) { <option value="@ma" selected="@(bl.SapXep == ma)">@ten</option> }
        </select>
        <button class="btn btn-cam px-4">Tìm</button>
    </div>
    <div class="collapse @(soLocNangCao > 0 ? "show" : "")" id="locNangCao">
        <div class="row g-2 pt-3 mt-3 border-top align-items-end">
            <div class="col-md-3 col-6"><label class="form-label nho">Loại hàng</label>
                <select name="MaLoaiHang" asp-items="ViewBag.DsLoaiHang" class="form-select"><option value="">Tất cả</option></select></div>
            <div class="col-md-3 col-6"><label class="form-label nho">Khu vực</label>
                <select name="MaKhuVuc" asp-items="ViewBag.DsKhuVuc" class="form-select"><option value="">Tất cả</option></select></div>
            <div class="col-md-4"><label class="form-label nho">Khoảng ngày</label>
                <div class="input-group">
                    <select name="LoaiNgay" class="form-select" style="max-width:120px">
                        <option value="tao" selected="@(bl.LoaiNgay != "giao")">Ngày tạo</option>
                        <option value="giao" selected="@(bl.LoaiNgay == "giao")">Ngày giao</option>
                    </select>
                    <input type="date" name="TuNgay" value="@bl.TuNgay?.ToString("yyyy-MM-dd")" class="form-control" title="Từ ngày" />
                    <input type="date" name="DenNgay" value="@bl.DenNgay?.ToString("yyyy-MM-dd")" class="form-control" title="Đến ngày" />
                </div></div>
            <div class="col-md-2 d-flex gap-2"><a asp-action="Index" class="btn btn-light flex-fill" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i> Xóa</a></div>
        </div>
    </div>
</form>

@* ---------- Tab trạng thái ---------- *@
<div class="dh-tab mb-3">
    <a class="@(bl.TrangThai is null ? "active" : "")" href="@TabUrl(null)"><i class="bi bi-grid"></i> Tất cả <span>@tong</span></a>
    @* 16 trạng thái: chỉ hiện tab có đơn (và tab đang chọn) *@
    @foreach (var tt in HienThi.TatCaTrangThaiDon.Where(t => so.GetValueOrDefault(t) > 0 || bl.TrangThai == t))
    {
        <a class="@(bl.TrangThai == tt ? "active" : "")" href="@TabUrl(tt)"><i class="bi @tt.BieuTuong()"></i> @tt.TenHienThi() <span>@so.GetValueOrDefault(tt)</span></a>
    }
</div>

@* ---------- Danh sách đơn ---------- *@
@if (Model.KetQua.TongSoDong > 0)
{
    <div class="nho mo mb-2">@Model.KetQua.TongSoDong đơn@(string.IsNullOrWhiteSpace(bl.TuKhoa) ? "" : $" khớp “{bl.TuKhoa}”")</div>
}
<div class="dh-ds">
    @foreach (var d in Model.KetQua.DanhSach)
    {
        int bac = d.TrangThai.BacHanhTrinh();
        bool treHan = d.NgayGiaoDuKien.Date < DateTime.Today && !d.TrangThai.DaKetThuc();
        <div class="dh-the @(d.TrangThai is TrangThaiDon.DaHuy or TrangThaiDon.ThatLac or TrangThaiDon.HuHong ? "da-huy" : "")">
            <a asp-action="ChiTiet" asp-route-id="@d.MaDon" class="dh-the-chinh">
                <span class="dh-icon @d.TrangThai.LopBadge()"><i class="bi @d.TrangThai.BieuTuong()"></i></span>
                <div class="dh-giua">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <b class="dh-ma">@d.MaHienThi</b>
                        <span class="tt @d.TrangThai.LopBadge()">@d.TrangThai.TenHienThi()</span>
                        @if (d.HinhThucGui == HinhThucGui.LayTanNoi) { <span class="badge bg-light text-secondary border nho">Lấy tận nơi</span> }
                        @if (treHan) { <span class="tt tt-thatbai"><i class="bi bi-alarm"></i> Trễ hẹn</span> }
                    </div>
                    <div class="dh-nguoi-nhan"><i class="bi bi-person"></i> @d.TenNguoiNhan <span class="mo">· @DinhDang.SoDienThoai(d.SoDienThoaiNguoiNhan)</span></div>
                    <div class="nho mo text-truncate"><i class="bi bi-geo-alt"></i> @d.KhuVuc?.TenKhuVuc · @d.LoaiHang?.TenLoaiHang · @DinhDang.KhoiLuong(d.KhoiLuong)</div>
                    @if (d.TrangThai is not (TrangThaiDon.DaHuy or TrangThaiDon.ThatLac or TrangThaiDon.HuHong))
                    {
                        <partial name="_TienDoNgan" model="d.TrangThai" />
                    }
                </div>
                <div class="dh-phai">
                    <div class="dh-phi">@DinhDang.Tien(d.PhiVanChuyen)</div>
                    @if (d.TienThuHo > 0) { <div class="dh-thu-ho">Thu hộ @DinhDang.Tien(d.TienThuHo)</div> }
                    <div class="dh-ngay"><span>Tạo @d.NgayTao.ToString("dd/MM")</span><span class="@(treHan ? "text-danger fw-semibold" : "")">Giao @d.NgayGiaoDuKien.ToString("dd/MM")</span></div>
                </div>
            </a>
            <div class="dh-hanh-dong">
                @if (DonHangXuLy.CoTheSua(d, true))
                {
                    <a asp-action="ChinhSua" asp-route-id="@d.MaDon" class="btn btn-sm btn-light" title="Sửa đơn"><i class="bi bi-pencil"></i><span class="d-none d-sm-inline"> Sửa</span></a>
                }
                <a asp-action="ChiTiet" asp-route-id="@d.MaDon" class="btn btn-sm btn-light" title="Chi tiết"><i class="bi bi-chevron-right"></i></a>
            </div>
        </div>
    }
</div>

@if (Model.KetQua.TongSoDong == 0)
{
    <div class="tc-trong">
        <div class="tc-trong-icon"><i class="bi bi-inbox"></i></div>
        @if (tong == 0 && string.IsNullOrWhiteSpace(bl.TuKhoa) && soLocNangCao == 0)
        {
            <h2 class="h5 fw-bold mb-1">Bạn chưa có đơn hàng nào</h2>
            <p class="mo mb-3">Tạo đơn đầu tiên, phí được tính ngay khi nhập thông tin</p>
            <a asp-action="TaoMoi" class="btn btn-cam rounded-pill px-4"><i class="bi bi-plus-circle"></i> Tạo đơn đầu tiên</a>
        }
        else
        {
            <h2 class="h5 fw-bold mb-1">Không có đơn phù hợp</h2>
            <p class="mo mb-3">Thử từ khóa khác hoặc bỏ bớt điều kiện lọc</p>
            <a asp-action="Index" class="btn btn-cam rounded-pill px-4">Xem tất cả đơn</a>
        }
    </div>
}
<partial name="_PhanTrang" model="Model.KetQua" />
