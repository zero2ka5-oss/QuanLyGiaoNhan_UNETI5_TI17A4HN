function escapeHtml(text) {
    if (!text) return '';
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
}

function formatMarkdown(text) {
    if (!text) return '';
    let s = escapeHtml(text);
    // **bold**
    s = s.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
    // `code`
    s = s.replace(/`(.*?)`/g, '<code class="bg-light px-1 rounded text-danger">$1</code>');
    // newlines
    s = s.replace(/\n\n/g, '<div class="my-2"></div>');
    s = s.replace(/\n/g, '<br/>');
    return s;
}
