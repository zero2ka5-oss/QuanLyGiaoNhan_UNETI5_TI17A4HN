@model TongQuanKhachHangVM
@* Công nợ phí người gửi: đơn đã đối soát nhưng phí ship (người gửi trả) không trừ hết được vào tiền thu hộ.
   Dùng ở KhachHangTrangChu (khách xem) và QuanTriKhachHang/ChiTiet (ViewData["PhiaQuanTri"] = true → link sang trang quản trị). *@
@{
    bool phiaQuanTri = ViewData["PhiaQuanTri"] as bool? == true;
    string controller = phiaQuanTri ? "QuanTriDonGiaoHang" : "KhachHangDonHang";
}
@if (Model.DonNoPhi.Count > 0)
{
    <div class="alert alert-warning mb-4">
        <div class="d-flex align-items-center gap-2 fw-semibold"><i class="bi bi-receipt"></i>
            @(phiaQuanTri ? "Khách còn nợ" : "Phí vận chuyển cần thanh toán"): @DinhDang.Tien(Model.CongNoPhi) (@Model.DonNoPhi.Count đơn)</div>
        <div class="nho mt-1">@(phiaQuanTri
            ? "Phí ship do người gửi trả nhưng tiền thu hộ không đủ để trừ. Bấm vào đơn để xác nhận đã thu phí."
            : "Các đơn dưới đây bạn chọn tự trả phí ship nhưng tiền thu hộ không đủ để trừ. Vui lòng thanh toán cho công ty (chuyển khoản hoặc tại bưu cục).")</div>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            @foreach (var d in Model.DonNoPhi)
            {
                <a asp-controller="@controller" asp-action="ChiTiet" asp-route-id="@d.MaDon" class="badge rounded-pill text-bg-light border text-decoration-none">@d.MaHienThi · @DinhDang.Tien(d.PhiNguoiGuiPhaiTra)</a>
            }
            @if (!phiaQuanTri)
            {
                <a asp-controller="KhachHangDonHang" asp-action="CongNo" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold ms-auto"><i class="bi bi-credit-card me-1"></i> Thanh toán công nợ</a>
            }
        </div>
    </div>
}
