@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string A(string c, string? a = null) => ctrl == c && (a is null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_TaiNguyenDau" />
    <meta name="theme-color" content="#F26522">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="app-nv">
    <div class="thanh-app d-flex align-items-center gap-2">
        @if ((ViewData["QuayLai"] as string ?? (ViewContext.RouteData.Values["controller"]?.ToString() == "DangNhap" ? Url.Action("Index", "NhanVienHoSo") : null)) is string quayLai)
        {
            <a href="@quayLai" class="fs-4 me-1" aria-label="Quay lại"><i class="bi bi-arrow-left"></i></a>
        }
        <a asp-controller="NhanVienHoSo" asp-action="Index" class="flex-shrink-0">@HienThi.AnhDaiDien(Context.Session.AnhDaiDien(), Context.Session.HoTen(), "avt avt-sm avt-xanh avt-vien")</a>
        <div class="flex-grow-1 lh-sm min-w-0">
            <div class="fw-bold text-truncate">@(ViewData["Title"] ?? "GiaoNhanh")</div>
            <div class="nho opacity-75 text-truncate">@Context.Session.HoTen()</div>
        </div>
        <button type="button" class="nut-theme" onclick="doiTheme()" title="Chuyển chế độ Sáng / Tối" aria-label="Đổi giao diện"><i class="bi bi-moon-stars"></i></button>
        @await Component.InvokeAsync("ChuongThongBao", new { nen = true })
        <form asp-controller="DangNhap" asp-action="DangXuat" method="post">
            <button class="btn btn-sm btn-light text-danger" title="Đăng xuất"><i class="bi bi-box-arrow-right"></i></button>
        </form>
    </div>
    @* Chia sẻ vị trí GPS: vị trí của các đơn shipper đang giữ (khách xem trên bản đồ) – shipper tự bật / tắt *@
    <div class="thanh-vi-tri">
        @Html.AntiForgeryToken()
        <button type="button" id="nutViTri" class="nut-vi-tri"><i class="bi bi-geo-alt"></i> Bật chia sẻ vị trí</button>
    </div>
    <div class="than">
        <partial name="_ThongBao" />
        @RenderBody()
    </div>
    <nav class="thanh-tab-duoi">
        <a class="@(ctrl == "NhanVienCongViec" && action != "Quet" ? "active" : "")" asp-controller="NhanVienCongViec" asp-action="Index"><i class="bi bi-list-check"></i>Công việc</a>
        <a class="@A("NhanVienCongViec", "Quet")" asp-controller="NhanVienCongViec" asp-action="Quet"><i class="bi bi-qr-code-scan"></i>Quét mã</a>
        <a class="@A("NhanVienLichSu")" asp-controller="NhanVienLichSu" asp-action="Index"><i class="bi bi-clock-history"></i>Lịch sử</a>
        <a class="@A("NhanVienVi")" asp-controller="NhanVienVi" asp-action="Index"><i class="bi bi-wallet2"></i>Ví</a>
        <a class="@A("NhanVienHoSo")@A("DangNhap", "DoiMatKhau")" asp-controller="NhanVienHoSo" asp-action="Index"><i class="bi bi-person-circle"></i>Hồ sơ</a>
    </nav>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/van-chuyen.js" asp-append-version="true"></script>
<script>chiaSeViTri('nutViTri', '@Url.Action("CapNhatViTri", "NhanVienCongViec")');</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
