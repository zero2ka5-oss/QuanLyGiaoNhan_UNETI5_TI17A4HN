@model ChiTietDonVM
@* Các chặng của đơn (liên tỉnh / khu vực / giao lại / đổi shipper) – mỗi chặng ghi shipper và phương tiện được gán. *@
@{ var pc = Model.PhanCongHienTai; bool anTen = ViewData["AnLienHe"] is true; }
<div class="the-mem p-4 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-signpost-split text-cam"></i> Các chặng vận chuyển</h6>
        <span class="nho mo">@Model.DsPhanCong.Count lần phân công</span>
    </div>
    @if (pc is not null)
    {
        <div class="border rounded-3 p-3 mb-3 bg-cam-nhat">
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <div>
                    <div class="nho mo">Đang thực hiện · @pc.LoaiChang.TenChang()</div>
                    <div class="fw-bold"><i class="bi bi-person-badge"></i> @pc.NhanVien?.HoTen <span class="nho mo fw-normal">@pc.NhanVien?.MaHienThi</span>
                        @if (!anTen) { <a href="tel:@pc.NhanVien?.SoDienThoai" class="nho ms-1">@DinhDang.SoDienThoai(pc.NhanVien?.SoDienThoai)</a> }</div>
                    <div class="nho"><i class="bi bi-truck-front"></i> @pc.PhuongTien?.MaHienThi · @pc.PhuongTien?.LoaiPhuongTien · @pc.PhuongTien?.BienSo</div>
                </div>
                <span class="tt @pc.TrangThai.LopBadge() align-self-start">@pc.TrangThai.TenHienThi()</span>
            </div>
        </div>
    }
    @if (Model.DsPhanCong.Count == 0)
    {
        <div class="mo nho">Đơn chưa được phân shipper.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm bang bang-chang">
                <thead><tr><th>Chặng</th><th>Shipper / phương tiện</th><th>Thời gian</th><th>Kết quả</th></tr></thead>
                <tbody>
                @foreach (var p in Model.DsPhanCong)
                {
                    <tr>
                        <td class="nho text-nowrap"><span class="tt @(p.LoaiChang == LoaiShipper.LienTinh ? "tt-dang" : "tt-xuly")">@p.LoaiChang.TenChang().Replace("Chặng ", "")</span><div class="mo">#@p.MaPhanCong</div></td>
                        <td class="fw-medium">@p.NhanVien?.HoTen<div class="nho mo fw-normal">@p.PhuongTien?.MaHienThi · @p.PhuongTien?.BienSo</div></td>
                        <td class="nho text-nowrap lh-sm">
                            <div><span class="mo">Phân công</span> @DinhDang.NgayGio(p.NgayPhanCong)</div>
                            @if (p.NgayNhanHang.HasValue) { <div><span class="mo">Nhận hàng</span> @DinhDang.NgayGio(p.NgayNhanHang)</div> }
                            @if (p.NgayBatDauGiao.HasValue) { <div><span class="mo">Xuất phát</span> @DinhDang.NgayGio(p.NgayBatDauGiao)</div> }
                            @if (p.NgayKetThuc.HasValue) { <div><span class="mo">Kết thúc</span> @DinhDang.NgayGio(p.NgayKetThuc)</div> }
                        </td>
                        <td>
                            @if (p.KetQua.HasValue)
                            {
                                <span class="tt @(p.KetQua is KetQuaGiao.GiaoThanhCong or KetQuaGiao.DaBanGiaoBuuCuc or KetQuaGiao.DaLayHang ? "tt-thanhcong" : p.KetQua is KetQuaGiao.GiaoKhongThanhCong or KetQuaGiao.SuCo ? "tt-thatbai" : "tt-huy")">@p.KetQua.Value.TenHienThi()</span>
                                @if (p.LyDoThatBai.HasValue) { <div class="nho text-danger">@p.LyDoThatBai.Value.TenHienThi()</div> }
                            }
                            else { <span class="tt @p.TrangThai.LopBadge()">@p.TrangThai.TenHienThi()</span> }
                            @if (!string.IsNullOrEmpty(p.GhiChu)) { <div class="nho mo">@p.GhiChu</div> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
