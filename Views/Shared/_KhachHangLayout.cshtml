@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string A(string c, string? a = null) => ctrl == c && (a is null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_TaiNguyenDau" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="khung">
    <aside class="thanh-ben sb-sang">
        <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="menuBen">
            <div class="px-4 pt-4 pb-3 d-flex align-items-center justify-content-between">
                <a class="logo" asp-controller="KhachHangTrangChu" asp-action="Index"><span class="bieu-tuong"><i class="bi bi-truck"></i></span>GiaoNhanh</a>
                <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#menuBen" aria-label="Đóng"></button>
            </div>
            <div class="px-3 pb-2">
                <a class="btn btn-cam w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" asp-controller="KhachHangDonHang" asp-action="TaoMoi"><i class="bi bi-plus-circle"></i> Tạo đơn giao hàng</a>
            </div>
            <nav class="pb-2">
                <div class="nhom">Quản lý</div>
                <a class="muc @A("KhachHangTrangChu")" asp-controller="KhachHangTrangChu" asp-action="Index"><i class="bi bi-house"></i> Tổng quan</a>
                <a class="muc @A("KhachHangDonHang", "Index")@A("KhachHangDonHang", "ChiTiet")@A("KhachHangDonHang", "ChinhSua")" asp-controller="KhachHangDonHang" asp-action="Index"><i class="bi bi-box-seam"></i> Đơn hàng của tôi</a>
                <a class="muc @A("KhachHangDonHang", "TaoMoi")" asp-controller="KhachHangDonHang" asp-action="TaoMoi"><i class="bi bi-pencil-square"></i> Tạo đơn mới</a>
                <a class="muc @A("KhachHangDonHang", "CongNo")" asp-controller="KhachHangDonHang" asp-action="CongNo"><i class="bi bi-credit-card-2-back"></i> Công nợ cước</a>
                <div class="nhom">Tài khoản</div>
                <a class="muc @A("KhachHangHoSo")" asp-controller="KhachHangHoSo" asp-action="Index"><i class="bi bi-person-vcard"></i> Thông tin cá nhân</a>
                <a class="muc @A("DangNhap", "DoiMatKhau")" asp-controller="DangNhap" asp-action="DoiMatKhau"><i class="bi bi-shield-lock"></i> Mật khẩu & bảo mật</a>
                <div class="nhom">Tiện ích</div>
                <a class="muc @A("KhachHangTienIch", "BangGia")" asp-controller="KhachHangTienIch" asp-action="BangGia"><i class="bi bi-calculator"></i> Bảng giá & ước lượng</a>
                <a class="muc @A("KhachHangTienIch", "TraCuu")" asp-controller="KhachHangTienIch" asp-action="TraCuu"><i class="bi bi-search"></i> Tra cứu đơn</a>
            </nav>
            <div class="the-ho-tro">
                <div class="fw-bold mb-1"><i class="bi bi-headset text-cam"></i> Cần hỗ trợ?</div>
                <div class="nho mo mb-2">Tổng đài CSKH hoạt động 7:00 – 21:00 mỗi ngày.</div>
                <a href="tel:19001515" class="fw-bold">1900 1515</a>
            </div>
        </div>
    </aside>

    <div class="noi-dung-chinh">
        <header class="thanh-tren d-flex align-items-center gap-3">
            <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuBen" aria-label="Mở menu"><i class="bi bi-list"></i></button>
            <partial name="_NutQuayLai" />
            <div class="flex-grow-1 min-w-0">
                <div class="duong-dan d-none d-sm-flex">Khách hàng <i class="bi bi-chevron-right"></i> @(ctrl == "KhachHangDonHang" ? "Đơn hàng" : ctrl == "KhachHangTrangChu" ? "Tổng quan" : ctrl == "KhachHangTienIch" ? "Tiện ích" : "Tài khoản")</div>
                <h1 class="tieu-de-trang text-truncate">@ViewData["Title"]</h1>
            </div>
            <div class="dropdown">
                <button class="nut-tai-khoan dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    @HienThi.AnhDaiDien(Context.Session.AnhDaiDien(), Context.Session.HoTen(), "avt avt-sm")
                    <span class="d-none d-sm-inline text-start lh-sm"><span class="fw-semibold nho d-block">@Context.Session.HoTen()</span><span class="mo" style="font-size:.74rem">Khách hàng</span></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-controller="KhachHangHoSo" asp-action="Index"><i class="bi bi-person-vcard me-1"></i> Thông tin cá nhân</a></li>
                    <li><a class="dropdown-item" asp-controller="DangNhap" asp-action="DoiMatKhau"><i class="bi bi-key me-1"></i> Đổi mật khẩu</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="DangNhap" asp-action="DangXuat" method="post">
                            <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-1"></i> Đăng xuất</button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>
        <main class="vung-noi-dung">
            <partial name="_ThongBao" />
            @RenderBody()
        </main>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/tinh-phi.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
