@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Thanh tiến độ ngắn 4 đoạn (Tạo đơn · Lấy hàng · Đang giao · Đã giao) trên thẻ đơn của khách hàng.
                       Đoạn đã qua màu xanh, đoạn đang chờ màu cam nhấp nháy, giao lỗi màu đỏ. *@
@model TrangThaiDon
@{ int bac = Model.BacHanhTrinh(); bool loi = Model == TrangThaiDon.GiaoKhongThanhCong; bool daDanhDau = false; }
<div class="kh-tien-do">
    @foreach (int moc in new[] { 0, 2, 3, 4 })
    {
        string lop = bac >= moc ? "xong" : daDanhDau ? "" : (loi ? "loi" : "hien-tai");
        if (bac < moc) daDanhDau = true;
        <span class="@lop"></span>
    }
</div>
