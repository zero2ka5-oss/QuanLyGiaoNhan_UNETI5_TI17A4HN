@model DanhSachDonVM
@{
    var bl = Model.BoLoc;
    ViewData["Title"] = "Đơn giao hàng";
    string TabUrl(TrangThaiDon? tt) => Url.Action("Index", new
    {
        TuKhoa = bl.TuKhoa, TrangThai = tt, MaLoaiHang = bl.MaLoaiHang, MaKhuVuc = bl.MaKhuVuc, LoaiNgay = bl.LoaiNgay,
        TuNgay = bl.TuNgay?.ToString("yyyy-MM-dd"), DenNgay = bl.DenNgay?.ToString("yyyy-MM-dd"), SapXep = bl.SapXep
    })!;
    string SortUrl(string tang, string giam) => Url.Action("Index", new
    {
        TuKhoa = bl.TuKhoa, TrangThai = bl.TrangThai, MaLoaiHang = bl.MaLoaiHang, MaKhuVuc = bl.MaKhuVuc, LoaiNgay = bl.LoaiNgay,
        TuNgay = bl.TuNgay?.ToString("yyyy-MM-dd"), DenNgay = bl.DenNgay?.ToString("yyyy-MM-dd"), SapXep = bl.SapXep == tang ? giam : tang
    })!;
    string MuiTen(string tang, string giam) => bl.SapXep == tang ? "bi-sort-up" : bl.SapXep == giam ? "bi-sort-down" : "bi-arrow-down-up opacity-25";
    var sapXepHienThi = new Dictionary<string, string>
    {
        ["ngay_moi"] = "Ngày tạo: mới → cũ", ["ngay_cu"] = "Ngày tạo: cũ → mới", ["kl_tang"] = "Khối lượng tăng dần", ["kl_giam"] = "Khối lượng giảm dần",
        ["phi_tang"] = "Phí tăng dần", ["phi_giam"] = "Phí giảm dần", ["ten_az"] = "Người nhận A → Z", ["ten_za"] = "Người nhận Z → A"
    };
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div class="tab-trang-thai flex-grow-1">
        <a class="@(bl.TrangThai is null ? "active" : "")" href="@TabUrl(null)">Tất cả <span class="so">@Model.SoDonTheoTrangThai.Values.Sum()</span></a>
        @foreach (var tt in HienThi.TatCaTrangThaiDon.Where(t => Model.SoDonTheoTrangThai.GetValueOrDefault(t) > 0 || bl.TrangThai == t))
        {
            <a class="@(bl.TrangThai == tt ? "active" : "")" href="@TabUrl(tt)">@tt.TenHienThi() <span class="so">@Model.SoDonTheoTrangThai.GetValueOrDefault(tt)</span></a>
        }
    </div>
</div>

<form method="get" class="thanh-loc mb-3">
    <input type="hidden" name="TrangThai" value="@bl.TrangThai" />
    <div class="row g-2 align-items-end">
        <div class="col-xl-4 col-md-6">
            <label class="form-label nho">Tìm kiếm</label>
            <div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input name="TuKhoa" value="@bl.TuKhoa" class="form-control" placeholder="Mã đơn, người nhận, số điện thoại, khách hàng" /></div>
        </div>
        <div class="col-xl-2 col-md-3">
            <label class="form-label nho">Loại hàng</label>
            <select name="MaLoaiHang" asp-items="ViewBag.DsLoaiHang" class="form-select"><option value="">Tất cả</option></select>
        </div>
        <div class="col-xl-2 col-md-3">
            <label class="form-label nho">Khu vực</label>
            <select name="MaKhuVuc" asp-items="ViewBag.DsKhuVuc" class="form-select"><option value="">Tất cả</option></select>
        </div>
        <div class="col-xl-2 col-md-6">
            <label class="form-label nho">Bưu cục</label>
            <select name="MaBuuCuc" asp-items="ViewBag.DsBuuCuc" class="form-select"><option value="">Tất cả</option></select>
        </div>
        <div class="col-xl-2 col-md-6">
            <label class="form-label nho">Sắp xếp</label>
            <select name="SapXep" class="form-select">
                @foreach (var (ma, ten) in sapXepHienThi) { <option value="@ma" selected="@(bl.SapXep == ma)">@ten</option> }
            </select>
        </div>
        <div class="col-xl-6 col-md-8">
            <label class="form-label nho">Khoảng ngày</label>
            <div class="input-group">
                <select name="LoaiNgay" class="form-select" style="max-width: 125px">
                    <option value="tao" selected="@(bl.LoaiNgay != "giao")">Ngày tạo</option>
                    <option value="giao" selected="@(bl.LoaiNgay == "giao")">Ngày giao dự kiến</option>
                </select>
                <input type="date" name="TuNgay" value="@bl.TuNgay?.ToString("yyyy-MM-dd")" class="form-control" title="Từ ngày" />
                <input type="date" name="DenNgay" value="@bl.DenNgay?.ToString("yyyy-MM-dd")" class="form-control" title="Đến ngày" />
            </div>
        </div>
        <div class="col-xl col-md-4 d-flex gap-2 justify-content-end text-nowrap">
            <a asp-action="Index" class="btn btn-light"><i class="bi bi-x-lg"></i> Xóa bộ lọc</a>
            <button class="btn btn-cam px-4"><i class="bi bi-funnel"></i> Áp dụng</button>
        </div>
    </div>
</form>

<div class="the-mem">
    <div class="table-responsive">
        <table class="table bang">
            <thead>
            <tr>
                <th>Đơn / Khách gửi</th>
                <th><a class="text-reset" href="@SortUrl("ten_az", "ten_za")">Người nhận <i class="bi @MuiTen("ten_az", "ten_za")"></i></a></th>
                <th>Loại hàng / Tuyến</th>
                <th class="text-end"><a class="text-reset" href="@SortUrl("kl_tang", "kl_giam")">Khối lượng <i class="bi @MuiTen("kl_tang", "kl_giam")"></i></a></th>
                <th class="text-end"><a class="text-reset" href="@SortUrl("phi_tang", "phi_giam")">Phí <i class="bi @MuiTen("phi_tang", "phi_giam")"></i></a></th>
                <th>Trạng thái</th>
                <th><a class="text-reset" href="@SortUrl("ngay_cu", "ngay_moi")">Thời gian <i class="bi @MuiTen("ngay_cu", "ngay_moi")"></i></a></th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var d in Model.KetQua.DanhSach)
            {
                <tr>
                    <td class="text-nowrap"><a asp-action="ChiTiet" asp-route-id="@d.MaDon" class="fw-bold">@d.MaHienThi</a>
                        @if (d.HinhThucGui == HinhThucGui.LayTanNoi) { <span class="badge bg-light text-secondary border nho ms-1">Lấy tận nơi</span> }
                        <div class="nho"><a asp-controller="QuanTriKhachHang" asp-action="ChiTiet" asp-route-id="@d.MaKhachHang" class="ten fw-normal mo">@d.KhachHang?.HoTen</a></div></td>
                    <td class="text-nowrap">@d.TenNguoiNhan<div class="nho mo">@DinhDang.SoDienThoai(d.SoDienThoaiNguoiNhan)</div></td>
                    <td class="nho">@d.LoaiHang?.TenLoaiHang<div class="mo text-nowrap">@(d.BuuCucGui?.TenBuuCuc.Replace("Bưu cục ", "") ?? "?") → @(d.BuuCucNhan?.TenBuuCuc.Replace("Bưu cục ", "") ?? "?")</div></td>
                    <td class="text-end text-nowrap">@DinhDang.KhoiLuong(d.KhoiLuong)</td>
                    <td class="text-end fw-semibold text-nowrap">@DinhDang.Tien(d.PhiVanChuyen)@if (d.TienThuHo > 0) { <div class="nho mo fw-normal">Thu hộ @DinhDang.Tien(d.TienThuHo)</div> }</td>
                    <td><span class="tt @d.TrangThai.LopBadge()"><i class="bi @d.TrangThai.BieuTuong()"></i> @d.TrangThai.TenHienThi()</span></td>
                    <td class="nho text-nowrap"><span class="mo">Tạo</span> @d.NgayTao.ToString("dd/MM HH:mm")<div><span class="mo">Giao</span> @DinhDang.Ngay(d.NgayGiaoDuKien)</div></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="ChiTiet" asp-route-id="@d.MaDon" class="btn btn-sm btn-light" title="Chi tiết"><i class="bi bi-eye"></i></a>
                        @if (DonHangXuLy.CoTheSua(d, false))
                        {
                            <a asp-action="ChinhSua" asp-route-id="@d.MaDon" class="btn btn-sm btn-light" title="Sửa"><i class="bi bi-pencil"></i></a>
                        }
                        @if (DonHangXuLy.ChangCanPhanCong(d) is not null)
                        {
                            <a asp-controller="QuanTriPhanCong" asp-action="TaoMoi" asp-route-maDon="@d.MaDon" class="btn btn-sm btn-cam" title="Phân công"><i class="bi bi-person-plus"></i></a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.KetQua.TongSoDong == 0)
    {
        <div class="o-trong"><i class="bi bi-inbox"></i>Không có đơn phù hợp với điều kiện tìm kiếm.</div>
    }
</div>
<partial name="_PhanTrang" model="Model.KetQua" />
