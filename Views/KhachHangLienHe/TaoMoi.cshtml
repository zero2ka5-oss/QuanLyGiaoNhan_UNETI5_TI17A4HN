@model TaoLienHeVM
@{
    ViewData["Title"] = "Gửi yêu cầu hỗ trợ";
    var dsDonHang = ViewBag.DsDonHang as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var dsBuuCuc = ViewBag.DsBuuCuc as IEnumerable<BuuCuc> ?? Enumerable.Empty<BuuCuc>();
}

<div class="row g-4 justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="the-mem p-4 shadow-sm border rounded-3 bg-white">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="rounded-circle bg-cam bg-opacity-10 text-cam d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-chat-heart fs-4"></i>
                </div>
                <div>
                    <h3 class="h5 fw-bold mb-1">Gửi yêu cầu giải đáp & Khiếu nại</h3>
                    <p class="mo nho mb-0">Đội ngũ CSKH và Điều phối sẽ tiếp nhận và phản hồi bạn trong thời gian sớm nhất.</p>
                </div>
            </div>

            <form asp-action="TaoMoi" method="post" id="formTaoLienHe">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="ChuDe" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <select asp-for="ChuDe" class="form-select" id="selectChuDe">
                            @foreach (ChuDeLienHe cd in Enum.GetValues<ChuDeLienHe>())
                            {
                                <option value="@cd">@cd.TenHienThi()</option>
                            }
                        </select>
                        <span asp-validation-for="ChuDe" class="text-danger nho"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="MaDonHang" class="form-label fw-semibold"></label>
                        <select asp-for="MaDonHang" class="form-select">
                            <option value="">-- Không gắn với đơn cụ thể --</option>
                            @foreach (var d in dsDonHang)
                            {
                                <option value="@d.MaDon" selected="@(Model.MaDonHang == (int)d.MaDon)">
                                    @d.MaHienThi - Giao: @d.TenNguoiNhan (@(((DateTime)d.NgayTao).ToString("dd/MM")))
                                </option>
                            }
                        </select>
                        <span asp-validation-for="MaDonHang" class="text-danger nho"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="MaBuuCuc" class="form-label fw-semibold"></label>
                    <select asp-for="MaBuuCuc" class="form-select">
                        <option value="">-- Để hệ thống tự động điều phối bưu cục phù hợp --</option>
                        @foreach (var bc in dsBuuCuc)
                        {
                            <option value="@bc.MaBuuCuc" selected="@(Model.MaBuuCuc == bc.MaBuuCuc)">
                                @bc.TenBuuCuc (@bc.TinhThanh) - @bc.DiaChi
                            </option>
                        }
                    </select>
                    <div class="form-text nho">Nếu thắc mắc liên quan trực tiếp đến bưu cục gửi hoặc nhận, bạn có thể chọn bưu cục để nhân viên tại đó phản hồi nhanh hơn.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="TieuDe" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="TieuDe" class="form-control" placeholder="Ví dụ: Xin kiểm tra lại tiền cước đơn DH... / Muốn đổi số điện thoại người nhận..." />
                    <span asp-validation-for="TieuDe" class="text-danger nho"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NoiDung" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <textarea asp-for="NoiDung" rows="5" class="form-control" placeholder="Mô tả chi tiết thắc mắc, câu hỏi hoặc sự cố bạn đang gặp phải..."></textarea>
                    <span asp-validation-for="NoiDung" class="text-danger nho"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-cam rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-send me-1"></i> Gửi yêu cầu hỗ trợ
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="the-mem p-4 shadow-sm border rounded-3 bg-white mb-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-success"></i> Cam kết hỗ trợ
            </h5>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-3 nho">
                <li class="d-flex align-items-start gap-2">
                    <i class="bi bi-lightning-charge-fill text-warning fs-6"></i>
                    <div><b>Phản hồi nhanh chóng:</b> Nhân viên trực bưu cục và CSKH tiếp nhận xử lý trong vòng 15–30 phút trong giờ làm việc.</div>
                </li>
                <li class="d-flex align-items-start gap-2">
                    <i class="bi bi-bell-fill text-primary fs-6"></i>
                    <div><b>Thông báo tức thì:</b> Bạn sẽ nhận được chuông thông báo ngay khi có phản hồi từ nhân viên.</div>
                </li>
                <li class="d-flex align-items-start gap-2">
                    <i class="bi bi-telephone-fill text-cam fs-6"></i>
                    <div><b>Trường hợp khẩn cấp:</b> Vui lòng gọi trực tiếp hotline <a href="tel:19001515" class="fw-bold text-decoration-none">1900 1515</a> để được xử lý ngay lập tức.</div>
                </li>
            </ul>
        </div>

        <div class="p-3 rounded-3 bg-light border">
            <h6 class="fw-bold mb-2"><i class="bi bi-info-circle me-1"></i> Mẹo gửi yêu cầu</h6>
            <p class="mo nho mb-0">Hãy đính kèm mã đơn hàng liên quan để nhân viên bưu cục tra cứu lịch sử hành trình và shipper phụ trách một cách chính xác nhất.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
