@model YeuCauLienHe
@{
    ViewData["Title"] = $"Yêu cầu {Model.MaHienThi}";
    bool daDong = Model.TrangThai == TrangThaiLienHe.DaDong;
}

<div class="row g-4">
    @* ---------- Cột trái: Luồng trao đổi / Chat Thread ---------- *@
    <div class="col-12 col-lg-8">
        @* Thẻ tiêu đề yêu cầu *@
        <div class="the-mem p-4 shadow-sm border rounded-3 bg-white mb-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-light text-dark border fw-bold px-2 py-1 fs-6">@Model.MaHienThi</span>
                    <span class="tt @Model.TrangThai.LopBadge()">
                        <i class="bi @Model.TrangThai.BieuTuong() me-1"></i>@Model.TrangThai.TenHienThi()
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis px-2 py-1">
                        <i class="bi bi-tag me-1"></i>@Model.ChuDe.TenHienThi()
                    </span>
                </div>
                <div>
                    @if (!daDong)
                    {
                        <form asp-action="DongYeuCau" asp-route-id="@Model.MaLienHe" method="post" class="d-inline" data-xac-nhan="Bạn có chắc chắn muốn đóng yêu cầu hỗ trợ này khi đã được giải đáp thỏa đáng?">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                <i class="bi bi-check-circle me-1"></i> Đóng yêu cầu
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                            <i class="bi bi-check2-all me-1"></i> Đã giải quyết xong
                        </span>
                    }
                </div>
            </div>

            <h4 class="fw-bold mb-2 text-dark">@Model.TieuDe</h4>
            <div class="text-muted nho d-flex align-items-center gap-3 flex-wrap">
                <span><i class="bi bi-calendar-event me-1"></i>Khởi tạo: @DinhDang.NgayGio(Model.NgayGui)</span>
                @if (Model.NgayCapNhat.HasValue)
                {
                    <span><i class="bi bi-clock-history me-1"></i>Cập nhật: @DinhDang.NgayGio(Model.NgayCapNhat)</span>
                }
            </div>
        </div>

        @* Lịch sử tin nhắn trao đổi *@
        <div class="the-mem p-4 shadow-sm border rounded-3 bg-white mb-4">
            <h5 class="fw-bold mb-4 pb-2 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-chat-dots-fill text-cam"></i> Lịch sử trao đổi (@Model.TinNhans.Count tin nhắn)
            </h5>

            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var tin in Model.TinNhans)
                {
                    var laNV = tin.LaNhanVien;
                    <div class="d-flex gap-3 @(laNV ? "" : "flex-row-reverse")">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0 @(laNV ? "bg-primary" : "bg-cam")" style="width: 40px; height: 40px; font-weight: bold;">
                            <i class="bi @(laNV ? "bi-headset" : "bi-person") fs-5"></i>
                        </div>

                        <div class="d-flex flex-column" style="max-width: 82%;">
                            <div class="d-flex align-items-center gap-2 mb-1 @(laNV ? "" : "justify-content-end")">
                                <span class="fw-bold nho @(laNV ? "text-primary" : "text-dark")">@tin.NguoiGui</span>
                                <span class="text-muted" style="font-size: .75rem;">@DinhDang.NgayGio(tin.NgayGui)</span>
                            </div>

                            <div class="p-3 rounded-3 @(laNV ? "bg-primary bg-opacity-10 text-dark border border-primary-subtle" : "bg-light text-dark border")" style="white-space: pre-wrap; word-break: break-word; line-height: 1.5;">@tin.NoiDung</div>
                        </div>
                    </div>
                }
            </div>

            @* Khung gửi thêm tin nhắn phản hồi *@
            @if (!daDong)
            {
                <div class="pt-3 border-top">
                    <form asp-action="GuiTinNhan" asp-route-id="@Model.MaLienHe" method="post">
                        @Html.AntiForgeryToken()
                        <label class="form-label fw-semibold mb-2">
                            <i class="bi bi-reply-fill text-cam me-1"></i> Gửi thêm câu hỏi hoặc phản hồi tiếp:
                        </label>
                        <div class="mb-3">
                            <textarea name="noiDung" rows="3" class="form-control" placeholder="Nhập nội dung bạn muốn phản hồi hoặc bổ sung thông tin..." required></textarea>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="nho text-muted">Nhân viên hỗ trợ sẽ được thông báo ngay khi bạn gửi tin.</span>
                            <button type="submit" class="btn btn-cam rounded-pill px-4">
                                <i class="bi bi-send me-1"></i> Gửi phản hồi
                            </button>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <div class="p-3 bg-light rounded-3 text-center border">
                    <i class="bi bi-lock-fill text-muted me-1"></i>
                    <span class="text-muted nho">Yêu cầu này đã được đóng. Bạn không thể gửi thêm tin nhắn. Nếu cần hỗ trợ thêm, hãy <a asp-action="TaoMoi" class="fw-semibold">tạo yêu cầu mới</a>.</span>
                </div>
            }
        </div>

        <a asp-action="Index" class="btn btn-light rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    @* ---------- Cột phải: Thông tin đơn hàng & bưu cục liên quan ---------- *@
    <div class="col-12 col-lg-4">
        @* Thông tin đơn hàng nếu có *@
        @if (Model.DonHang != null)
        {
            var don = Model.DonHang;
            <div class="the-mem p-4 shadow-sm border rounded-3 bg-white mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-box-seam text-cam me-1"></i> Đơn hàng liên quan
                    </h6>
                    <a asp-controller="KhachHangDonHang" asp-action="ChiTiet" asp-route-id="@don.MaDon" class="nho text-decoration-none fw-semibold" target="_blank">
                        Xem chi tiết <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-dark fs-6">@don.MaHienThi</span>
                        <span class="tt @don.TrangThai.LopBadge()">@don.TrangThai.TenHienThi()</span>
                    </div>
                    <div class="nho text-muted">Tạo lúc: @DinhDang.NgayGio(don.NgayTao)</div>
                </div>

                <div class="nho d-flex flex-column gap-2 mb-3">
                    <div>
                        <span class="text-muted">Người nhận:</span>
                        <span class="fw-semibold text-dark">@don.TenNguoiNhan</span> (@DinhDang.SoDienThoai(don.SoDienThoaiNguoiNhan))
                    </div>
                    <div>
                        <span class="text-muted">Địa chỉ nhận:</span>
                        <span class="fw-semibold text-dark">@don.DiaChiNhan</span>
                    </div>
                    <div>
                        <span class="text-muted">Cước vận chuyển:</span>
                        <span class="fw-bold text-danger">@DinhDang.Tien(don.PhiVanChuyen)</span>
                    </div>
                    @if (don.TienThuHo > 0)
                    {
                        <div>
                            <span class="text-muted">Tiền thu hộ COD:</span>
                            <span class="fw-bold text-success">@DinhDang.Tien(don.TienThuHo)</span>
                        </div>
                    }
                </div>

                <a asp-controller="KhachHangDonHang" asp-action="ChiTiet" asp-route-id="@don.MaDon" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                    <i class="bi bi-truck me-1"></i> Theo dõi hành trình đơn
                </a>
            </div>
        }

        @* Thông tin bưu cục nếu có *@
        @if (Model.BuuCuc != null)
        {
            var bc = Model.BuuCuc;
            <div class="the-mem p-4 shadow-sm border rounded-3 bg-white mb-4">
                <h6 class="fw-bold mb-3 pb-2 border-bottom text-dark">
                    <i class="bi bi-building text-info me-1"></i> Bưu cục phụ trách
                </h6>
                <div class="fw-bold text-dark mb-1">@bc.TenBuuCuc</div>
                <div class="nho text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@bc.DiaChi, @bc.TinhThanh</div>
                @if (!string.IsNullOrEmpty(bc.SoDienThoai))
                {
                    <div class="nho"><i class="bi bi-telephone me-1"></i>Hotline bưu cục: <a href="tel:@bc.SoDienThoai" class="fw-bold">@bc.SoDienThoai</a></div>
                }
            </div>
        }

        @* Hộp hotline trực tiếp *@
        <div class="the-mem p-4 shadow-sm border rounded-3 bg-white">
            <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-headset text-cam me-1"></i> Tổng đài chăm sóc khách hàng</h6>
            <p class="mo nho mb-3">Nếu cần hỗ trợ gấp hoặc phản ánh sự cố khẩn cấp, vui lòng gọi điện thoại trực tiếp.</p>
            <div class="p-3 bg-light rounded-3 text-center">
                <div class="nho text-muted mb-1">Tổng đài miễn phí 24/7</div>
                <a href="tel:19001515" class="h5 fw-bold text-cam text-decoration-none d-block mb-0">1900 1515</a>
            </div>
        </div>
    </div>
</div>
