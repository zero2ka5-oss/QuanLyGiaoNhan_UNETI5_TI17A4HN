@model PhanCongGiaoHang
@{
    var d = Model.DonGiaoHang!;
    ViewData["Title"] = d.MaHienThi;
    ViewData["QuayLai"] = Model.DangHieuLuc ? Url.Action("Index") : Url.Action("Index", "NhanVienLichSu");
}
@if (Model.DangHieuLuc)
{
    <partial name="_TheDon" model="Model" />
}
else
{
    <div class="the-don">
        <div class="d-flex justify-content-between"><span class="ma">@d.MaHienThi</span><span class="tt @Model.TrangThai.LopBadge()">@Model.TrangThai.TenHienThi()</span></div>
        @if (Model.KetQua.HasValue)
        {
            <div class="mt-2"><span class="tt @(Model.KetQua is KetQuaGiao.GiaoThanhCong or KetQuaGiao.DaBanGiaoBuuCuc ? "tt-thanhcong" : Model.KetQua is KetQuaGiao.GiaoKhongThanhCong or KetQuaGiao.SuCo ? "tt-thatbai" : "tt-huy")">@Model.KetQua.Value.TenHienThi()</span>
                @if (Model.LyDoThatBai.HasValue) { <span class="nho text-danger ms-1">@Model.LyDoThatBai.Value.TenHienThi()</span> }</div>
        }
    </div>
}
@{
    var chiTietTn = DonHangXuLy.TinhChiTietThuNhap(d, Model.LoaiChang, Model.KetQua, Model.NgayKetThuc);
}
<div class="the-don">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-bold"><i class="bi bi-cash-coin text-cam"></i> Thù lao chặng này</span>
        <span class="fs-5 fw-bold text-cam">@DinhDang.Tien(Model.ThuNhapShipper > 0 ? Model.ThuNhapShipper : chiTietTn.TongCong)</span>
    </div>
    <div class="bg-light p-2 rounded-3 nho">
        <div class="d-flex justify-content-between py-1 border-bottom">
            <span>Thù lao cơ bản / cự ly:</span>
            <span class="fw-semibold">@DinhDang.Tien(chiTietTn.ThuLaoCoBan)</span>
        </div>
        @if (chiTietTn.PhuCapKhoiLuong > 0)
        {
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span>Phụ cấp hàng nặng (@DinhDang.KhoiLuong(d.KhoiLuong)):</span>
                <span class="text-success fw-semibold">+@DinhDang.Tien(chiTietTn.PhuCapKhoiLuong)</span>
            </div>
        }
        @if (chiTietTn.PhuCapLoaiHang > 0)
        {
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span>Phụ cấp loại hàng (@d.LoaiHang?.TenLoaiHang):</span>
                <span class="text-success fw-semibold">+@DinhDang.Tien(chiTietTn.PhuCapLoaiHang)</span>
            </div>
        }
        @if (chiTietTn.ThuongDungHan > 0)
        {
            <div class="d-flex justify-content-between py-1">
                <span>Thưởng đúng hẹn:</span>
                <span class="text-success fw-semibold">+@DinhDang.Tien(chiTietTn.ThuongDungHan)</span>
            </div>
        }
    </div>
</div>
<div class="the-don">
    <div class="fw-bold mb-2">Thông tin đơn</div>
    <div class="nho mb-1"><span class="mo">Người gửi:</span> @d.KhachHang?.HoTen – <a href="tel:@d.KhachHang?.SoDienThoai">@DinhDang.SoDienThoai(d.KhachHang?.SoDienThoai)</a></div>
    <div class="nho mb-1"><span class="mo">@Model.LoaiChang.TenChang():</span> @d.BuuCucGui?.TenBuuCuc → @d.BuuCucNhan?.TenBuuCuc</div>
    <div class="nho mb-1"><span class="mo">Phương tiện:</span> @Model.PhuongTien?.MaHienThi · @Model.PhuongTien?.BienSo</div>
    <div class="nho mb-1"><span class="mo">Người nhận:</span> @d.TenNguoiNhan – @DinhDang.SoDienThoai(d.SoDienThoaiNguoiNhan)</div>
    <div class="nho mb-1"><span class="mo">Giao đến:</span> @d.DiaChiNhan</div>
    <div class="nho mb-1"><span class="mo">Hàng:</span> @d.LoaiHang?.TenLoaiHang · @DinhDang.KhoiLuong(d.KhoiLuong)</div>
    <hr>
    <div class="row nho g-2">
        <div class="col-6"><span class="mo">Phân công:</span><br>@DinhDang.NgayGio(Model.NgayPhanCong)</div>
        <div class="col-6"><span class="mo">Nhận hàng:</span><br>@DinhDang.NgayGio(Model.NgayNhanHang)</div>
        <div class="col-6"><span class="mo">Xuất phát:</span><br>@DinhDang.NgayGio(Model.NgayBatDauGiao)</div>
        <div class="col-6"><span class="mo">Kết thúc:</span><br>@DinhDang.NgayGio(Model.NgayKetThuc)</div>
    </div>
</div>
@if (!string.IsNullOrEmpty(d.AnhGiaoHang))
{
    <div class="the-don">
        <div class="fw-bold mb-2"><i class="bi bi-camera text-cam"></i> Ảnh giao hàng</div>
        <a href="@d.AnhGiaoHang" target="_blank"><img src="@d.AnhGiaoHang" alt="Ảnh giao hàng @d.MaHienThi" class="anh-giao-hang" loading="lazy" /></a>
    </div>
}
<div class="the-don">
    <div class="fw-bold mb-2">Lịch sử giao nhận</div>
    <partial name="_LichSuGiaoNhan" model="d.LichSus.OrderByDescending(l => l.ThoiGian).ThenByDescending(l => l.MaLichSu)" />
</div>
