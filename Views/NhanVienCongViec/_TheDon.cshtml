@* Họ và tên: Nguyễn Minh Hướng – MSSV: 23103100268
   Nội dung thực hiện: Module 4 - Thẻ công việc trên ứng dụng nhân viên: thông tin giao, nút gọi / chỉ đường,
                       nút nghiệp vụ theo đúng bước (nhận hàng → bắt đầu giao → thành công / không thành công). *@
@model PhanCongGiaoHang
@{ var d = Model.DonGiaoHang!; bool treHan = d.NgayGiaoDuKien.Date < DateTime.Today; }
<div class="the-don">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <a asp-action="ChiTiet" asp-route-id="@Model.MaPhanCong" class="text-reset">
            <div class="ma">@d.MaHienThi <i class="bi bi-chevron-right nho mo"></i></div>
            <div class="nho mo">@d.KhuVuc?.TenKhuVuc · @d.LoaiHang?.TenLoaiHang</div>
        </a>
        <span class="tt @Model.TrangThai.LopBadge()">@Model.TrangThai.TenHienThi()</span>
    </div>
    <div class="fw-semibold"><i class="bi bi-person text-cam"></i> @d.TenNguoiNhan</div>
    <div class="nho mb-2"><i class="bi bi-geo-alt text-cam"></i> @d.DiaChiNhan</div>
    <div class="d-flex justify-content-between nho bg-light rounded-3 p-2 mb-2">
        <span><i class="bi bi-box"></i> @DinhDang.KhoiLuong(d.KhoiLuong)</span>
        <span class="@(treHan ? "text-danger fw-semibold" : "")"><i class="bi bi-calendar-event"></i> @DinhDang.Ngay(d.NgayGiaoDuKien)</span>
        <span><i class="bi bi-truck-front"></i> @Model.PhuongTien?.BienSo</span>
    </div>
    @if (d.TongThuNguoiNhan > 0)
    {
        <div class="thu-tien mb-2">
            <div><div class="nho">Thu người nhận</div><div class="so">@DinhDang.Tien(d.TongThuNguoiNhan)</div></div>
            <div class="nho text-end lh-sm">@(d.TienThuHo > 0 ? "Thu hộ " + DinhDang.Tien(d.TienThuHo) : "")@(d.NguoiTraPhi == NguoiTraPhi.NguoiNhan ? (d.TienThuHo > 0 ? " + " : "") + "phí ship " + DinhDang.Tien(d.PhiVanChuyen) : "")</div>
        </div>
    }
    else
    {
        <div class="nho mb-2 text-success fw-semibold"><i class="bi bi-check2-circle"></i> Không thu tiền người nhận</div>
    }
    @if (!string.IsNullOrEmpty(d.GhiChu)) { <div class="nho mb-2"><i class="bi bi-chat-left-text text-cam"></i> @d.GhiChu</div> }
    @if (!string.IsNullOrEmpty(Model.GhiChu)) { <div class="nho mb-2 text-primary"><i class="bi bi-megaphone"></i> Điều phối: @Model.GhiChu</div> }
    <div class="row g-2">
        <div class="col-6"><a href="tel:@d.SoDienThoaiNguoiNhan" class="btn btn-goi w-100"><i class="bi bi-telephone-fill"></i> Gọi</a></div>
        <div class="col-6"><a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(d.DiaChiNhan)" target="_blank" rel="noopener" class="btn btn-outline-secondary w-100"><i class="bi bi-sign-turn-right"></i> Chỉ đường</a></div>
        @switch (Model.TrangThai)
        {
            case TrangThaiPhanCong.DaPhanCong:
                <div class="col-12">
                    <form asp-action="NhanHang" asp-route-id="@Model.MaPhanCong" method="post" data-xac-nhan="Xác nhận đã nhận hàng đơn @d.MaHienThi?">
                        <button class="btn btn-cam w-100"><i class="bi bi-box-seam"></i> Xác nhận đã nhận hàng</button>
                    </form>
                </div>
                break;
            case TrangThaiPhanCong.DaNhanHang:
                <div class="col-12">
                    <form asp-action="BatDauGiao" asp-route-id="@Model.MaPhanCong" method="post">
                        <button class="btn btn-primary w-100"><i class="bi bi-truck"></i> Bắt đầu giao</button>
                    </form>
                </div>
                break;
            case TrangThaiPhanCong.DangGiao:
                <div class="col-6">
                    <button type="button" class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#hopGiao@(Model.MaPhanCong)"><i class="bi bi-check2-circle"></i> Thành công</button>
                </div>
                <div class="col-6"><a asp-action="GiaoKhongThanhCong" asp-route-id="@Model.MaPhanCong" class="btn btn-outline-danger w-100"><i class="bi bi-x-octagon"></i> Thất bại</a></div>
                break;
        }
    </div>
</div>
@if (Model.TrangThai == TrangThaiPhanCong.DangGiao)
{
    @* Hộp xác nhận giao thành công: chụp ảnh giao hàng (không bắt buộc) + số tiền phải thu *@
    <div class="modal fade hop-day" id="hopGiao@(Model.MaPhanCong)" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="hop-day-dau"><span class="fw-bold">Giao thành công · @d.MaHienThi</span><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form asp-action="GiaoThanhCong" asp-route-id="@Model.MaPhanCong" method="post" enctype="multipart/form-data">
                    @if (d.TongThuNguoiNhan > 0)
                    {
                        <div class="text-center mb-3">
                            <div class="nho mo">Thu của người nhận</div>
                            <div class="fw-bold" style="font-size:1.9rem;color:#C2410C">@DinhDang.Tien(d.TongThuNguoiNhan)</div>
                        </div>
                    }
                    <label class="o-tai-anh o-tai-anh-rong mb-3">
                        <img alt="" />
                        <span class="goi-y"><i class="bi bi-camera"></i>Chụp ảnh giao hàng</span>
                        <input type="file" name="anhGiaoHang" accept="image/*" capture="environment" class="d-none" />
                    </label>
                    <input name="ghiChu" class="form-control mb-3" placeholder="Ghi chú (người nhận, vị trí để hàng…)" maxlength="300" />
                    <button class="btn btn-success w-100 py-2 fw-semibold"><i class="bi bi-check2-circle"></i> @(d.TongThuNguoiNhan > 0 ? "Đã giao và thu đủ tiền" : "Xác nhận đã giao")</button>
                </form>
            </div>
        </div>
    </div>
}
