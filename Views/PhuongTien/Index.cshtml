@model IEnumerable<PhuongTien>
@{ ViewData["Title"] = "Phương tiện"; }<h1>Phương tiện</h1><p><a asp-action="Create" class="btn btn-primary">Thêm</a></p><table class="table"><tr><th>Biển số</th><th>Loại</th><th>Tải trọng</th><th>Trạng thái</th><th></th></tr>@foreach (var x in Model) {<tr><td>@x.BienSo</td><td>@x.LoaiPhuongTien</td><td>@x.TaiTrongToiDa</td><td>@x.TrangThai</td><td><a asp-action="Details" asp-route-id="@x.MaPhuongTien">Chi tiết</a> | <a asp-action="Edit" asp-route-id="@x.MaPhuongTien">Sửa</a> | <a asp-action="Delete" asp-route-id="@x.MaPhuongTien">Xóa</a></td></tr>}</table>
